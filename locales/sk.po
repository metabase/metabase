#: metabase/appearance/settings.clj
msgid "Keyword setting to control whitelabeling of the help link. Valid values are `:metabase`, `:hidden`, and `:custom`. If `:custom` is set, the help link will use the URL specified in the `help-link-custom-destination`, or be hidden if it is not set."
msgstr "Nastavenie kľúčového slova na ovládanie whitelabelingu odkazu na pomoc. Platné hodnoty sú `:metabase`, `:hidden` a `:custom`. Ak je nastavené `:custom`, odkaz na pomoc použije URL z `help-link-custom-destination`, alebo bude skrytý, ak nie je nastavené."

#: metabase/appearance/settings.clj
msgid "Invalid help link option"
msgstr "Neplatná voľba odkazu na pomoc"

#: metabase/appearance/settings.clj
msgid "Please make sure this is a valid URL"
msgstr "Skontrolujte, prosím, že je to platná URL"

#: metabase/appearance/settings.clj
msgid "Custom URL for the help link."
msgstr "Vlastná URL pre odkaz na pomoc."

#: metabase/appearance/settings.clj
msgid "Whether or not to display Metabase links outside admin settings."
msgstr "Či sa majú zobrazovať odkazy Metabase mimo admin nastavení."

#: metabase/appearance/settings.clj
msgid "Invalid number separators."
msgstr "Neplatné oddeľovače čísel."

