msgid "Returns true if the beginning of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Mengembalikan true jika awal dari `$string1` cocok dengan `$string2` (atau `$string3`, dll. jika ditentukan)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the end of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Mengembalikan true jika akhir dari `$string1` cocok dengan `$string2` (atau `$string3`, dll. jika ditentukan)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is empty"
msgstr "Memeriksa apakah sebuah kolom kosong"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
