{
  "name": "metabase-ui-host-app",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer of the packed @metabase/ui tarball: proves the package builds, type-checks and renders",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "build:vite": "vite build",
    "build:rspack": "rspack build -c rspack.config.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "dayjs": "^1.11.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@rspack/cli": "^1.1.0",
    "@rspack/core": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
