msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "A fila de solicitações do servidor vLLM está cheia — reduza a carga concorrente ou reinicie-o com um --max-num-seqs maior"

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} atingiu o teto de {1} tokens do teste de conexão sem produzir uma chamada de ferramenta forçada. O Metabot precisa de suporte a saída estruturada para títulos de conversas e geração de SQL."

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "Erro de API do vLLM (HTTP {0})"

