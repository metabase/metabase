{
  description = "Metabase release jar";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "x86_64-darwin"
        "aarch64-darwin"
      ];

      forAllSystems = nixpkgs.lib.genAttrs systems;
    in
    {
      formatter = forAllSystems (system: nixpkgs.legacyPackages.${system}.nixfmt);

      packages = forAllSystems (
        system:
        let
          pkgs = import nixpkgs { inherit system; };
          lib = pkgs.lib;

          # Fixed-output paths otherwise ignore changed inputs when the hash is unchanged.
          # Include the toolchain and platform as well as the dependency manifests.
          dependencyCacheVersion =
            source:
            builtins.substring 0 16 (
              builtins.hashString "sha256" (
                builtins.unsafeDiscardStringContext "${source}:${nixpkgs.outPath}:${system}"
              )
            );

          frontendDepsSource = lib.fileset.toSource {
            root = ./.;
            fileset = lib.fileset.unions [
              ./bun.lock
              ./bunfig.toml
              ./package.json
              ./patches
            ];
          };

          clojureDepsSource = lib.fileset.toSource {
            root = ./.;
            fileset = lib.fileset.unions [
              ./deps.edn
              (lib.fileset.fileFilter (file: file.name == "deps.edn") ./modules/drivers)
            ];
          };

          # A full SHA can resolve from the cached checkout without consulting mutable tags.
          pinBuildDependency = ''
            substituteInPlace deps.edn \
              --replace-fail \
              '{:git/tag "v2.25.1" :git/sha "1cfab45"}' \
              '{:git/sha "1cfab45a6eab83d4f8a416bf8f8aca7552d09a32"}'
          '';

          mavenSettings = pkgs.writeText "settings.xml" ''
            <settings>
              <offline>true</offline>
              <mirrors>
                <mirror>
                  <id>nix-offline</id>
                  <url>file://''${user.home}/.m2/repository</url>
                  <mirrorOf>*</mirrorOf>
                </mirror>
              </mirrors>
            </settings>
          '';

          normalizeProxyClasses = pkgs.writeText "NormalizeProxyClasses.java" ''
            import java.nio.file.Files;
            import java.nio.file.Path;
            import java.util.ArrayList;
            import java.util.Comparator;
            import java.util.Iterator;
            import java.util.List;
            import org.objectweb.asm.ClassReader;
            import org.objectweb.asm.ClassWriter;
            import org.objectweb.asm.tree.ClassNode;
            import org.objectweb.asm.tree.MethodNode;

            public final class NormalizeProxyClasses {
              private static final String IPROXY = "clojure/lang/IProxy";

              private static boolean normalize(Path path) throws Exception {
                byte[] original = Files.readAllBytes(path);
                int majorVersion = (Byte.toUnsignedInt(original[6]) << 8)
                    | Byte.toUnsignedInt(original[7]);
                // Newer dependency classes (including multi-release entries) aren't
                // generated by this build's JDK. Preserve them without parsing with ASM.
                if (majorVersion > Runtime.version().feature() + 44) {
                  return false;
                }
                ClassNode node = new ClassNode();
                new ClassReader(original).accept(node, 0);
                if (!node.interfaces.contains(IPROXY)) {
                  return false;
                }

                List<MethodNode> constructors = new ArrayList<>();
                for (MethodNode method : node.methods) {
                  if (method.name.equals("<init>")) {
                    constructors.add(method);
                  }
                }
                constructors.sort(Comparator.comparing(method -> method.desc));

                Iterator<MethodNode> sorted = constructors.iterator();
                for (int index = 0; index < node.methods.size(); index++) {
                  if (node.methods.get(index).name.equals("<init>")) {
                    node.methods.set(index, sorted.next());
                  }
                }

                ClassWriter writer = new ClassWriter(0);
                node.accept(writer);
                Files.write(path, writer.toByteArray());
                return true;
              }

              public static void main(String[] args) throws Exception {
                int normalized = 0;
                try (var paths = Files.walk(Path.of(args[0]))) {
                  for (Path path : paths.filter(Files::isRegularFile).toList()) {
                    if (path.toString().endsWith(".class") && normalize(path)) {
                      normalized++;
                    }
                  }
                }
                System.out.println("Normalized " + normalized + " Clojure proxy classes");
              }
            }
          '';

          defaultVersion =
            if self ? shortRev then
              "0.0.0-${self.shortRev}"
            else if self ? dirtyShortRev then
              "0.0.0-${self.dirtyShortRev}"
            else
              "UNKNOWN";

          gitRev =
            if self ? rev then
              self.rev
            else if self ? dirtyRev then
              self.dirtyRev
            else if self ? dirtyShortRev then
              self.dirtyShortRev
            else
              "unknown";

          mkMetabaseJar =
            {
              edition ? "oss",
              version ? defaultVersion,
            }:
            let
              frontendDeps = self.packages.${system}.frontendDeps;
              clojureDeps = self.packages.${system}.clojureDeps;
              pythonDeps = self.packages.${system}.pythonDeps;
            in
            pkgs.stdenv.mkDerivation {
              pname = "metabase-${edition}-jar";
              inherit version;

              src = lib.cleanSourceWith {
                src = ./.;
                filter =
                  path: type:
                  let
                    baseName = baseNameOf path;
                  in
                  !(lib.elem baseName [
                    ".git"
                    ".cache"
                    "node_modules"
                    "result"
                    "target"
                  ]);
              };

              postPatch = pinBuildDependency + ''
                substituteInPlace frontend/build/embedding-sdk/rspack/get-build-info-values.js \
                  --replace-fail \
                  'BUILD_TIME: new Date().toISOString(),' \
                  'BUILD_TIME: new Date(Number(process.env.SOURCE_DATE_EPOCH) * 1000).toISOString(),'
              '';

              nativeBuildInputs = with pkgs; [
                bash
                bun
                clojure
                coreutils
                curl
                findutils
                git
                gnugrep
                gnused
                jdk21
                nodejs_22
                python3
                uv
                which
              ];

              dontConfigure = true;

              buildPhase = ''
                runHook preBuild

                export HOME="$TMPDIR/home"
                export XDG_CACHE_HOME="$TMPDIR/cache"
                export XDG_CONFIG_HOME="$TMPDIR/config"
                export XDG_DATA_HOME="$TMPDIR/share"
                export BUN_INSTALL_CACHE_DIR="$TMPDIR/bun-cache"
                export ClojureToolsCache="$TMPDIR/clojure-cache"
                export GIT_CONFIG_GLOBAL="$TMPDIR/gitconfig"
                export UV_CACHE_DIR="$TMPDIR/uv-cache"
                export SSL_CERT_FILE="${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt"
                export GIT_SSL_CAINFO="$SSL_CERT_FILE"
                export CYPRESS_INSTALL_BINARY=0
                export HUSKY=0
                export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
                export PUPPETEER_SKIP_DOWNLOAD=1
                export JAVA_HOME="${pkgs.jdk21}"
                export JAVA_TOOL_OPTIONS="-Duser.home=$HOME -Dmaven.repo.local=$HOME/.m2/repository -XX:+UnlockExperimentalVMOptions -XX:hashCode=2"
                # Dirty-tree lastModified depends on filesystem mtimes, not source content.
                export SOURCE_DATE_EPOCH="${toString (if self ? rev then self.lastModified else 1)}"
                export TZ=UTC
                mkdir -p "$TMPDIR/bin"
                cat > "$TMPDIR/bin/git" <<'EOF'
                #!${pkgs.bash}/bin/bash
                case "$*" in
                  "rev-parse --abbrev-ref HEAD") printf '%s\n' 'unknown' ;;
                  "rev-parse HEAD") printf '%s\n' '${gitRev}' ;;
                  "show-ref --head --hash=7 head") printf '%s\n' '${builtins.substring 0 7 gitRev}' ;;
                  "symbolic-ref --short HEAD") printf '%s\n' 'unknown' ;;
                  "log -1 --pretty=%ad --date=short") ${pkgs.coreutils}/bin/date -u -d "@$SOURCE_DATE_EPOCH" +%F ;;
                  *) exec ${pkgs.git}/bin/git "$@" ;;
                esac
                EOF
                chmod +x "$TMPDIR/bin/git"

                export PATH="$TMPDIR/bin:$JAVA_HOME/bin:$PATH"

                mkdir -p "$HOME" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME"
                cp -a ${clojureDeps}/m2 "$HOME/.m2"
                cp -a ${clojureDeps}/gitlibs "$HOME/.gitlibs"
                chmod -R u+w "$HOME/.m2" "$HOME/.gitlibs"
                cp ${mavenSettings} "$HOME/.m2/settings.xml"
                ln -sfn "$HOME/.m2" /build/.m2
                ln -sfn "$HOME/.gitlibs" /build/.gitlibs

                cp -a ${pythonDeps}/. resources/python-sources/
                chmod -R u+w resources/python-sources

                cp -a ${frontendDeps}/node_modules ./node_modules
                chmod -R u+w ./node_modules
                patchShebangs ./node_modules
                patchShebangs ./bin

                git config --global --add safe.directory "$PWD"

                INTERACTIVE=false CI=true SKIP_PYTHON_DEPS=true MB_EDITION=${edition} MB_JAR_FILENAME=metabase.jar \
                  ./bin/build.sh '{:version "${version}"}'

                jar_path="$PWD/target/uberjar/metabase.jar"
                repack_dir="$(mktemp -d)"
                (
                  cd "$repack_dir"
                  JAVA_TOOL_OPTIONS= jar xf "$jar_path"
                )

                asm="$HOME/.m2/repository/org/ow2/asm/asm/9.7.1/asm-9.7.1.jar"
                asm_tree="$HOME/.m2/repository/org/ow2/asm/asm-tree/9.7.1/asm-tree-9.7.1.jar"
                normalizer_dir="$(mktemp -d)"
                cp ${normalizeProxyClasses} "$normalizer_dir/NormalizeProxyClasses.java"
                JAVA_TOOL_OPTIONS= javac -cp "$asm:$asm_tree" -d "$normalizer_dir" \
                  "$normalizer_dir/NormalizeProxyClasses.java"
                JAVA_TOOL_OPTIONS= java -cp "$asm:$asm_tree:$normalizer_dir" NormalizeProxyClasses "$repack_dir"

                export TZ=UTC
                find "$repack_dir" -exec touch -d '1980-01-01 00:01:00 UTC' {} +
                find "$repack_dir" -type f -name '*.class' \
                  -exec touch -d '1980-01-01 00:01:02 UTC' {} +
                {
                  printf '%s\n' './META-INF/MANIFEST.MF'
                  find "$repack_dir" -type f ! -path "$repack_dir/META-INF/MANIFEST.MF" \
                    -printf './%P\n' | LC_ALL=C sort
                } > "$TMPDIR/jar-entries"

                rm "$jar_path"
                (
                  cd "$repack_dir"
                  JAVA_TOOL_OPTIONS= jar --create --no-manifest --file="$jar_path" @"$TMPDIR/jar-entries"
                )

                runHook postBuild
              '';

              installPhase = ''
                runHook preInstall

                install -Dm644 target/uberjar/metabase.jar "$out/share/java/metabase.jar"

                runHook postInstall
              '';

              meta = {
                description = "Metabase ${lib.toUpper edition} release jar";
                homepage = "https://www.metabase.com/";
                license = lib.licenses.agpl3Only;
                platforms = systems;
              };
            };

          frontendDeps = pkgs.stdenv.mkDerivation {
            pname = "metabase-frontend-deps";
            version = dependencyCacheVersion frontendDepsSource;

            src = frontendDepsSource;

            nativeBuildInputs = with pkgs; [
              bun
              nodejs_22
            ];

            outputHashAlgo = "sha256";
            outputHashMode = "recursive";
            outputHash = "sha256-sUe42mwqSMhUbRcnTA+K0SejWRCfLa2AH8asIrWR/qA=";

            dontConfigure = true;
            dontFixup = true;
            dontPatchShebangs = true;

            buildPhase = ''
              runHook preBuild

              export HOME="$TMPDIR/home"
              export XDG_CACHE_HOME="$TMPDIR/cache"
              export BUN_INSTALL_CACHE_DIR="$TMPDIR/bun-cache"
              export CI=true
              export CYPRESS_INSTALL_BINARY=0
              export HUSKY=0
              export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
              export PUPPETEER_SKIP_DOWNLOAD=1

              mkdir -p "$HOME" "$XDG_CACHE_HOME"
              bun install --frozen-lockfile --ignore-scripts --no-progress
              node ./node_modules/patch-package/index.js
              find node_modules/.bun -path "*/node_modules/.bin" -type d -prune -exec rm -rf {} +

              runHook postBuild
            '';

            installPhase = ''
              runHook preInstall

              mkdir -p "$out"
              cp -a node_modules "$out/node_modules"

              runHook postInstall
            '';
          };

          clojureDeps = pkgs.stdenv.mkDerivation {
            pname = "metabase-clojure-deps";
            version = dependencyCacheVersion clojureDepsSource;

            src = clojureDepsSource;

            postPatch = pinBuildDependency;

            nativeBuildInputs = with pkgs; [
              cacert
              clojure
              git
              jdk21
            ];

            outputHashAlgo = "sha256";
            outputHashMode = "recursive";
            outputHash = "sha256-5BkjOB2Q+SfSKnK7bgJXo/m1E6r1x16ihkkEnwb9r28=";

            dontConfigure = true;
            dontFixup = true;
            dontPatchShebangs = true;

            buildPhase = ''
              runHook preBuild

              export HOME="$TMPDIR/home"
              export XDG_CACHE_HOME="$TMPDIR/cache"
              export GIT_CONFIG_GLOBAL="$TMPDIR/gitconfig"
              export SSL_CERT_FILE="${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt"
              export GIT_SSL_CAINFO="$SSL_CERT_FILE"
              export JAVA_HOME="${pkgs.jdk21}"
              export JAVA_TOOL_OPTIONS="-Duser.home=$HOME -Dmaven.repo.local=$HOME/.m2/repository"
              export PATH="$JAVA_HOME/bin:$PATH"

              mkdir -p "$HOME/.m2" "$HOME/.gitlibs" "$XDG_CACHE_HOME"
              git config --global --add safe.directory "$PWD"

              clojure -P -M:drivers:build:oss
              clojure -P -M:drivers:build:ee
              clojure -P -M:cljs
              clojure -Sdeps '{:deps {org.clojure/clojure {:mvn/version "1.3.0"}}}' -P
              clojure -Sdeps '{:deps {org.ow2.asm/asm-tree {:mvn/version "9.7.1"}}}' -P

              runHook postBuild
            '';

            installPhase = ''
              runHook preInstall

              colorize_pom="$HOME/.m2/repository/colorize/colorize/0.1.1/colorize-0.1.1.pom"
              substituteInPlace "$colorize_pom" \
                --replace-fail \
                '<version>[1.2.1],[1.3.0]</version>' \
                '<version>1.3.0</version>'
              rm -f "$colorize_pom.sha1"

              find "$HOME/.m2" \
                \( \
                  -name resolver-status.properties \
                  -o -name "*.lastUpdated" \
                  -o -name _remote.repositories \
                  -o -name "maven-metadata-*.xml*" \
                \) \
                -delete

              find "$HOME/.gitlibs/libs" -name .git -exec rm -rf {} +
              find "$HOME/.gitlibs/_repos" -name config -type f -print0 > "$TMPDIR/git-configs"
              while IFS= read -r -d "" config; do
                repo="''${config%/config}"
                find "$repo" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                printf '%s\n' \
                  '[core]' \
                  '  repositoryformatversion = 0' \
                  '  bare = true' \
                  > "$config"
              done < "$TMPDIR/git-configs"

              mkdir -p "$out"
              cp -a "$HOME/.m2" "$out/m2"
              cp -a "$HOME/.gitlibs" "$out/gitlibs"

              runHook postInstall
            '';
          };

          pythonDeps =
            let
              lock = builtins.fromTOML (builtins.readFile ./resources/python-sources/uv.lock);
              project = (builtins.fromTOML (builtins.readFile ./resources/python-sources/pyproject.toml)).project;
              sqlglot =
                lib.findSingle (package: package.name == "sqlglot") (throw "uv.lock must contain sqlglot")
                  (throw "uv.lock contains multiple sqlglot versions")
                  lock.package;
              wheel =
                lib.findSingle (wheel: lib.hasSuffix "-py3-none-any.whl" wheel.url)
                  (throw "sqlglot needs a universal Python wheel")
                  (throw "sqlglot has multiple universal Python wheels")
                  sqlglot.wheels;
            in
            assert lib.assertMsg (
              project.dependencies == [ "sqlglot==${sqlglot.version}" ] && builtins.length lock.package == 2
            ) "Python dependencies changed: update uv.lock and extend the Nix wheel installation if needed";
            pkgs.stdenv.mkDerivation {
              pname = "metabase-python-deps";
              version = sqlglot.version;

              src = pkgs.fetchurl {
                inherit (wheel) url;
                sha256 = lib.removePrefix "sha256:" wheel.hash;
              };

              nativeBuildInputs = [ pkgs.unzip ];

              dontUnpack = true;

              installPhase = ''
                runHook preInstall

                mkdir -p "$out"
                unzip -q "$src" -d "$out"

                runHook postInstall
              '';
            };

          mkMetabaseWrapped =
            jar:
            pkgs.stdenv.mkDerivation {
              pname = "metabase-wrapped";
              inherit (jar) version;

              nativeBuildInputs = [ pkgs.makeWrapper ];

              dontUnpack = true;

              installPhase = ''
                runHook preInstall

                makeWrapper ${lib.getExe pkgs.jdk21} $out/bin/metabase \
                  --add-flags "-jar ${jar}/share/java/metabase.jar"

                runHook postInstall
              '';

              meta = {
                description = "Runnable wrapper for the Metabase release jar";
                homepage = "https://www.metabase.com/";
                license = lib.licenses.agpl3Only;
                mainProgram = "metabase";
                platforms = systems;
              };
            };

          default = mkMetabaseJar { };
        in
        {
          inherit default;
          inherit clojureDeps frontendDeps pythonDeps;
          metabase = default;
          metabase-wrapped = mkMetabaseWrapped default;
          ee = mkMetabaseJar { edition = "ee"; };
        }
      );

      apps = forAllSystems (system: {
        default = {
          type = "app";
          program = "${self.packages.${system}.metabase-wrapped}/bin/metabase";
        };
      });
    };
}
