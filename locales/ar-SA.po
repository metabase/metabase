#: frontend/src/metabase/common/utils/fields.ts
#: frontend/src/metabase/documents/components/editor-extensions/CardEmbed/CardEmbedMenuDropdown.tsx
msgid "Comment"
msgstr "تعليق"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes leading and trailing whitespace from a string of text."
msgstr "يزيل المسافة البيضاء الرائدة والمتزايدة من سلسلة من النص."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text you want to trim."
msgstr "العمود أو النص الذي تريد تقليمه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes trailing whitespace from a string of text."
msgstr "يزيل مسافة بيضاء زائدة من سلسلة من النص."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes leading whitespace from a string of text."
msgstr "يزيل المسافة البيضاء الرائدة من سلسلة من النص."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the domain name (eg. `\"metabase\"`) from a URL or email"
msgstr "يستخرج اسم النطاق (مثل `\"metabase\"`) من عنوان URL أو بريد إلكتروني"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "urlOrEmail"
msgstr "urlOrEmail"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract domain names from."
msgstr "عمود URL أو Email اللي يتم استخراج أسماء النطاقات منه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the first subdomain (eg. `\"status\"` from `\"status.metabase.com\"`, `\"\"` from `\"bbc.co.uk\"`) from a URL. Ignores `\"www\"`."
msgstr "يستخرج أول نطاق فرعي (مثل `\"status\"` من `\"status.metabase.com\"`، و`\"\"` من `\"bbc.co.uk\"`) من عنوان URL. يتجاهل `\"www\"`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL column to extract the subdomain from."
msgstr "عمود URL اللي يتم استخراج النطاق الفرعي منه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "ProfileImage"
msgstr "ProfileImage"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the host (domain name and TLD, eg. `\"metabase.com\"` from `\"status.metabase.com\"`) from a URL or email"
msgstr "يستخرج المستضيف (اسم النطاق وTLD، مثل `\"metabase.com\"` من `\"status.metabase.com\"`) من عنوان URL أو بريد إلكتروني"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract the host from."
msgstr "عمود URL أو Email اللي يتم استخراج الـ host منه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` contains `$string2` within it (or `$string3`, etc. if specified)."
msgstr "يُرجع `true` إذا كانت `$string1` تحتوي بداخلها على `$string2` (أو `$string3`، إلخ إذا تم تحديدها)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string1"
msgstr "سلسلة1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to check."
msgstr "العمود أو النص للتحقق."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string2"
msgstr "سلسلة2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string of text to look for."
msgstr "سلسلة النص للبحث عنها."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Small"
msgstr "صغير"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more values to look for."
msgstr "تقدر تضيف قيم أكثر للبحث عنها."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. Set to `\"case-insensitive\"` to perform a case-insensitive match."
msgstr "اختياري. اضبطه على `\"case-insensitive\"` لإجراء مطابقة بدون حساسية لحالة الأحرف."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` does not contain `$string2` within it (and `$string3`, etc. if specified)."
msgstr "يُرجع `true` إذا كانت `$string1` لا تحتوي بداخلها على `$string2` (و`$string3`، إلخ إذا تم تحديدها)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the beginning of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "يُرجع true إذا كانت بداية `$string1` تطابق `$string2` (أو `$string3`، إلخ إذا تم تحديدها)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the end of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "يُرجع true إذا كانت نهاية `$string1` تطابق `$string2` (أو `$string3`، إلخ إذا تم تحديدها)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is empty"
msgstr "يتحقق إذا كان العمود فارغًا"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column to check."
msgstr "العمود للتحقق."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not empty"
msgstr "يتحقق إذا كان العمود غير فارغ"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized short name (eg. `\"Apr\"`) for the given month number (eg. `4`)"
msgstr "يُرجع الاسم القصير المُترجم (مثل `\"Apr\"`) لرقم الشهر المحدد (مثل `4`)"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "monthNumber"
msgstr "monthNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a month in the year, `1` to `12`."
msgstr "عمود أو تعبير يعطي رقم شهر في السنة، من `1` إلى `12`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Birthday Month"
msgstr "شهر الميلاد"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns a string like `\"Q1\"`, given the quarter number"
msgstr "يُرجع سلسلة مثل `\"Q1\"` عند إعطاء رقم الربع"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "quarterNumber"
msgstr "quarterNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a quarter of the year, `1` to `4`."
msgstr "عمود أو تعبير يعطي رقم ربع السنة، من `1` إلى `4`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Fiscal Quarter"
msgstr "الربع المالي"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized name of a day of the week, given the day's number."
msgstr "ترجع الاسم المترجم ليوم من أيام الأسبوع، بناءً على رقم اليوم."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "dayNumber"
msgstr "dayNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a day of the week, `1` to `7`. Which day is `1` is defined in your localization setting; default Sunday."
msgstr "عمود أو تعبير يعطي رقم يوم الأسبوع، من `1` إلى `7`. أي يوم هو `1` يتم تحديده في إعدادات الترجمة المحلية لديك؛ الافتراضي هو Sunday."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weekday"
msgstr "يوم الأسبوع"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a time interval of specified length"
msgstr "يحصل على فاصل زمني للطول المحدد"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/xrays/automagic_dashboards/names.clj
msgid "number"
msgstr "رقم"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of interval, where negative values are back in time."
msgstr "فترة الفاصل الزمني ، حيث تعود القيم السلبية في الوقت المناسب."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "unit"
msgstr "الوحدة"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "نوع الفاصل الزمني مثل {0}، {1}، {2}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date column's values to see if they're within the relative range."
msgstr "يتحقق من قيم عمود التاريخ لمعرفة ما إذا كانت ضمن النطاق النسبي."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to return interval of."
msgstr "عمود التاريخ لإرجاع الفاصل الزمني."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Created At"
msgstr "تاريخ الإنشاء"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if a column's value falls within an interval, starting from an initial, offsetting interval."
msgstr "يعيد true إذا كانت قيمة عمود تقع ضمن فاصل زمني، بدءًا من فاصل زمني أولي مع إزاحة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to check."
msgstr "عمود التاريخ المراد التحقق منه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of the interval, where negative numbers go back in time."
msgstr "مدة الفاصل الزمني، حيث تعود الأرقام السالبة إلى الوراء في الوقت."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetValue"
msgstr "offsetValue"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The initial interval period to start from, where negative values are back in time."
msgstr "مدة الفاصل الزمني الأولية التي سيتم البدء منها، حيث تعود القيم السالبة إلى الوراء في الوقت."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetUnit"
msgstr "offsetUnit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a timestamp relative to the current time"
msgstr "يحصل على طابع زمني بالنسبة للوقت الحالي"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer with the number of the year."
msgstr "يأخذ تاريخًا ووقتًا ويعيد عددًا صحيحًا بعدد السنة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The datetime column."
msgstr "عمود التاريخ والوقت."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`4`) with the number of the quarter in the year."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`1`-`4`) برقم الربع في السنة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`12`) with the number of the month in the year."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`1`-`12`) برقم الشهر في السنة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the week of the year as an integer."
msgstr "يستخرج أسبوع السنة كرقم صحيح."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The name of the column with your date or datetime value."
msgstr "اسم العمود الذي يحتوي على تاريخك أو قيمة التاريخ والوقت."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. The default is `\"ISO\"`.\n"
"- ISO: Week 1 starts on the Monday before the first Thursday of January.\n"
"- US: Week 1 starts on Jan 1. All other weeks start on Sunday.\n"
"- Instance: Week 1 starts on Jan 1. All other weeks start on the day defined in your Metabase localization settings."
msgstr "اختياري. الافتراضي هو `\"ISO\"`.\n"
"- ISO: يبدأ الأسبوع 1 يوم الاثنين قبل أول خميس من يناير.\n"
"- US: يبدأ الأسبوع 1 في 1 يناير. وتبدأ كل الأسابيع الأخرى يوم الأحد.\n"
"- Instance: يبدأ الأسبوع 1 في 1 يناير. وتبدأ كل الأسابيع الأخرى في اليوم المحدد في إعدادات الترجمة المحلية لـ Metabase."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`31`) with the number of the day of the month."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`1`-`31`) برقم يوم الشهر."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`7`) with the number of the day of the week. Which day is `1` is defined in your localization settings."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`1`-`7`) برقم يوم الأسبوع. أي يوم هو `1` يتم تحديده في إعدادات الترجمة المحلية لديك."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`23`) with the number of the hour. No AM/PM."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`0`-`23`) برقم الساعة. بدون AM/PM."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the minute in the hour."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`0`-`59`) برقم الدقيقة في الساعة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the seconds in the minute."
msgstr "يأخذ datetime ويُرجع عددًا صحيحًا (`0`-`59`) برقم الثواني في الدقيقة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Get the difference between two datetime values (`$datetime2` minus `$datetime1`) using the specified unit of time."
msgstr "احصل على الفرق بين قيمتي تاريخ/وقت (`$datetime2` ناقص `$datetime1`) باستخدام وحدة الوقت المحددة."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime1"
msgstr "datetime1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or expression with your datetime value."
msgstr "العمود أو التعبير مع قيمة التاريخ والوقت الخاصة بك."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime2"
msgstr "datetime2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Shipped At"
msgstr "شُحن عند"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, or ${ 7 }."
msgstr "اختر من: {0}، {1}، {2}، {3}، {4}، {5}، {6}، أو ${ 7 }."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Adds some units of time to a date or timestamp value."
msgstr "يضيف بعض الوحدات الزمنية إلى قيمة التاريخ أو الطابع الزمني."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column with your date or timestamp values."
msgstr "العمود الذي يحتوي على قيم التاريخ أو الطابع الزمني الخاصة بك."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "amount"
msgstr "الكمية"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be added."
msgstr "عدد الوحدات التي سيتم إضافتها."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, or {8}."
msgstr "اختر من: {0}، {1}، {2}، {3}، {4}، {5}، {6}، {7}، أو {8}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Subtracts some units of time to a date or timestamp value."
msgstr "يطرح بعض الوحدات الزمنية من قيمة التاريخ أو الطابع الزمني."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be subtracted."
msgstr "عدد الوحدات التي سيتم طرحها."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the current timestamp (in milliseconds)."
msgstr "يعيد الطابع الزمني الحالي (بالملي ثانية)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Returns the current timestamp (in milliseconds). Currently {0} in {1}."
msgstr "يعيد الطابع الزمني الحالي (بالملي ثانية). حاليًا {0} في {1}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
