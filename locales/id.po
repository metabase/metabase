msgstr "Kolom dengan nilai tanggal atau cap waktu Anda."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "amount"
msgstr "jumlah"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be added."
msgstr "Jumlah unit yang akan ditambahkan."

