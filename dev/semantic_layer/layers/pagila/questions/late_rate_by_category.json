{
  "name": "Late return rate by category",
  "description": "Share of late returns per film category.",
  "type": "question",
  "display": "bar",
  "collection_id": "{{c:pagila}}",
  "visualization_settings": {
    "column_settings": {
      "[\"name\",\"share\"]": {
        "number_style": "percent",
        "decimals": 1
      }
    },
    "graph.dimensions": [
      "film_category"
    ],
    "graph.metrics": [
      "share"
    ]
  },
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": "{{db}}",
    "stages": [
      {
        "lib/type": "mbql.stage/mbql",
        "source-table": "{{t:rentals}}",
        "aggregation": [
          [
            "share",
            {
              "lib/uuid": "c904cee1-34c3-4629-866b-dda7bbe033ab"
            },
            [
              "=",
              {},
              [
                "field",
                {},
                "{{f:rentals.is_late}}"
              ],
              true
            ]
          ]
        ],
        "breakout": [
          [
            "field",
            {},
            "{{f:rentals.film_category}}"
          ]
        ],
        "order-by": [
          [
            "desc",
            {},
            [
              "aggregation",
              {},
              "c904cee1-34c3-4629-866b-dda7bbe033ab"
            ]
          ]
        ]
      }
    ]
  }
}
