msgstr "Kunne ikke nå vLLM-serveren på {0}. Sjekk at den kjører og at base-URL-en er riktig."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "The vLLM-serveren på {0} svarte ikke innen {1}ms. Sjekk at den kjører og ikke er overbelastet."

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "Sjekk at {0} er en vLLM-servers OpenAI-kompatible API — base-URL-en skal ende på /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} serveres med et kontekstvindu på {1} token, som er for lite for Metabot — den trenger minst {2}. Start på nytt vLLM med en større --max-model-len."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} strømmet resonnementet sitt som chattekst. Start på nytt vLLM med --reasoning-parser slik at thinking ikke vises inne i Metabot-svarene."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} nådde taket på {1} tokens for tilkoblingstesten midt i et verktøykall. En modell som genererer så mye før den kaller et verktøy er for treg til å drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "The vLLM-serveren returnerte et verktøykall der argumentene ikke er gyldig JSON. --tool-call-parser samsvarer sannsynligvis ikke med {0} sitt output-format."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} brukte hele {1}-tokens budsjettet for tilkoblingstesten på resonnement uten å kalle et verktøy. En modell som tenker så lenge over en triviell prompt er for treg til å drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} nådde taket på {1} tokens for tilkoblingstesten før den fullførte et verktøykall. En modell som genererer så mye før den kaller et verktøy er for treg til å drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "The vLLM-serveren svarte med tekst i stedet for å kalle et verktøy. Start på nytt med --enable-auto-tool-choice og en --tool-call-parser som matcher {0} sitt output-format."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} nådde taket på {1} tokens for tilkoblingstesten uten å produsere et tvunget verktøykall. Metabot trenger støtte for strukturert output for samtaletitler og SQL-generering."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "The vLLM-serveren respekterte ikke et tvunget verktøykall. Metabot trenger støtte for strukturert output for samtaletitler og SQL-generering."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "The vLLM-serveren er tilgjengelig, men serverer ingen modeller."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "The vLLM-serveren serverer ikke {0}. Den serverer: {1}."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "The vLLM-serveren besvarte ikke tilkoblingstesten innen {0}ms. Sjekk at den ikke er overbelastet — en server som er så treg til å svare på en triviell prompt kan ikke drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "The vLLM-serveren sluttet å svare etter {0}ms. Øk vLLM-forespørsel-timeouten, eller server en raskere modell."

#: metabase/metabot/self/vllm.clj
