;; T cases from the metabase-wiki translated-query corpus. Each engine gets one
;; query over the isolated S-case documents named by :source.
[{:id "T01"
  :focus "OR across ordinary tokens"
  :source "S01"
  :target :in-place
  :queries {:in-place "amber cobalt"
            :appdb-h2 "amber"
            :appdb-postgres "amber or cobalt"
            :semantic "amber or cobalt"}
  :expect {:in-place [:A :B :C :D]
           :appdb-h2 [:A :C :D]
           :appdb-postgres [:A :B :C :D]
           :semantic [:A :B :C :D]}}
 {:id "T02"
  :focus "arbitrary infix substring"
  :source "S02"
  :target :in-place
  :queries {:in-place "hat"
            :appdb-h2 "hat"
            :appdb-postgres "hat"
            :semantic "hat"}
  :expect {:in-place [:A :B :C]
           :appdb-h2 [:A :B :C]
           :appdb-postgres [:B :C]
           :semantic [:B :C]}}
 {:id "T03"
  :focus "`and` is literal text, not an intersection"
  :source "S08"
  :target :in-place
  :queries {:in-place "amber and cobalt"
            :appdb-h2 "amber"
            :appdb-postgres "amber or \"and\" or cobalt"
            :semantic "amber or \"and\" or cobalt"}
  :expect {:in-place [:A :B :C :D :E]
           :appdb-h2 [:A :B :C]
           :appdb-postgres [:A :B :C :D :E]
           :semantic [:A :B :C :D :E]}}
 {:id "T04"
  :focus "conjunction of substrings"
  :source "S01"
  :target :appdb-h2
  :queries {:in-place "amber"
            :appdb-h2 "amber cobalt"
            :appdb-postgres "amber cobalt"
            :semantic "amber cobalt"}
  :expect {:in-place [:A :C :D]
           :appdb-h2 [:C :D]
           :appdb-postgres [:C :D]
           :semantic [:C :D]}}
 {:id "T05"
  :focus "`or` must literally occur"
  :source "S05"
  :target :appdb-h2
  :queries {:in-place "or"
            :appdb-h2 "amber or cobalt"
            :appdb-postgres "amber \"or\" cobalt"
            :semantic "amber \"or\" cobalt"}
  :expect {:in-place [:D :E]
           :appdb-h2 [:D]
           :appdb-postgres [:D]
           :semantic [:D]}}
