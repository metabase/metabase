                        },
                        "field_ref": {
                          "items": {},
                          "type": "array"
                        },
                        "operator": {
                          "const": "between"
                        },
                        "values": {
                          "prefixItems": [
                            {
                              "oneOf": [
                                {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "boolean"
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            {
                              "oneOf": [
                                {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "boolean"
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          ],
                          "type": "array"
                        }
                      },
                      "required": [
