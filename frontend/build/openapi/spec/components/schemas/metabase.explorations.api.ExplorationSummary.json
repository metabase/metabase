{
  "description": "Lightweight row for the `GET /mine` list. No threads/queries — just the metadata\n  needed to render a list entry, plus `current_user_last_touched_at`, the timestamp the list is\n  sorted by (the caller's own most-recent touch of this exploration, composed across the\n  exploration's revisions and its creation).",
  "properties": {
    "archived": {
      "type": "boolean"
    },
    "collection": {
      "oneOf": [
        {
          "properties": {
            "id": {
              "description": "value must be an integer greater than zero.",
              "minimum": 1,
              "type": "integer"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "creator": {
      "oneOf": [
        {
          "properties": {
            "email": {
              "minLength": 1,
              "type": "string"
            },
            "first_name": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "description": "value must be an integer greater than zero.",
              "minimum": 1,
              "type": "integer"
            },
            "last_name": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator_id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "current_user_last_touched_at": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "creator_id",
    "created_at",
    "updated_at",
    "current_user_last_touched_at"
  ],
  "type": "object"
}
