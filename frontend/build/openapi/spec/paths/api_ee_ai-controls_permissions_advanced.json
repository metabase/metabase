                },
                "permissions": {
                  "items": {
                    "properties": {
                      "group_id": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "perm_type": {
                        "enum": [
                          "permission/metabot",
                          "permission/metabot-nlq",
                          "permission/metabot-other-tools",
                          "permission/metabot-sql-generation"
                        ],
                        "type": "string"
                      },
                      "perm_value": {
                        "enum": [
                          "yes",
                          "no"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
