{
  "description": "Patch shape for `update_metric`. Every field is optional; only the fields the caller\n  passes are changed. `:query` accepts a base64-encoded MBQL string (or query_handle UUID\n  resolved upstream in the MCP layer) and must still describe a valid metric.",
  "properties": {
    "archived": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display": {
      "oneOf": [
        {
          "$ref": "./metabase.agent-api.api.card-display.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "visualization_settings": {
      "oneOf": [
        {
          "description": "Value must be a map.",
          "properties": {},
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object"
}
