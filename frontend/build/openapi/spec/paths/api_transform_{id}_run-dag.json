{
  "post": {
    "description": "Trigger a DAG-reprocess run starting from a single transform: runs the transform and every\n  transform in its transitive dependency closure. Returns a 202 with the created `dag_run_id`, or a\n  nil `dag_run_id` when nothing was run (a DAG run for this transform is already in progress, or the\n  closure is empty).\n\n  `direction` selects which transforms are included:\n  - `upstream`   — the seed transform plus all transforms it depends on\n  - `downstream` — the seed transform plus all transforms that depend on it",
    "operationId": "post-api-transform-id-run-dag",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "direction": {
                "enum": [
                  "upstream",
                  "downstream"
                ],
                "type": "string"
              }
            },
            "required": [
              "direction"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "body": {
                  "additionalProperties": false,
                  "properties": {
                    "dag_run_id": {
                      "oneOf": [
                        {
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "message": {}
                  },
                  "required": [
                    "message",
                    "dag_run_id"
                  ],
                  "type": "object"
                },
                "status": {
                  "const": 202
                }
              },
              "required": [
                "status",
                "body"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/transform/{id}/run-dag",
    "tags": [
      "/api/transform"
    ]
  }
}
