;; Java sources for the backend. Pulled into the root project as a `:local/root` dep; the compiled classes,
;; not the sources, are what land on the classpath. tools.deps refuses to start until they exist:
;;
;;    clojure -X:deps prep              ; compile once
;;    clojure -X:deps prep :force true  ; recompile after editing a .java file
{:paths ["target/classes"]
 ;; only for javac's classpath; keep in step with the root deps.edn
 :deps  {org.clojure/clojure {:mvn/version "1.12.3"}}

 :deps/prep-lib {:alias  :build
                 :fn     compile
                 :ensure "target/classes"}

 :aliases
 {:build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
          :ns-default build}}}
