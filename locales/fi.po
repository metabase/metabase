#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Verkkoyhteyden aikakatkaisu (sekunteina) etä-git-toiminnoille, kuten fetch, push, clone ja ls-remote. Jumittunut yhteys muuten jumittaisi synkronoinnin määräämättömäksi ajaksi."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Synkronoidaanko muunnokset remote-syncin kautta. Kun tämä on käytössä, kaikki muunnokset, muunnostunnisteet ja muunnosajot synkronoidaan yhtenä kokonaisuutena (kaikki tai ei mitään)."

#: metabase_enterprise/remote_sync/settings.clj
