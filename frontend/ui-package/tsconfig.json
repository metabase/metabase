{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "metabase/ui": ["../src/metabase/ui/index.ts"],
      "metabase/ui/*": ["../src/metabase/ui/*"]
    }
  },
  "include": [
    "src/**/*",
    "../src/metabase/ui/mantine.d.ts",
    "../src/types/dayjs.d.ts",
    "../src/types/react.d.ts",
    "../src/types/underscore.d.ts"
  ],
  "exclude": [
    "../src/metabase/ui/**/*.spec.*",
    "../src/metabase/ui/**/*.stories.*",
    "../src/metabase/ui/stories/**",
    "../src/metabase/ui/syntax/**"
  ]
}
