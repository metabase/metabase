{
  "description": "Schema for a query row in API responses. The result blob and `dataset_query` aren't\n   asserted here; `interestingness_score`, `contextual_interestingness_score`, and `row_count`\n   are batched-hydrated onto each query in `/:id` — the scores from `exploration_query_result`,\n   `row_count` from the linked `stored_result` — and may be nil for pending/errored queries or —\n   for the contextual score — when the LLM is unconfigured or the thread had no prompt.",
  "properties": {
    "card_id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "contextual_interestingness_score": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension_name": {
      "type": "string"
    },
    "display": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "exploration_thread_id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "finished_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "interestingness_score": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "position": {
      "description": "value must be an integer greater or equal to than zero.",
      "minimum": 0,
      "type": "integer"
    },
    "query_type": {
      "type": "string"
    },
    "row_count": {
      "oneOf": [
        {
          "description": "value must be an integer greater or equal to than zero.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "exploration_thread_id",
    "card_id",
    "dimension_id",
    "query_type",
    "position",
    "status"
  ],
  "type": "object"
}
