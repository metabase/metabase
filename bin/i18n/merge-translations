#!/usr/bin/env bash

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
cd "$I18N_ROOT"

other_branch="${1:?Usage: merge-translations <branch> [-o]}"
prioritize_other=false
case "${2:-}" in
  -o) prioritize_other=true ;;
  "") ;;
  *) echo "Usage: $0 <branch> [-o]" >&2; exit 1 ;;
esac
git rev-parse --verify "$other_branch^{commit}" > /dev/null

checkout=$(./bin/i18n/prepare-translation-update)
trap 'if [ "$?" = 0 ]; then rm -rf "$(dirname "$checkout")"; else echo "Update retained at $checkout" >&2; fi' EXIT
export METABASE_I18N_SOURCE_DIR="$checkout/locales"

if other_commit=$(git show "$other_branch:locales/metabase-i18n.commit" 2>/dev/null); then
  other_directory=$(./bin/i18n/fetch-translations "$other_commit")
else
  other_directory="$(dirname "$checkout")/legacy"
  mkdir "$other_directory"
  git archive "$other_branch:locales" -- '*.po' | tar -x -C "$other_directory"
fi

for other_po in "$other_directory/"*.po; do
  name=$(basename "$other_po")
  [ "$name" != en-ZZ.po ] || continue
  po="$METABASE_I18N_SOURCE_DIR/$name"
  if [ ! -f "$po" ]; then
    cp "$other_po" "$po"
    chmod u+w "$po"
  elif [ "$prioritize_other" = true ]; then
    msgcat --no-wrap --use-first "$other_po" "$po" > "$po.tmp"
    mv "$po.tmp" "$po"
  else
    msgcat --no-wrap --use-first "$po" "$other_po" > "$po.tmp"
    mv "$po.tmp" "$po"
  fi
done

clojure -X:build i18n.pseudo-locale/generate-pseudo-locale-po!
./bin/i18n/build-translation-resources
./bin/i18n/publish-translations "$checkout"
