msgstr "Metrika s id {0} patrí do tabuľky mimo databázy tohto poskytovateľa metadát."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Metrika s id {0} nemá entity_id, takže ju nemožno exportovať ako prenosnú reprezentáciu."

