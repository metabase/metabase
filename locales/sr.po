#: metabase_enterprise/sso/settings.clj
msgid "Invalid identity provider certificate. Certificate should be a base-64 encoded string."
msgstr "Nevažeći sertifikat identity provider-a. Sertifikat treba da bude base-64 kodiran string."

#: metabase_enterprise/sso/settings.clj
