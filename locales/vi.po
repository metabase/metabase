msgid "The current user has no personal collection. Pass an explicit `collection_id` (or `null` for the root collection) instead."
msgstr "Người dùng hiện tại không có Bộ sưu tập cá nhân. Thay vào đó, hãy truyền `collection_id` tường minh (hoặc `null` cho Bộ sưu tập gốc)."

#: metabase/metabot/tools/save_entity.clj
msgid "A `document_id` is required when saving to a document."
msgstr "Cần có `document_id` khi lưu vào một Tài liệu."

#: metabase/metabot/tools/save_entity.clj
msgid "A `dashboard_id` is required when saving to a dashboard."
msgstr "Cần có `dashboard_id` khi lưu vào một Bảng điều khiển."

#: metabase/metabot/tools/save_entity.clj
msgid "No generated chart found with id `{0}`. Create a chart with `construct_notebook_query` first, then save it using the id it returns."
msgstr "Không tìm thấy biểu đồ đã tạo với id `{0}`. Hãy tạo biểu đồ bằng `construct_notebook_query` trước, rồi lưu nó bằng id mà lệnh đó trả về."

#: metabase/metabot/tools/sql/common.clj
msgid "Unsupported query format"
msgstr "Định dạng truy vấn không được hỗ trợ"

