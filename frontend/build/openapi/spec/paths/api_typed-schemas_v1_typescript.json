{
  "get": {
    "description": "Generate a TypeScript semantic schema module.",
    "operationId": "get-api-typed-schemas-v1-typescript",
    "parameters": [
      {
        "description": "Scopes the schema to a database by numeric id or name.",
        "in": "query",
        "name": "database",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "description": "Comma-separated library collection ids or entity ids. Limits tables and metrics to those library collections.",
        "in": "query",
        "name": "library-collections",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "description": "Comma-separated collection ids or entity ids. Includes saved questions from those collections.",
        "in": "query",
        "name": "question-collections",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "description": "Whether to include the entire data library.",
        "in": "query",
        "name": "include-data-library",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "description": "Whether to include the entire metric library.",
        "in": "query",
        "name": "include-metric-library",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "description": "Whether to include all readable models with executable actions. Database scope applies when provided.",
        "in": "query",
        "name": "include-models",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
