{
  "post": {
    "description": "Run a transform job manually. Returns a 202 with the created `job_run_id`, or a nil `job_run_id`\n  when nothing was run (the job is already running, or has no transforms). By default, fresh\n  pulled-in dependencies are skipped; pass `run_all` to force-refresh the whole plan.",
    "operationId": "post-api-transform-job-job-id-run",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "job-id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "run_all": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "body": {
                  "additionalProperties": false,
                  "properties": {
                    "job_run_id": {
                      "oneOf": [
                        {
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "message": {}
                  },
                  "required": [
                    "message",
                    "job_run_id"
                  ],
                  "type": "object"
                },
                "status": {
                  "const": 202
                }
              },
              "required": [
                "status",
                "body"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/transform-job/{job-id}/run",
    "tags": [
      "/api/transform-job"
    ]
  }
}
