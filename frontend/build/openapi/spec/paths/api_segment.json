{
  "get": {
    "description": "Fetch *all* `Segments`.",
    "operationId": "get-api-segment",
    "parameters": [],
    "responses": {
      "2XX": {
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/segment",
    "tags": [
      "/api/segment"
    ]
  },
  "post": {
    "description": "Create a new `Segment`. The Segment's table is derived from its `definition`.",
    "operationId": "post-api-segment",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "definition": {
                "$ref": "../components/schemas/metabase.segments.schema.definition.json"
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "definition"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/segment",
    "tags": [
      "/api/segment"
    ]
  }
}
