msgstr "Трябва да е валиден cron низ, без да задава година"

#: metabase/model_persistence/api.clj
msgid "Value must be a string representing a cron schedule of format <seconds> <minutes> <hours> <day of month> <month> <day of week> <year>"
msgstr "Стойността трябва да е низ, представляващ cron график във формат <seconds> <minutes> <hours> <day of month> <month> <day of week> <year>"

#: metabase/model_persistence/api.clj
msgid "Cannot refresh an archived model"
msgstr "Не може да се опресни архивиран модел"

#: metabase/model_persistence/api.clj
