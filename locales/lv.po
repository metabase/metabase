msgstr "E-pasta saņēmēju saraksts Drošības centra paziņojumiem."

#: metabase_enterprise/security_center/settings.clj
msgid "At least one email recipient is required."
msgstr "Nepieciešams vismaz viens e-pasta saņēmējs."

#: metabase_enterprise/security_center/settings.clj
msgid "Slack channel for Security Center notifications. Null means Slack notifications are disabled."
msgstr "Slack kanāls Drošības centra paziņojumiem. Null nozīmē, ka Slack paziņojumi ir atspējoti."

