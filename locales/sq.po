#: metabase/appearance/settings.clj
msgid "Keyword setting to control whitelabeling of the help link. Valid values are `:metabase`, `:hidden`, and `:custom`. If `:custom` is set, the help link will use the URL specified in the `help-link-custom-destination`, or be hidden if it is not set."
msgstr "Cilësim me keyword për të kontrolluar whitelabeling të link-ut të ndihmës. Vlerat e vlefshme janë `:metabase`, `:hidden`, dhe `:custom`. Nëse vendoset `:custom`, link-u i ndihmës do të përdorë URL-në e specifikuar te `help-link-custom-destination`, ose do të fshihet nëse nuk është vendosur."

#: metabase/appearance/settings.clj
msgid "Options for displaying the illustration when there are no results after searching."
msgstr "Opsione për shfaqjen e ilustrimit kur nuk ka rezultate pas kërkimit."

#: metabase/appearance/settings.clj
