msgstr "Không có gì để invalid."

#: metabase/cache/api.clj
msgid "Granular Caching"
msgstr "Cache chi tiết"

#: metabase/cache/api.clj
msgid "At least one of `database`, `dashboard`, or `question` is required."
msgstr "Cần ít nhất một trong `database`, `dashboard`, hoặc `question`."

