{
  "name": "Revenue",
  "description": "Total amount paid, by month paid.",
  "type": "metric",
  "display": "line",
  "collection_id": "{{c:metrics}}",
  "visualization_settings": {},
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": "{{db}}",
    "stages": [
      {
        "lib/type": "mbql.stage/mbql",
        "source-table": "{{t:payments}}",
        "aggregation": [
          [
            "sum",
            {},
            [
              "field",
              {},
              "{{f:payments.amount}}"
            ]
          ]
        ],
        "breakout": [
          [
            "field",
            {
              "temporal-unit": "month"
            },
            "{{f:payments.payment_date}}"
          ]
        ]
      }
    ]
  }
}
