 {:id "S15"
  :focus "percent is literal in substring search but token punctuation in PostgreSQL"
  :config "simple"
  :query "foo%bar"
  :docs {:A {:name "fooxbar"}
         :B {:name "foobar"}
         :C {:name "foo%bar"}
         :D {:name "foo bar"}
         :E {:name "barfoo"}
         :F {:name "foo-bar"}
         :G {:name "foopizza"}}
  :expect {:in-place [:C]
           :appdb-h2 [:C]
           :appdb-postgres [:C :D :F]
           :keyword [:C :D :F]
           :vector []
           :semantic [:C :D :F]}}
 {:id "S16"
  :focus "underscore is literal in substring search but token punctuation in PostgreSQL"
