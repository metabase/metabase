msgstr "Không tìm thấy truy vấn {0}"

#: metabase/metabot/tools/sql/edit.clj
msgid "Each edit must include old_string and new_string"
msgstr "Mỗi chỉnh sửa phải bao gồm old_string và new_string"

#: metabase/metabot/tools/sql/edit.clj
msgid "Text to replace not found: {0}"
msgstr "Không tìm thấy văn bản để thay thế: {0}"

