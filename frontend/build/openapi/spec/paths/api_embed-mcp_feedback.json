{
  "post": {
    "description": "Persist MCP Apps visualization feedback.",
    "operationId": "post-api-embed-mcp-feedback",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "conversation_data": {
                "properties": {
                  "prompt": {
                    "oneOf": [
                      {
                        "maxLength": 10000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "query": {
                    "oneOf": [
                      {
                        "maxLength": 10000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source": {
                    "const": "mcp"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              },
              "feedback": {
                "properties": {
                  "freeform_feedback": {
                    "oneOf": [
                      {
                        "maxLength": 10000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "issue_type": {
                    "oneOf": [
                      {
                        "maxLength": 64,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "positive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "positive"
                ],
                "type": "object"
              }
            },
            "required": [
              "feedback",
              "conversation_data"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "body": {
                  "type": "null"
                },
                "status": {
                  "const": 204
                }
              },
              "required": [
                "status",
                "body"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/embed-mcp/feedback",
    "tags": [
      "/api/embed-mcp"
    ]
  }
}
