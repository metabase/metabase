msgid "Cross-Origin Resource Sharing (CORS)"
msgstr "Cross-Origin Resource Sharing (CORS)"

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/EmbeddingAppSameSiteCookieDescription.tsx
msgid "Determines whether or not cookies are allowed to be sent on cross-site requests. You'll likely need to change this to None if your embedding application is hosted under a different domain than Metabase. Otherwise, leave it set to Lax, as it's more secure."
msgstr "Determină dacă cookie-urile sunt sau nu permise să fie trimise în cereri cross-site. Probabil va trebui să schimbi această setare la None dacă aplicația ta de încorporare este găzduită pe un domeniu diferit față de Metabase. Altfel, las-o setată pe Lax, deoarece este mai sigur."

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/EmbeddingAppSameSiteCookieDescription.tsx
#, javascript-format
msgctxt "{0} is a 'Learn more' link to the embedding documentation"
msgid "If you set this to None, you'll have to use HTTPS, or browsers will reject the request. {0}"
msgstr "Dacă setezi asta la None, va trebui să folosești HTTPS, altfel browserele vor respinge cererea. {0}"

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/EmbeddingAppSameSiteCookieDescription.tsx
#, javascript-format
msgid "You should probably change this setting to {0}."
msgstr "Probabil ar trebui să schimbi această setare la {0}."

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "Lax (default)"
msgstr "Lax (implicit)"

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "Allows Metabase session cookies to be shared on the same domain. Used for production instances on the same domain."
msgstr "Permite partajarea cookie-urilor de sesiune Metabase pe același domeniu. Folosit pentru instanțe de producție pe același domeniu."

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "Strict (not recommended)"
msgstr "Strict (nerecomandat)"

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "Does not allow Metabase session cookies to be shared with embedded instances. Use this if you do not want to enable session sharing with embedding."
msgstr "Nu permite partajarea cookie-urilor de sesiune Metabase cu instanțe încorporate. Folosește asta dacă nu vrei să activezi partajarea sesiunii cu încorporarea."

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "None (requires HTTPS)"
msgstr "Niciunul (necesită HTTPS)"

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "Use \"None\" when your app and Metabase are hosted on different domains. Incompatible with Safari and iOS-based browsers."
msgstr "Folosește \"None\" când aplicația ta și Metabase sunt găzduite pe domenii diferite. Incompatibil cu Safari și browserele bazate pe iOS."

#: frontend/src/metabase/embedding/settings/EmbeddingSecuritySettings/SameSiteSelectWidget.tsx
msgid "SameSite cookie setting"
msgstr "Setare cookie SameSite"

