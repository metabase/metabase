msgid "Saved question / model {0} belongs to database {1}, but this query targets database {2}. Cross-database queries are not supported."
msgstr "Pyetja / modeli i ruajtur {0} i përket bazës së të dhënave {1}, por kjo pyetje synon bazën e të dhënave {2}. Pyetjet ndër-baza të dhënash nuk mbështeten."

