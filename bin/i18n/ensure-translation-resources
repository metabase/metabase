#!/usr/bin/env bash

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
cd "$I18N_ROOT"

if [ -n "${METABASE_I18N_SOURCE_DIR:-}" ]; then
  exec ./bin/i18n/build-translation-resources
fi

source_directory=$(./bin/i18n/fetch-translations)
stamp="$I18N_ROOT/target/i18n-resources.key"
key=$(bash ./bin/i18n/translation-resource-key "$(basename "$source_directory")")

if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$key" ]; then
  complete=true
  for po in "$source_directory/"*.po; do
    locale=$(basename "$po" .po)
    [[ "$locale" != metabase* ]] || continue
    if [ ! -f "resources/i18n/$locale.edn" ] || [ ! -f "resources/frontend_client/app/locales/${locale//-/_}.json" ]; then
      complete=false
      break
    fi
  done
  if [ "$complete" = true ]; then
    exit 0
  fi
fi

./bin/i18n/build-translation-resources
