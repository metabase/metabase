{
  "description": "Returned by `update_question` - the fields the LLM is most likely to want to read back\n  after an update. Excludes the full dataset_query, which the caller can re-fetch via\n  `read_resource` if needed.",
  "properties": {
    "archived": {
      "type": "boolean"
    },
    "collection_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_path": {
      "type": "string"
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display": {
      "type": "string"
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "display",
    "collection_id",
    "collection_path",
    "description",
    "archived"
  ],
  "type": "object"
}
