#: metabase/models/humanization.clj
msgid "To make table and field names more human-friendly, Metabase will replace dashes and underscores in them with spaces. We’ll capitalize each word while at it, so ‘last_visited_at’ will become ‘Last Visited At’."
msgstr "Da bi imena tabela i polja bila razumljivija ljudima, Metabase će zameniti crtice i donje crte u njima razmacima. Usput ćemo kapitalizovati svaku reč, tako da će ‘last_visited_at’ postati ‘Last Visited At’."

#: metabase/models/serialization/resolve/mp.clj
msgid "No table found matching portable FK {0}. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and schemas, then retry with an exact portable FK from the response."
msgstr "Nije pronađena tabela koja odgovara prenosivom FK {0}. Pozovi `read_resource` sa `metabase://database/<numeric id>/tables` da izlistaš dostupne tabele i šeme, pa zatim pokušaj ponovo sa tačnim prenosivim FK iz odgovora."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable table FK references database {0}, but metadata provider is for {1}."
msgstr "Portabilni FK tabele referencira bazu podataka {0}, ali provajder metapodataka je za {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous portable table FK {0}: {1} candidates. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and retry with a more specific portable FK."
msgstr "Dvosmislen prenosivi FK tabele {0}: {1} kandidata. Pozovi `read_resource` sa `metabase://database/<numeric id>/tables` da izlistaš dostupne tabele i pokušaj ponovo sa specifičnijim prenosivim FK."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable field FK {0} must have at least 4 elements."
msgstr "Prenosivi FK polja {0} mora imati najmanje 4 elementa."

#: metabase/models/serialization/resolve/mp.clj
msgid "No column {0} on table {1}.{2}.{3}. Call `read_resource` with `metabase://table/<numeric id>/fields` to list this table''s columns."
msgstr "Nema kolone {0} u tabeli {1}.{2}.{3}. Pozovi `read_resource` sa `metabase://table/<numeric id>/fields` da izlistaš kolone ove tabele."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous column {0} on table {1}.{2}.{3}."
msgstr "Dvosmislena kolona {0} u tabeli {1}.{2}.{3}."

#: metabase/models/serialization/resolve/mp.clj
msgid "{0} is not implemented for the metadata-provider-backed resolver in Phase 1."
msgstr "{0} nije implementirano za resolver zasnovan na provajderu metapodataka u fazi 1."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable database reference {0} does not match metadata provider database {1}."
msgstr "Portabilna referenca baze podataka {0} se ne podudara sa bazom podataka provajdera metapodataka {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Cannot export database id {0}: metadata provider is for database id {1}."
msgstr "Nije moguće izvesti bazu podataka id {0}: provajder metapodataka je za bazu podataka id {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "No saved question, model, or metric found with id {0}."
msgstr "Nije pronađeno sačuvano pitanje, model ili metrika sa id {0}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question / model / metric id {0} belongs to database {1}, but this resolver targets database {2}."
msgstr "Sačuvano pitanje / model / metrika id {0} pripada bazi podataka {1}, ali ovaj resolver cilja bazu podataka {2}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question, model, or metric id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Sačuvano pitanje, model ili metrika id {0} nema entity_id, pa ne može da se izveze kao portabilna reprezentacija."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question / model {0} belongs to database {1}, but this query targets database {2}. Cross-database queries are not supported."
msgstr "Sačuvano pitanje / model {0} pripada bazi podataka {1}, ali ovaj upit cilja bazu podataka {2}. Cross-database upiti nisu podržani."

#: metabase/models/serialization/resolve/mp.clj
msgid "No measure found with entity_id {0}. Do not invent or guess entity_ids: read the table that owns the measure with `read_resource` (`metabase://table/<numeric id>`) and copy the exact `portable_entity_id` from its `<measure>` tag."
msgstr "Nije pronađena mera sa entity_id {0}. Nemoj izmišljati niti pogađati entity_ids: pročitaj tabelu koja poseduje meru pomoću `read_resource` (`metabase://table/<numeric id>`) i kopiraj tačan `portable_entity_id` iz njenog taga `<measure>`."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure {0} belongs to a table in a different database than this query (target database id {1}). Cross-database queries are not supported."
msgstr "Mera {0} pripada tabeli u drugoj bazi podataka od ovog upita (ciljni id baze podataka {1}). Cross-database upiti nisu podržani."

#: metabase/models/serialization/resolve/mp.clj
msgid "No measure found with id {0}."
msgstr "Nije pronađena mera sa id {0}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure id {0} belongs to a table outside this metadata provider''s database."
msgstr "Mera id {0} pripada tabeli van baze podataka ovog provajdera metapodataka."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Mera id {0} nema entity_id, pa ne može da se izveze kao portabilna reprezentacija."

#: metabase/models/serialization/resolve/mp.clj
msgid "No segment found with id {0}."
msgstr "Nije pronađen segment sa id {0}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Segment id {0} belongs to a table outside this metadata provider''s database."
msgstr "Segment id {0} pripada tabeli van baze podataka ovog provajdera metapodataka."

#: metabase/models/serialization/resolve/mp.clj
msgid "Segment id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Segment id {0} nema entity_id, pa ne može da se izveze kao prenosiva reprezentacija."

#: metabase/models/serialization/resolve/mp.clj
msgid "No segment found with entity_id {0}. Do not invent or guess entity_ids: read the table that owns the segment with `read_resource` (`metabase://table/<numeric id>`) and copy the exact `portable_entity_id` from its `<segment>` tag."
msgstr "Nije pronađen segment sa entity_id {0}. Nemoj izmišljati niti pogađati entity_ids: pročitaj tabelu koja poseduje segment pomoću `read_resource` (`metabase://table/<numeric id>`) i kopiraj tačan `portable_entity_id` iz njenog taga `<segment>`."

#: metabase/models/serialization/resolve/mp.clj
msgid "Segment {0} belongs to a table in a different database than this query (target database id {1}). Cross-database queries are not supported."
msgstr "Segment {0} pripada tabeli u drugoj bazi podataka od ove upita (id ciljne baze podataka {1}). Upiti preko više baza podataka nisu podržani."

#: metabase/models/serialization/resolve/mp.clj
msgid "No table with id {0} in metadata provider."
msgstr "Nema tabele sa id {0} u metadata provider-u."

#: metabase/models/serialization/resolve/mp.clj
msgid "No field with id {0} in metadata provider."
msgstr "Nema polja sa id {0} u metadata provider-u."

#: metabase/mq/settings.clj
msgid "Maximum number of times a failed queue message will be retried before being dropped."
msgstr "Maksimalan broj pokušaja ponavljanja za neuspelu poruku reda pre nego što bude odbačena."

#: metabase/mq/settings.clj
msgid "Which queue backend to use. Valid values: `quartz`, `memory`. When unset, defaults to `quartz`, or to `memory` when the task scheduler is disabled (`MB_DISABLE_SCHEDULER`)."
msgstr "Koji queue backend koristiti. Važeće vrednosti: `quartz`, `memory`. Ako nije podešeno, podrazumevano je `quartz`, ili `memory` kada je planera zadataka onemogućen (`MB_DISABLE_SCHEDULER`)."

#: metabase/mq/settings.clj
msgid "How long (in milliseconds) a Quartz queue message with no listener anywhere in the cluster is kept before the reaper drops it. With node-affinity, such a message is never acquired and just waits in the store; this bounds that wait so a message for a queue no node handles (e.g. a new queue whose node was rolled back) does not linger forever. Generous by default (1 day) so a node can restart or be re-upgraded and still deliver it."
msgstr "Koliko dugo (u milisekundama) Quartz poruka reda bez slušaoca bilo gde u klasteru ostaje sačuvana pre nego što je reaper odbaci. Uz node-affinity, takva poruka se nikada ne preuzima i samo čeka u skladištu; ovo ograničava to čekanje tako da poruka za red koji nijedan čvor ne obrađuje (npr. novi red čiji je čvor vraćen unazad) ne ostane zauvek. Podrazumevano je velikodušno (1 dan) da bi čvor mogao ponovo da se pokrene ili ponovo da se nadogradi i ipak je isporuči."

