{
  "get": {
    "description": "Serve the cached JS bundle for a single enabled data app by slug. Honors\n   `If-None-Match` against the content-hash ETag with a 304.",
    "operationId": "get-api-apps-slug-bundle",
    "parameters": [
      {
        "in": "path",
        "name": "slug",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {}
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/apps/{slug}/bundle",
    "tags": [
      "/api/apps"
    ]
  }
}
