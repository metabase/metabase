#: metabase/metabot/self/vllm.clj
msgid "vLLM rejected the request — usually an unsupported schema, or a model that cannot compile the tool grammar"
msgstr "vLLM afviste anmodningen — typisk et ikke-understøttet schema, eller en model der ikke kan kompilere tool-grammatikken"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API key expired or invalid — check the key your server was started with via --api-key"
msgstr "vLLM API-nøglen er udløbet eller ugyldig — tjek nøglen som din server blev startet med via --api-key"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API endpoint was not found — the base URL should end in /v1"
msgstr "vLLM API-endepunkt blev ikke fundet — base-URL'en skal ende på /v1"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "vLLM-serverens anmodningskø er fuld — reducér samtidig belastning, eller genstart den med en større --max-num-seqs"

#: metabase/metabot/self/vllm.clj
msgid "vLLM returned an internal server error"
msgstr "vLLM returnerede en intern serverfejl"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "vLLM API-fejl (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "Could not reach the vLLM server at {0}. Check that it is running and that the base URL is correct."
msgstr "Kunne ikke nå vLLM-serveren på {0}. Tjek at den kører, og at base-URL'en er korrekt."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "vLLM-serveren på {0} svarede ikke inden for {1}ms. Tjek, at den kører og ikke er overbelastet."

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "Tjek at {0} er en vLLM-servers OpenAI-kompatible API — base-URL'en skal ende på /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} betjenes med et kontekstvindue på {1} tokens, hvilket er for lille til Metabot — den har brug for mindst {2}. Genstart vLLM med en større --max-model-len."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} streamede sin ræsonnering som chattekst. Genstart vLLM med --reasoning-parser, så \"thinking\" ikke vises inde i Metabots svar."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} nåede loftet på {1} tokens for forbindelsestesten midt i et tool-kald. En model, der genererer så meget før den kalder et tool, er for langsom til at drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "vLLM-serveren returnerede et tool-kald, hvis argumenter ikke er gyldig JSON. --tool-call-parser matcher sandsynligvis ikke {0}''s outputformat."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} brugte hele forbindelsestestens budget på {1} tokens på at ræsonnere uden at kalde et tool. En model der tænker så længe over en triviel prompt er for langsom til at drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} nåede loftet på {1} tokens for forbindelsestesten før den fuldførte et tool-kald. En model, der genererer så meget før den kalder et tool, er for langsom til at drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "vLLM-serveren svarede med tekst i stedet for at kalde et tool. Genstart den med --enable-auto-tool-choice og en --tool-call-parser, der matcher {0}''s outputformat."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} nåede loftet på {1} tokens for forbindelsestesten uden at producere et tvunget tool-kald. Metabot har brug for understøttelse af struktureret output til samtaletitler og SQL-generering."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "vLLM-serveren respekterede ikke et tvunget tool-kald. Metabot har brug for understøttelse af struktureret output til samtaletitler og SQL-generering."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "vLLM-serveren kan nås, men betjener ikke nogen modeller."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "vLLM-serveren betjener ikke {0}. Den betjener: {1}."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "vLLM-serveren besvarede ikke forbindelsestesten inden for {0}ms. Tjek, at den ikke er overbelastet — en server, der er så langsom til at besvare en triviel prompt, kan ikke drive Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "vLLM-serveren stoppede med at svare efter {0}ms. Hæv timeouten for vLLM-anmodninger, eller servér en hurtigere model."

#: metabase/metabot/self/vllm.clj
msgid "The connection to the vLLM server was interrupted before the response finished."
msgstr "Forbindelsen til vLLM-serveren blev afbrudt før svaret var færdigt."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not respond within {0}ms. Check that it is not overloaded, or raise the vLLM request timeout."
msgstr "vLLM-serveren svarede ikke inden for {0}ms. Tjek, at den ikke er overbelastet, eller hæv timeouten for vLLM-anmodninger."

