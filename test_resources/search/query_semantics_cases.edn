 {:id "S13"
  :focus "keyword negation cannot exclude a vector-only hit"
  :config "simple"
  :query "amber -cobalt"
  :docs {:A {:name "amber"}
         :B {:name "amber cobalt"}
         :C {:name "cobalt"}
         :D {:name "amber -cobalt"}}
