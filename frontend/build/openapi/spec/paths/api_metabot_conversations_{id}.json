{
  "get": {
    "description": "Return a single conversation with its flattened chat messages.\n\n  Accessible to any participant in the conversation or to any superuser.",
    "operationId": "get-api-metabot-conversations-id",
    "parameters": [
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "conversation_id": {
                  "description": "value must be a valid UUID.",
                  "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                  "type": "string"
                },
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "forked_from_conversation_id": {
                  "oneOf": [
                    {
                      "description": "value must be a valid UUID.",
                      "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messages": {
                  "items": {
                    "properties": {},
                    "type": "object"
                  },
                  "type": "array"
                },
                "saved_entities": {
                  "items": {
                    "properties": {
                      "card_id": {
                        "description": "value must be an integer greater than zero.",
                        "minimum": 1,
                        "type": "integer"
                      },
                      "chart_id": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "card_id",
                      "chart_id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "state": {
                  "oneOf": [
                    {
                      "$ref": "../components/schemas/metabase.metabot.schema.state.json"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "title": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "user_id": {
                  "oneOf": [
                    {
                      "description": "value must be an integer greater than zero.",
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "conversation_id",
                "created_at",
                "title",
                "user_id",
                "forked_from_conversation_id",
                "saved_entities",
                "messages"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/metabot/conversations/{id}",
    "tags": [
      "/api/metabot/conversations"
    ]
  }
}
