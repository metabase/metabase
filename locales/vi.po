msgstr "Người dùng có quyền truy vấn Thẻ này"

#: metabase_enterprise/permission_debug/impl.clj
msgid "User does not have permission to query this card"
msgstr "Người dùng không có quyền truy vấn Thẻ này"

#: metabase_enterprise/permission_debug/impl.clj
msgid "User has permission to download data from this card"
msgstr "Người dùng có quyền tải xuống dữ liệu từ Thẻ này"

#: metabase_enterprise/permission_debug/impl.clj
msgid "User has permission to read this card"
msgstr "Người dùng có quyền đọc Thẻ này"

#: metabase_enterprise/permission_debug/impl.clj
msgid "Unknown permission type"
msgstr "Loại quyền không xác định"

#: metabase_enterprise/premium_features/airgap.clj
msgid "Token validation failed."
msgstr "Xác thực token thất bại."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The remote branch to sync with, e.g. `main`"
msgstr "Nhánh remote để đồng bộ, ví dụ: `main`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "An Authorization Bearer token allowing access to the git repo over HTTP"
msgstr "Token Authorization Bearer cho phép truy cập repo git qua HTTP"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Có đồng bộ các biến đổi qua remote-sync hay không. Khi bật, tất cả biến đổi, thẻ biến đổi và công việc biến đổi sẽ được đồng bộ như một đơn vị duy nhất (tất cả-hoặc-không)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Allow specific remote sync behaviors. Set to overwrite-unpublished to allow overwriting unpublished changes on startup."
msgstr "Cho phép các hành vi đồng bộ từ xa cụ thể. Đặt thành overwrite-unpublished để cho phép ghi đè các thay đổi chưa publish khi khởi động."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The location of your git repository, e.g. https://github.com/acme-inco/metabase.git"
msgstr "Vị trí kho git của bạn, ví dụ https://github.com/acme-inco/metabase.git"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Thời gian sống (TTL) theo giây cho cache kiểm tra thay đổi từ remote. Mặc định là 60 giây."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Git synchronization type - :read-write or :read-only"
msgstr "Loại đồng bộ Git - :read-write hoặc :read-only"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to automatically import from the remote git repository. Only applies if remote-sync-type is :read-only."
msgstr "Có tự động import từ repo git remote hay không. Chỉ áp dụng nếu remote-sync-type là :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Nếu remote-sync-type là :read-only và remote-sync-auto-import là true, tần suất (tính bằng phút) để kiểm tra cập nhật cần import. Mặc định là 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The maximum amount of time a remote sync task will be given to complete"
msgstr "Khoảng thời gian tối đa một tác vụ đồng bộ từ xa được phép chạy để hoàn tất"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Is Git sync currently enabled?"
msgstr "Git sync hiện có đang được bật không?"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Thời gian chờ mạng (tính bằng giây) cho các thao tác git từ xa như fetch, push, clone và ls-remote. Nếu không, một kết nối bị treo có thể làm tác vụ sync bị treo vô thời hạn."

#: metabase_enterprise/sandbox/api/gtap.clj
msgid "Sandboxing with a saved question is not enabled for this database."
msgstr "Sandboxing với một Câu hỏi đã lưu không được bật cho cơ sở dữ liệu này."

#: metabase_enterprise/sandbox/api/gtap.clj
msgid "Please check you have set a valid Enterprise token and try again."
msgstr "Vui lòng kiểm tra xem bạn đã cài đặt một mã thông báo Enterprise hợp lệ và thử lại."

#: metabase_enterprise/sandbox/api/gtap.clj
msgid "Error: sandboxing is not enabled for this instance."
msgstr "Lỗi: chức năng sandboxing chưa được bật cho phiên bản này."

#: metabase_enterprise/sandbox/api/user.clj
msgid "value must be a valid user attributes map (name -> value)"
msgstr "giá trị phải là một map thuộc tính người dùng hợp lệ (tên -> giá trị)"

#: metabase_enterprise/sandbox/models/permissions/delete_sandboxes.clj
msgid "Error deleting Sandboxes: {0}"
msgstr "Lỗi khi xóa Sandboxes: {0}"

#: metabase_enterprise/sandbox/models/sandbox.clj
msgid "You do not have permissions to modify a question that is used for row and column level security."
msgstr "Bạn không có quyền sửa một câu hỏi được dùng cho bảo mật cấp hàng và cấp cột."

#: metabase_enterprise/sandbox/models/sandbox.clj
msgid "Sandbox Questions can''t return columns that have different types than the Table they are sandboxing."
msgstr "Câu hỏi Sandbox không thể trả về cột có kiểu khác với Bảng mà chúng được bảo vệ."

#: metabase_enterprise/sandbox/models/sandbox.clj
msgid "You cannot change the table ID of a sandbox once it has been created."
msgstr "Bạn không thể thay đổi ID bảng của một Sandbox sau khi nó đã được tạo."

#: metabase_enterprise/sandbox/models/sandbox.clj
msgid "Cannot update Card: Card is used for Sandboxing, and updates would violate sandbox rules."
msgstr "Không thể cập nhật Thẻ: Thẻ được sử dụng cho thử nghiệm, và các bản cập nhật sẽ vi phạm quy tắc thử nghiệm."

#: metabase_enterprise/sandbox/query_processor/middleware/sandboxing.clj
msgid "Query requires user attribute `{0}`"
msgstr "Truy vấn yêu cầu thuộc tính người dùng `{0}`"

#: metabase_enterprise/sandbox/query_processor/middleware/sandboxing.clj
msgid "Sandboxing"
msgstr "Sandboxing"

#: metabase_enterprise/sandbox/query_processor/middleware/sandboxing.clj
msgid "Error preprocessing query when applying Sandbox: {0}"
msgstr "Lỗi tiền xử lý truy vấn khi áp dụng Sandbox: {0}"

#: metabase_enterprise/sandbox/query_processor/middleware/sandboxing.clj
msgid "Found more than one group table access policy for user ''{0}''"
msgstr "Đã tìm thấy hơn một chính sách truy cập bảng nhóm cho người dùng ''{0}''"

#: metabase_enterprise/scim/settings.clj
msgid "Is SCIM currently enabled?"
msgstr "SCIM hiện đang được bật không?"

#: metabase_enterprise/scim/settings.clj
msgid "Base URL for SCIM endpoints"
msgstr "URL gốc cho các endpoint SCIM"

#: metabase_enterprise/security_center/api.clj
msgid "Security Center is not available on this instance."
msgstr "Security Center không khả dụng trên phiên bản cài đặt này."

#: metabase_enterprise/security_center/settings.clj
msgid "List of email recipients for Security Center notifications."
msgstr "Danh sách người nhận email cho các thông báo từ Security Center."

#: metabase_enterprise/security_center/settings.clj
msgid "Number of days between repeat notifications for each severity level."
msgstr "Số ngày giữa các lần gửi thông báo lặp lại cho từng mức độ nghiêm trọng."

#: metabase_enterprise/security_center/settings.clj
msgid "Slack is not configured for this instance."
msgstr "Slack chưa được cấu hình cho phiên bản cài đặt này."

#: metabase_enterprise/security_center/settings.clj
msgid "At least one email recipient is required."
msgstr "Cần ít nhất một người nhận email."

#: metabase_enterprise/security_center/settings.clj
msgid "Timestamp of the last successful Security Center advisory sync."
msgstr "Mốc thời gian của lần đồng bộ advisory Security Center thành công gần nhất."

#: metabase_enterprise/security_center/settings.clj
msgid "Slack channel for Security Center notifications. Null means Slack notifications are disabled."
msgstr "Kênh Slack cho thông báo từ Security Center. Null nghĩa là đã tắt thông báo Slack."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Default pgvector `hnsw.max_scan_tuples` (soft cap on tuples an iterative scan visits) for the `hnsw-iterative-*` strategies. Larger values improve recall under selective filters at the cost of latency. Individual requests may override this via the `vector_search_max_scan_tuples` API parameter."
msgstr "Giá trị mặc định pgvector `hnsw.max_scan_tuples` (giới hạn mềm về số tuple mà một lần quét lặp truy cập) cho các chiến lược `hnsw-iterative-*`. Giá trị lớn hơn cải thiện recall dưới các bộ lọc chọn lọc, đổi lại tăng độ trễ. Từng yêu cầu riêng lẻ có thể ghi đè giá trị này qua tham số API `vector_search_max_scan_tuples`."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Number of hours to retain stale semantic search indexes before cleanup."
msgstr "Số giờ giữ lại các chỉ mục tìm kiếm ngữ nghĩa cũ trước khi dọn dẹp."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Default vector-search strategy for semantic search: `hnsw` (approximate, HNSW-index-backed), `brute-force` (exact, applies non-vector filters first then computes cosine distance over the survivors), or `hnsw-iterative-relaxed`/`hnsw-iterative-strict` (HNSW-index-backed iterative scans with inline filters). Defaults to `brute-force`, which needs no index; selecting `hnsw` builds the HNSW index just-in-time. Individual requests may override this via the `vector_search_strategy` API parameter."
msgstr "Chiến lược vector-search mặc định cho semantic search: `hnsw` (xấp xỉ, dựa trên chỉ mục HNSW), `brute-force` (chính xác, áp dụng các bộ lọc không phải vector trước rồi tính khoảng cách cosine trên các bản ghi còn lại), hoặc `hnsw-iterative-relaxed`/`hnsw-iterative-strict` (quét lặp dựa trên chỉ mục HNSW với bộ lọc inline). Mặc định là `brute-force`, không cần chỉ mục; chọn `hnsw` sẽ build chỉ mục HNSW just-in-time. Từng yêu cầu riêng lẻ có thể ghi đè giá trị này qua tham số API `vector_search_strategy`."

#: metabase_enterprise/semantic_search/settings.clj
msgid "API key for authenticating with the embedding service. Leave empty for proxying thorugh ai-service. In that case premium-embedding-token is used for authentication."
msgstr "API key để xác thực với dịch vụ embedding. Để trống để proxy qua ai-service. Trong trường hợp đó, premium-embedding-token được dùng để xác thực."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Minimum number of semantic search results required before falling back to other engines."
msgstr "Số lượng tối thiểu kết quả tìm kiếm ngữ nghĩa yêu cầu trước khi fallback sang các engine khác."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Run EXPLAIN (ANALYZE) instrumentation of the inner vector subquery for every semantic search? Expensive (re-executes the inner query); intended for ad-hoc analysis. Individual requests may override this via the `vector_search_explain` API parameter."
msgstr "Chạy instrumentation EXPLAIN (ANALYZE) của vector subquery bên trong cho mọi semantic search? Tốn kém (chạy lại inner query); dành cho phân tích ad-hoc. Từng yêu cầu riêng lẻ có thể ghi đè thiết lập này qua tham số API `vector_search_explain`."

#: metabase_enterprise/semantic_search/settings.clj
msgid "The maximum number of tokens sent in a single embedding API call."
msgstr "Số lượng token tối đa được gửi trong một lần gọi API embedding."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Set the dimension size for the selected embedding model"
msgstr "Đặt kích thước chiều dữ liệu cho mô hình nhúng đã chọn"

#: metabase_enterprise/semantic_search/settings.clj
msgid "Default pgvector `hnsw.ef_search` (HNSW candidate-list size) for the `hnsw-iterative-*` strategies. Larger values improve recall at the cost of latency. Individual requests may override this via the `vector_search_ef_search` API parameter."
msgstr "Giá trị mặc định pgvector `hnsw.ef_search` (kích thước danh sách ứng viên HNSW) cho các chiến lược `hnsw-iterative-*`. Giá trị lớn hơn cải thiện recall, đổi lại tăng độ trễ. Từng yêu cầu riêng lẻ có thể ghi đè giá trị này qua tham số API `vector_search_ef_search`."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Number of threads to use for batched index updates, including embedding requests"
msgstr "Số lượng thread dùng cho cập nhật chỉ mục theo lô, bao gồm cả các yêu cầu nhúng"

#: metabase_enterprise/semantic_search/settings.clj
msgid "Maximum number of results to return from a single semantic search query."
msgstr "Số lượng kết quả tối đa trả về từ một truy vấn tìm kiếm ngữ nghĩa."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Set the embedding model for the selected provider"
msgstr "Đặt mô hình nhúng cho nhà cung cấp đã chọn"

#: metabase_enterprise/semantic_search/settings.clj
msgid "The registered embedding provider to use"
msgstr "Nhà cung cấp embedding đã đăng ký để sử dụng"

#: metabase_enterprise/semantic_search/settings.clj
msgid "Wrap embedding-service calls in a circuit breaker that fails fast after repeated failures. Runtime kill switch; the breaker thresholds are fixed."
msgstr "Bọc các lệnh gọi embedding-service trong một circuit breaker để fail fast sau các lần lỗi lặp lại. Kill switch lúc chạy; các ngưỡng của breaker là cố định."

#: metabase_enterprise/semantic_search/settings.clj
msgid "URL of the OpenAI-compatible embedding service (e.g. a LiteLLM proxy)."
msgstr "URL của dịch vụ nhúng tương thích OpenAI (vd. một proxy LiteLLM)."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Number of hours to retain tombstone records in the gate table before cleanup."
msgstr "Số giờ giữ lại các bản ghi tombstone trong bảng gate trước khi dọn dẹp."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Number of hours until repair tables are considered stale and eligible for cleanup, if they were not\n"
"    cleaned up successfully after use."
msgstr "Số giờ cho đến khi các bảng sửa chữa được coi là cũ và đủ điều kiện để dọn dẹp, nếu chúng không được\n"
"    dọn dẹp thành công sau khi sử dụng."

#: metabase_enterprise/semantic_search/settings.clj
msgid "Prefix prepended to search queries (but not indexed documents) before embedding them, as expected by asymmetric retrieval models such as the snowflake-arctic-embed family. It is prepended verbatim, so include any trailing separator. Leave empty to use the default for the model, which varies by generation: Arctic Embed v2.0 expects `query: `, earlier versions expect a longer instruction."
msgstr "Tiền tố được thêm vào trước các truy vấn tìm kiếm (nhưng không áp dụng cho các tài liệu đã được index) trước khi đem đi embedding, theo đúng kỳ vọng của các mô hình truy hồi bất đối xứng như họ snowflake-arctic-embed. Tiền tố được thêm nguyên văn, vì vậy hãy bao gồm cả ký tự phân tách ở cuối nếu cần. Để trống để dùng mặc định của mô hình, vốn thay đổi theo thế hệ: Arctic Embed v2.0 mong đợi `query: `, các phiên bản trước mong đợi một chỉ dẫn dài hơn."

