{
  "post": {
    "description": "Add dimensions to a metric. Each entry carries its UUID and mapping target; the column-derived fields and mapping\n  are recomputed server-side.\n\n  Returns the updated list of dimensions.",
    "operationId": "post-api-metric-id-dimension-add",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "dimensions": {
                "items": {
                  "properties": {
                    "description": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "display_name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "mapping_target": {
                      "$ref": "../components/schemas/metabase.lib-metric.schema..dimension-mapping.target.json"
                    }
                  },
                  "required": [
                    "id",
                    "mapping_target"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "dimensions"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "items": {
                "properties": {},
                "type": "object"
              },
              "type": "array"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/metric/{id}/dimension/add",
    "tags": [
      "/api/metric"
    ]
  }
}
