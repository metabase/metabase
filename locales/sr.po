msgstr "Nevažeći vremenski literal {0} u :absolute-datetime — koristite ISO-8601 datum, datum i vreme, godinu ili godinu-mesec."

#: metabase/ai_tracing/api.clj
msgid "Eval trace not found"
msgstr "Eval trace nije pronađen"

#: metabase/ai_tracing/settings.clj
msgid "Enable eval-time AI agent trace capture. When true, agent / MCP / agent-api runs capture a full trace (prompts, completions, tool I/O, custom spans) and write it as structured JSONL to a per-session file via the dedicated `metabase.ai-tracing.log` logger. Separate from MB_TRACING_ENABLED. Off by default; intended for dedicated eval instances, NOT production (traces contain full, unredacted user content)."
msgstr "Omogući hvatanje trace-a VI agenta u vreme eval-a. Kada je true, agent / MCP / agent-api pokretanja hvataju kompletan trace (promptove, completions, I/O alata, prilagođene spanove) i upisuju ga kao strukturirani JSONL u fajl po sesiji preko namenski `metabase.ai-tracing.log` logger-a. Odvojeno od MB_TRACING_ENABLED. Podrazumevano isključeno; namenjeno za namenske eval instance, NE za produkciju (trace-ovi sadrže celokupan, neredigovan korisnički sadržaj)."

#: metabase/analytics/prometheus.clj
