{
  "description": "Schema for an Exploration thread with hydrated selections and queries.",
  "properties": {
    "blocks": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.explorations.api.ExplorationBlockNode.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "canceled_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "exploration_id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "position": {
      "description": "value must be an integer greater or equal to than zero.",
      "minimum": 0,
      "type": "integer"
    },
    "prompt": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "queries": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.explorations.api.ExplorationQuerySummary.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_page_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "canceled",
        "empty",
        "failed",
        "completed",
        "forbidden"
      ],
      "type": "string"
    },
    "timelines": {
      "oneOf": [
        {
          "items": {
            "properties": {
              "position": {
                "description": "value must be an integer greater or equal to than zero.",
                "minimum": 0,
                "type": "integer"
              },
              "timeline": {
                "oneOf": [
                  {
                    "properties": {},
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeline_id": {
                "description": "value must be an integer greater than zero.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "timeline_id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "exploration_id",
    "position",
    "status"
  ],
  "type": "object"
}
