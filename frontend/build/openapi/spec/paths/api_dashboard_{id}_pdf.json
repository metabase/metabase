{
  "post": {
    "description": "Render Dashboard with ID to a PDF (server-side, the same way dashboard subscriptions render charts) and stream it\n  back as a file download.\n\n  `parameters` are runtime parameter overrides -- the same shape the dashcard query endpoints accept: a sequence of\n  `{:id ... :value ...}` maps, or a JSON-encoded string of that sequence (the string form lets an HTML `<form>`\n  action drive the download). Parameters left unspecified fall back to the dashboard's own defaults.\n\n  `paper_size` is `\"a4\"` (default) or `\"letter\"`.",
    "operationId": "post-api-dashboard-id-pdf",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "paper_size": {
                "default": "a4",
                "oneOf": [
                  {
                    "enum": [
                      "a4",
                      "letter"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parameters": {
                "oneOf": [
                  {
                    "$ref": "../components/schemas/metabase.parameters.schema..api.parameter-values.json"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {}
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/dashboard/{id}/pdf",
    "tags": [
      "/api/dashboard"
    ]
  }
}
