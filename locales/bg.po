msgstr "Не може да се опресни въпрос, който не е модел"

#: metabase/model_persistence/api.clj
msgid "Persisting models is not enabled."
msgstr "Persisting на модели не е активирано."

#: metabase/model_persistence/api.clj
msgid "Granular cache controls"
msgstr "Детайлни контроли за кеш"

#: metabase/model_persistence/api.clj
