msgstr "низ в cron синтаксис за планиране на опресняване на персистирани модели."

#: metabase/model_persistence/settings.clj
msgid "Allow persisting models into the source database."
msgstr "Разреши персистиране на модели в базата данни източник."

#: metabase/model_persistence/settings.clj
