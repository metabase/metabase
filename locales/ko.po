#: metabase/actions/settings.clj
msgid "Whether the Database has table data editing enabled."
msgstr "데이터베이스에서 테이블 데이터 편집 기능이 활성화되어 있는지 여부."

#: metabase/actions_rest/api.clj
msgid "Implicit actions are not supported for models with clauses."
msgstr "절이 있는 모델에는 암시적 동작이 지원되지 않습니다."

#: metabase/actions_rest/api.clj
msgid "Must provide a database_id for query actions"
msgstr "쿼리 작업에 대한 database_id를 제공해야 합니다."

#: metabase/actions_rest/api.clj
msgid "HTTP actions are not supported."
msgstr "HTTP 액션은 지원되지 않습니다."

#: metabase/agent_api/settings.clj
