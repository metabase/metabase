msgstr "Duhet të ekzekutoni `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate down` nga versioni {0}."

#: metabase/app_db/setup.clj
msgid "Your metabase instance appears to have been downgraded without a corresponding database downgrade."
msgstr "Instanca juaj e Metabase duket se është ulur në version pa një ulje përkatëse të databazës."

