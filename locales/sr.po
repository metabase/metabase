#: metabase/tracing/settings.clj
msgid "Enable OpenTelemetry tracing. When true, spans are exported to the configured OTLP collector."
msgstr "Omogući OpenTelemetry praćenje. Kada je uključeno, span-ovi se eksportuju u podešeni OTLP kolektor."

#: metabase/tracing/settings.clj
msgid "OTLP HTTP collector endpoint for trace export (e.g., http://localhost:4318/v1/traces)."
msgstr "OTLP HTTP endpoint kolektora za eksport trace-ova (npr. http://localhost:4318/v1/traces)."

#: metabase/tracing/settings.clj
msgid "Comma-separated list of trace groups to enable, or \"all\" for everything."
msgstr "Lista grupa trace-ova razdvojena zarezima koje treba omogućiti, ili \"all\" za sve."

#: metabase/tracing/settings.clj
msgid "Log level threshold during traced spans. When a span is active, log events at this level and above bypass per-logger level gates via Log4j2 DynamicThresholdFilter. Requires the filter in log4j2.xml. Valid values: \"INFO\", \"DEBUG\", \"TRACE\"."
msgstr "Prag nivoa logovanja tokom span-ova sa praćenjem. Kada je span aktivan, log događaji na ovom nivou i iznad zaobilaze per-logger pragove nivoa preko Log4j2 DynamicThresholdFilter. Zahteva filter u log4j2.xml. Važeće vrednosti: \"INFO\", \"DEBUG\", \"TRACE\"."

#: metabase/tracing/settings.clj
msgid "Maximum number of spans queued for export. When the queue is full, new spans are dropped silently. Controls memory usage when the collector is slow or unavailable."
msgstr "Maksimalan broj span-ova u redu za eksport. Kada je red pun, novi span-ovi se tiho odbacuju. Kontroliše upotrebu memorije kada je kolektor spor ili nedostupan."

#: metabase/tracing/settings.clj
msgid "Maximum time in milliseconds to wait for a batch export to complete. If the collector is slow or unreachable, the batch is dropped after this timeout."
msgstr "Maksimalno vreme u milisekundama za čekanje da se grupni eksport završi. Ako je kolektor spor ili nedostupan, paket se odbacuje nakon ovog isteka vremena."

#: metabase/tracing/settings.clj
msgid "Delay in milliseconds between consecutive batch span exports to the collector."
msgstr "Kašnjenje u milisekundama između uzastopnih grupnih eksportova span-ova ka kolektoru."

