    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {}
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/typed-schemas/v1/typescript",
    "tags": [
      "/api/typed-schemas"
    ]
  }
