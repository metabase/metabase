msgstr "Memeriksa nilai kolom tanggal atau angka untuk melihat apakah nilainya berada dalam rentang yang ditentukan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date or numeric column that should be within the start and end values."
msgstr "Kolom tanggal atau numerik yang harus berada di antara nilai awal dan akhir."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "start"
msgstr "awal"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
