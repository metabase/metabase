#: metabase/driver/postgres.clj
msgid "BRIN"
msgstr "BRIN"

#: metabase/driver/postgres.clj
msgid "Tiny and low-overhead. Best for large tables where values correlate with physical row order, like timestamps in an append-only log."
msgstr "Pieni ja kevyt. Paras suurille tauluille, joissa arvot korreloivat fyysisen rivijärjestyksen kanssa, kuten aikaleimat vain lisäyksiä sisältävässä lokissa."

