{
  "put": {
    "description": "Set whether one or more exploration pages are hidden from the sidebar. Hiding a single\n  page passes a one-element `page_ids`; hiding a whole group passes all its page ids.",
    "operationId": "put-api-exploration-pages-hidden",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "hidden": {
                "type": "boolean"
              },
              "page_ids": {
                "items": {
                  "description": "value must be an integer greater than zero.",
                  "minimum": 1,
                  "type": "integer"
                },
                "type": "array"
              }
            },
            "required": [
              "page_ids",
              "hidden"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "type": "null"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "PUT /api/exploration/pages/hidden",
    "tags": [
      "/api/exploration"
    ]
  }
}
