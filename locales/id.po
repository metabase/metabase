msgid "unit"
msgstr "satuan"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "Jenis interval seperti {0}, {1}, {2}."

