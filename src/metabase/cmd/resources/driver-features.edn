               :doc     "../questions/query-builder/expressions-list.md#integer"}
              {:feature :expressions/float
               :label   "float"
               :doc     "../questions/query-builder/expressions-list.md#float"}
              {:feature :expressions/text
               :label   "text"
               :doc     "../questions/query-builder/expressions-list.md#text"}
              {:feature :expressions/date
               :label   "date"
               :doc     "../questions/query-builder/expressions-list.md#date"}
              {:feature :expressions/datetime
