+// The page's own scrollbars aren't part of the story, and they would show in
+// the screenshot when a story is bigger than the window. Scrollbars inside the
+// story, like a scrolling table's, stay visible.
+const hidePageScrollbars = (window) => {
+  window.document.addEventListener('DOMContentLoaded', () => {
+    const styleElement = window.document.createElement('style');
+    window.document.documentElement.appendChild(styleElement);
+    styleElement.sheet.insertRule(
+      'html::-webkit-scrollbar, body::-webkit-scrollbar { display: none; }'
+    );
+  });
+};
