                            "minLength": 1,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "affected_versions": {
                        "$ref": "../components/schemas/metabase-enterprise.security-center.schema.affected-versions.json"
                      },
                      "description": {
                        "minLength": 1,
