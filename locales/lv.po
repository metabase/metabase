msgstr "vLLM API galapunkts netika atrasts — bāzes URL jābeidzas ar /v1"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "vLLM servera pieprasījumu rinda ir pilna — samaziniet vienlaicīgo slodzi vai restartējiet to ar lielāku --max-num-seqs"

#: metabase/metabot/self/vllm.clj
msgid "vLLM returned an internal server error"
msgstr "vLLM atgrieza iekšēju servera kļūdu"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "vLLM API kļūda (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "Could not reach the vLLM server at {0}. Check that it is running and that the base URL is correct."
msgstr "Neizdevās sasniegt vLLM serveri pie {0}. Pārbaudiet, vai tas darbojas un vai bāzes URL ir pareizs."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "vLLM serveris pie {0} neatbildēja {1}ms laikā. Pārbaudiet, vai tas darbojas un nav pārslogots."

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "Pārbaudiet, vai {0} ir vLLM servera OpenAI-saderīgs API — bāzes URL jābeidzas ar /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} tiek apkalpots ar {1} tokenu konteksta logu, kas Metabot ir par mazu — nepieciešami vismaz {2}. Restartējiet vLLM ar lielāku --max-model-len."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} straumēja savu spriešanu kā čata tekstu. Restartējiet vLLM ar --reasoning-parser, lai domāšana neparādītos Metabot atbildēs."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} sasniedza {1} tokenu connection-test limitu rīka izsaukuma vidū. Modelis, kas ģenerē tik daudz pirms rīka izsaukšanas, ir pārāk lēns, lai darbinātu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "vLLM serveris atgrieza rīka izsaukumu, kura argumenti nav derīgs JSON. Visticamāk, --tool-call-parser neatbilst {0}''s izvades formātam."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} visu {1} tokenu connection-test budžetu veltīja spriešanai, neizsaucot rīku. Modelis, kas tik ilgi domā par triviālu uzvedni, ir pārāk lēns, lai darbinātu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} sasniedza {1} tokenu connection-test limitu, pirms pabeidza rīka izsaukumu. Modelis, kas ģenerē tik daudz pirms rīka izsaukšanas, ir pārāk lēns, lai darbinātu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "vLLM serveris atbildēja ar tekstu, nevis izsauca rīku. Restartējiet to ar --enable-auto-tool-choice un --tool-call-parser, kas atbilst {0}''s izvades formātam."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} sasniedza {1} tokenu connection-test limitu, neizveidojot piespiedu rīka izsaukumu. Metabot nepieciešams strukturētās izvades atbalsts sarunu nosaukumiem un SQL ģenerēšanai."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "vLLM serveris neievēroja piespiedu rīka izsaukumu. Metabot nepieciešams strukturētās izvades atbalsts sarunu nosaukumiem un SQL ģenerēšanai."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "vLLM serveris ir sasniedzams, bet neapkalpo nevienu modeli."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "vLLM serveris neapkalpo {0}. Tas apkalpo: {1}."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "vLLM serveris neatbildēja uz savienojuma testu {0}ms laikā. Pārbaudiet, vai tas nav pārslogots — serveris, kas tik lēni atbild uz triviālu uzvedni, nevar darbināt Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "vLLM serveris pārstāja atbildēt pēc {0}ms. Palieliniet vLLM pieprasījuma taimautu vai apkalpojiet ātrāku modeli."

#: metabase/metabot/self/vllm.clj
msgid "The connection to the vLLM server was interrupted before the response finished."
msgstr "Savienojums ar vLLM serveri tika pārtraukts, pirms atbilde tika pabeigta."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not respond within {0}ms. Check that it is not overloaded, or raise the vLLM request timeout."
msgstr "vLLM serveris neatbildēja {0}ms laikā. Pārbaudiet, vai tas nav pārslogots, vai palieliniet vLLM pieprasījuma taimautu."

