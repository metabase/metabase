msgstr "Hodnota percentilu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Converts a number or date to text. Useful for applying text filters or joining with other columns based on text comparisons."
msgstr "Konvertuje číslo alebo dátum na text. Užitočné na aplikovanie textových filtrov alebo joinovanie s inými stĺpcami na základe textových porovnaní."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "value"
msgstr "hodnota"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
