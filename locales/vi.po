#: metabase/metabot/self/vllm.clj
msgid "vLLM API key expired or invalid — check the key your server was started with via --api-key"
msgstr "API key vLLM đã hết hạn hoặc không hợp lệ — hãy kiểm tra key mà máy chủ của bạn được khởi chạy với qua --api-key"

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} đã dùng hết toàn bộ ngân sách {1} token của bài test kết nối để lập luận mà không gọi tool. Một mô hình nghĩ lâu như vậy về một prompt đơn giản là quá chậm để vận hành Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "Máy chủ vLLM trả lời bằng văn bản thay vì gọi tool. Khởi động lại với --enable-auto-tool-choice và --tool-call-parser khớp với định dạng đầu ra của {0}."

#: metabase/metabot/self/zai.clj
msgid "Z.AI API key expired or invalid"
msgstr "API key Z.AI đã hết hạn hoặc không hợp lệ"

#: metabase/metabot/self/zai.clj
msgid "Z.AI has rate limited us"
msgstr "Z.AI đã giới hạn tốc độ đối với chúng tôi"

#: metabase/metabot/self/zai.clj
msgid "AI proxy is not supported for Z.AI"
msgstr "AI proxy không được hỗ trợ cho Z.AI"

#: metabase/metabot/self/zai.clj
msgid "Z.AI returned an internal server error"
msgstr "Z.AI trả về lỗi máy chủ nội bộ"

#: metabase/metabot/self/zai.clj
msgid "Z.AI API error (HTTP {0})"
msgstr "Lỗi API Z.AI (HTTP {0})"

#: metabase/metabot/self/zai.clj
msgid "Z.AI API endpoint was not found — check the base URL"
msgstr "Không tìm thấy endpoint API Z.AI — kiểm tra base URL"

#: metabase/metabot/settings.clj
msgid "The display name for Metabot, shown throughout the Metabase UI."
msgstr "Tên hiển thị của Metabot, được hiển thị xuyên suốt UI của Metabase."

#: metabase/metabot/settings.clj
msgid "The icon for Metabot. Set to `metabot` for the default icon, or a data URI for a custom uploaded image (up to 1MB)."
msgstr "Icon cho Metabot. Đặt là `metabot` để dùng icon mặc định, hoặc một data URI cho ảnh tải lên tùy chỉnh (tối đa 1MB)."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the natural language query (AI exploration) experience."
msgstr "Hướng dẫn tùy chỉnh được thêm vào system prompt của Metabot cho trải nghiệm truy vấn ngôn ngữ tự nhiên (khám phá dữ liệu bằng AI)."

#: metabase/metabot/settings.clj
msgid "Unsupported model {0} for Metabase managed AI. Supported models: {1}"
msgstr "Mô hình {0} không được hỗ trợ cho AI do Metabase quản lý. Các mô hình được hỗ trợ: {1}"

#: metabase/metabot/settings.clj
msgid "Whether Metabot is enabled for embedding."
msgstr "Metabot có được bật cho nhúng hay không."

#: metabase/metabot/settings.clj
msgid "Override Metabot ID for agent streaming requests."
msgstr "Ghi đè ID Metabot cho các yêu cầu streaming của agent."

#: metabase/metabot/settings.clj
msgid "Whether to show Metabot illustrations in the UI."
msgstr "Có hiển thị minh họa Metabot trong UI hay không."

#: metabase/metabot/settings.clj
msgid "Model name is required. Expected format: connection/model, e.g. \"anthropic/claude-haiku-4-5\""
msgstr "Tên mô hình là bắt buộc. Định dạng mong đợi: connection/model, ví dụ: \"anthropic/claude-haiku-4-5\""

#: metabase/metabot/settings.clj
msgid "Metabot provider must be a string, got: {0}"
msgstr "Nhà cung cấp Metabot phải là chuỗi, nhận được: {0}"

#: metabase/metabot/settings.clj
msgid "Number of days to retain rows in the ai_usage_log, metabot_conversation, and metabot_message tables. Minimum value is 30; set to 0 to retain data indefinitely."
msgstr "Số ngày giữ lại các dòng trong các bảng ai_usage_log, metabot_conversation và metabot_message. Giá trị tối thiểu là 30; đặt thành 0 để giữ dữ liệu vô thời hạn."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the SQL generation experience."
msgstr "Hướng dẫn tùy chỉnh được thêm vào system prompt của Metabot cho trải nghiệm tạo SQL."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the chat experience (the AI sidebar and embedded Metabot)."
msgstr "Hướng dẫn tùy chỉnh được thêm vào system prompt của Metabot cho trải nghiệm chat (thanh bên AI và Metabot được nhúng)."

#: metabase/metabot/settings.clj
msgid "The AI provider connection and model used for quick background tasks, such as naming Metabot conversations, in the same connection-key/model-name format as `llm-metabot-provider`. Defaults to the fastest model offered by the connection Metabot runs on."
msgstr "Kết nối nhà cung cấp AI và mô hình dùng cho các tác vụ nền nhanh, như đặt tên cuộc hội thoại Metabot, theo cùng định dạng connection-key/model-name như `llm-metabot-provider`. Mặc định là mô hình nhanh nhất do kết nối mà Metabot chạy trên đó cung cấp."

#: metabase/metabot/settings.clj
msgid "The AI provider connection and model for Metabot. Format: connection-key/model-name, e.g. `anthropic/claude-haiku-4-5`, `openai/gpt-5.4`, `openrouter/anthropic/claude-haiku-4.5`. The connection key names an entry in the `llm-providers` setting and defaults to the provider type."
msgstr "Kết nối nhà cung cấp AI và mô hình cho Metabot. Định dạng: connection-key/model-name, ví dụ: `anthropic/claude-haiku-4-5`, `openai/gpt-5.4`, `openrouter/anthropic/claude-haiku-4.5`. Khóa kết nối đặt tên cho một mục trong thiết lập `llm-providers` và mặc định là loại nhà cung cấp."

#: metabase/metabot/settings.clj
msgid "Whether the user''s recently viewed items are included in the Metabot system prompt."
msgstr "Có bao gồm các mục người dùng vừa xem gần đây trong prompt hệ thống của Metabot hay không."

#: metabase/metabot/settings.clj
msgid "Whether Metabot is enabled for regular usage."
msgstr "Metabot có được bật cho sử dụng thông thường hay không."

#: metabase/metabot/settings.clj
msgid "Invalid Azure model {0}. Expected format: <connection>/<family>/<deployment-name> where <family> is one of: {1}"
msgstr "Mô hình Azure không hợp lệ {0}. Định dạng mong đợi: <connection>/<family>/<deployment-name> trong đó <family> là một trong: {1}"

#: metabase/metabot/tools/construct.clj
msgid "Multiple databases share the name `{0}` (ids: {1}). The agent has no way to disambiguate; ask the user to rename one of the databases or use a more specific identifier."
msgstr "Nhiều cơ sở dữ liệu dùng chung tên `{0}` (id: {1}). Agent không có cách khử nhập nhằng; hãy yêu cầu người dùng đổi tên một trong các cơ sở dữ liệu hoặc dùng một định danh cụ thể hơn."

#: metabase/metabot/tools/construct.clj
msgid "First stage must have either `source-table:` (as a portable FK `[<db-name>, <schema>, <table>]`) or `source-card:` (as an entity_id string). Neither was found in `stages[0]`."
msgstr "Stage đầu tiên phải có либо `source-table:` (dạng FK portable `[<db-name>, <schema>, <table>]`) hoặc `source-card:` (dạng chuỗi entity_id). Không tìm thấy cái nào trong `stages[0]`."

#: metabase/metabot/tools/construct.clj
msgid "`source-table:` does not accept URIs like `{0}`. {1}"
msgstr "`source-table:` không chấp nhận URI như `{0}`. {1}"

#: metabase/metabot/tools/construct.clj
msgid "The constructed query is not runnable - it would fail the query builder''s validation, so it cannot be visualized or saved. This usually means a field reference is missing its type or names a column that does not exist, or an aggregation/window function (e.g. `offset`) was placed in `expressions:` (custom columns) where it is not allowed - move it to `aggregation:` or `order-by:`. Schema validation details: {0}"
msgstr "Truy vấn đã tạo dựng không thể chạy - nó sẽ không vượt qua kiểm tra hợp lệ của trình dựng truy vấn, nên không thể trực quan hóa hoặc lưu. Điều này thường nghĩa là một tham chiếu trường bị thiếu kiểu hoặc đang gọi tên một cột không tồn tại, hoặc một hàm tổng hợp/cửa sổ (ví dụ: `offset`) đã được đặt trong `expressions:` (cột tùy chỉnh) nơi không được phép - hãy chuyển nó sang `aggregation:` hoặc `order-by:`. Chi tiết kiểm tra schema: {0}"

#: metabase/metabot/tools/construct.clj
msgid "Unknown database: `{0}`. Use the exact database name as reported by search / `read_resource` (it appears as the first element of every portable FK, e.g. `source-table: [<db-name>, <schema>, <table>]`)."
msgstr "Cơ sở dữ liệu không xác định: `{0}`. Hãy dùng đúng tên cơ sở dữ liệu như được báo bởi search / `read_resource` (nó xuất hiện là phần tử đầu tiên của mỗi FK portable, ví dụ `source-table: [<db-name>, <schema>, <table>]`)."

#: metabase/metabot/tools/construct.clj
#: metabase/models/serialization/resolve/mp.clj
msgid "No saved question or model found with entity_id {0}. Do not invent or guess entity_ids: call `read_resource` with `metabase://question/<numeric id>` or `metabase://model/<numeric id>` first, then copy the exact `portable_entity_id` from the response into `source-card:`."
msgstr "Không tìm thấy Câu hỏi đã lưu hoặc mô hình nào với entity_id {0}. Đừng tự bịa hoặc đoán entity_ids: trước tiên hãy gọi `read_resource` với `metabase://question/<numeric id>` hoặc `metabase://model/<numeric id>`, rồi copy đúng `portable_entity_id` từ phản hồi vào `source-card:`."

#: metabase/metabot/tools/entity_details.clj
msgid "Invalid metabot_id {0}"
msgstr "metabot_id {0} không hợp lệ"

#: metabase/metabot/tools/metadata.clj
msgid "Too many {0} IDs provided ({1}). Limit to {2}."
msgstr "Đã cung cấp quá nhiều ID {0} ({1}). Giới hạn là {2}."

