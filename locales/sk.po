msgid "Score"
msgstr "Skóre"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "percentile-value"
msgstr "percentilná hodnota"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
