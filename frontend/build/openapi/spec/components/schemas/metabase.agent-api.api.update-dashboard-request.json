{
  "description": "Patch shape for `update_dashboard`. Metadata fields and an optional `dashcards` list of\n   add/add_heading/add_text/update_text/remove/move mutations applied in order.",
  "properties": {
    "archived": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "dashcards": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.agent-api.api.dashcard-mutation.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object"
}
