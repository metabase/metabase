{:cases
 [{:name       "one select is a single read"
   :dialect    "postgres"
   :sql        "SELECT * FROM orders"
   :stmt-type  "read"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "two statements are not a single statement"
   :dialect    "postgres"
   :sql        "SELECT * FROM orders; DELETE FROM people"
   :stmt-type  "read"
   :expected   {:verdict :disallowed :single-stmt? false}}

  {:name       "a trailing semicolon does not make a second statement"
   :dialect    "postgres"
   :sql        "SELECT * FROM orders;"
   :stmt-type  "read"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a semicolon inside a literal is not a statement boundary"
   :dialect    "postgres"
   :sql        "SELECT * FROM orders WHERE note = 'a; b'"
   :stmt-type  "read"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a write is a single statement, but not a read"
   :dialect    "postgres"
   :sql        "DELETE FROM people WHERE id = 1"
   :stmt-type  "read"
   :expected   {:verdict :disallowed :single-stmt? true}}

  {:name       "the same write, asked for as a write"
   :dialect    "postgres"
   :sql        "DELETE FROM people WHERE id = 1"
   :stmt-type  "write"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a write that advances a sequence is still a write"
   :dialect    "postgres"
   :sql        "INSERT INTO orders (id) VALUES (nextval('orders_id_seq'))"
   :stmt-type  "write"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a confined write is a write"
   :dialect    "postgres"
   :sql        "UPDATE orders SET total = 0 WHERE id = 1"
   :stmt-type  "confined-write"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a confined write advances no sequence"
   :dialect    "postgres"
   :sql        "INSERT INTO orders (id) VALUES (nextval('orders_id_seq'))"
   :stmt-type  "confined-write"
   :expected   {:verdict :disallowed :single-stmt? true :reason "write-function" :detail "nextval"}}

  {:name       "nor one spelled as a pseudo-column"
   :dialect    "snowflake"
   :sql        "INSERT INTO orders (id) SELECT orders_seq.nextval"
   :stmt-type  "confined-write"
   :expected   {:verdict :disallowed :single-stmt? true :reason "write-function" :detail "nextval"}}

  {:name       "nor one spelled the SQL standard's way"
   :dialect    "tsql"
   :sql        "INSERT INTO orders (id) VALUES (NEXT VALUE FOR orders_seq)"
   :stmt-type  "confined-write"
   :expected   {:verdict :disallowed :single-stmt? true :reason "write-function" :detail "next value for"}}

  {:name       "a confined write returns no rows"
   :dialect    "postgres"
   :sql        "UPDATE orders SET total = 0 WHERE id = 1 RETURNING id"
   :stmt-type  "confined-write"
   :expected   {:verdict :disallowed :single-stmt? true :reason "returning"}}

  {:name       "a write may return rows"
   :dialect    "postgres"
   :sql        "UPDATE orders SET total = 0 WHERE id = 1 RETURNING id"
   :stmt-type  "write"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a confined write may feed one of its CTEs' returned rows into its table"
   :dialect    "postgres"
   :sql        "WITH d AS (DELETE FROM orders RETURNING id) INSERT INTO archive SELECT id FROM d"
   :stmt-type  "confined-write"
   :expected   {:verdict :allowed    :single-stmt? true}}

  {:name       "a SELECT is not a confined write"
   :dialect    "postgres"
   :sql        "SELECT * FROM orders"
   :stmt-type  "confined-write"
   :expected   {:verdict :disallowed :single-stmt? true}}

  {:name       "a CTE ahead of a select is still one read"
   :dialect    "postgres"
   :sql        "WITH c AS (SELECT id FROM people) SELECT * FROM c"
   :stmt-type  "read"
   :expected   {:verdict :allowed    :single-stmt? true}}]}
