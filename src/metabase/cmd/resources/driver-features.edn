              {:feature :convert-timezone
               :label   "convertTimezone"
               :doc     "../questions/query-builder/expressions/converttimezone.md"}
              {:feature :expressions/today
               :label   "today"
               :doc     "../questions/query-builder/expressions-list.md#today"}]}

  {:title    "Data modeling"
   :features [{:feature :persist-models
               :label   "Model persistence"
               :doc     "../data-modeling/models/model-persistence.md"}
