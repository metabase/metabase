{:paths
 ["src" "resources"]

 :deps
 {net.snowflake/snowflake-jdbc-thin {:mvn/version "4.3.4"
                                     :exclusions  [io.grpc/grpc-netty-shaded
                                                   ;; This will already get excluded automatically by the build tools
                                                   ;; since it's a top-level dep in `/deps.edn` but adding the
                                                   ;; exclusion here will (hopefully?) prevent code scanning alerts
                                                   ;; from complaining about it as well.
                                                   io.netty/netty-codec-http
                                                   io.netty/netty-codec-http2
                                                   ;; Azure SDK's Netty HTTP transport is only used for PUT/GET to
                                                   ;; Azure-backed Snowflake stages, which Metabase never does
                                                   ;; (read-only SQL driver). Excluding the Netty transport removes
                                                   ;; the entire reactor-netty + transitive Netty 4.1.x chain.
                                                   com.azure/azure-core-http-netty
                                                   ;; pinned in and resolved from /deps.edn
                                                   com.fasterxml.jackson.core/jackson-core
                                                   com.fasterxml.jackson.core/jackson-databind
                                                   io.opentelemetry/opentelemetry-api
                                                   org.bouncycastle/bcpkix-jdk18on
                                                   org.bouncycastle/bcprov-jdk18on
                                                   org.bouncycastle/bcutil-jdk18on]}
  ;; pinned: snowflake-jdbc-thin 3.28.0 pulls zstd-jni 1.5.6-5, which has out-of-bounds
  ;; read vulns in ZstdDictCompress/ZstdDictDecompress (CVE-2026-87795 et al.), fixed in 1.5.7-14
  com.github.luben/zstd-jni         {:mvn/version "1.5.7-16"}
  ;; drop when snowflake update driver to the one without the vulnerabilities
  com.nimbusds/nimbus-jose-jwt      {:mvn/version "10.5"}
  io.grpc/grpc-netty-shaded         {:mvn/version "1.77.0"}
  org.apache.commons/commons-lang3  {:mvn/version "3.19.0"}
  ;; pinned: snowflake-jdbc-thin 3.28.0 pulls jsoup 1.15.3
  org.jsoup/jsoup                   {:mvn/version "1.23.2"}
  ;; pin Bouncy Castle explicitly so the bundled driver JAR uses the patched version
  org.bouncycastle/bcpkix-jdk18on   {:mvn/version "1.85"}
  org.bouncycastle/bcprov-jdk18on   {:mvn/version "1.85.2"}
  org.bouncycastle/bcutil-jdk18on   {:mvn/version "1.85"}
  ;; pinned: azure-core 1.57.0 (transitive via snowflake-jdbc-thin) pulls reactor-core 3.7.11
  io.projectreactor/reactor-core    {:mvn/version "3.8.7"}}}
