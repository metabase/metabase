                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "recovery_codes": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "recovery_codes"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/ee/mfa/recovery-codes",
