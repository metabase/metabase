msgstr "Iestatījumi veiksmīgi saglabāti"

#: enterprise/frontend/src/metabase-enterprise/remote_sync/hooks/use-remote-sync-submit.ts
msgid "Settings could not be saved"
msgstr "Iestatījumus neizdevās saglabāt"

#: enterprise/frontend/src/metabase-enterprise/remote_sync/hooks/use-remote-sync-submit.ts
msgid "Switch branches?"
msgstr "Pārslēgt zaru?"

#: enterprise/frontend/src/metabase-enterprise/remote_sync/hooks/use-remote-sync-submit.ts
msgid "The synced collection will update to match the new branch. Questions that exist in the current branch but not the new one will be removed from any dashboards or content that reference them permanently, even if you switch back."
msgstr "Sinhronizētā kolekcija tiks atjaunināta atbilstoši jaunajam zaram. Jautājumi, kas eksistē pašreizējā zarā, bet ne jaunajā, tiks neatgriezeniski noņemti no visiem informācijas paneļiem vai satura, kas uz tiem atsaucas, pat ja vēlāk pārslēgsieties atpakaļ."

#: enterprise/frontend/src/metabase-enterprise/remote_sync/utils.ts
msgid "The sync branch changed in another session. Refresh the page and try again."
msgstr "Sinhronizācijas zars tika mainīts citā sesijā. Atsvaidziniet lapu un mēģiniet vēlreiz."

#: enterprise/frontend/src/metabase-enterprise/remote_sync/utils.ts
msgid "Your changes conflict with the remote repository. You can force push to override them."
msgstr "Jūsu izmaiņas konfliktē ar attālo repozitoriju. Varat veikt force push, lai tās pārrakstītu."

#: enterprise/frontend/src/metabase-enterprise/remote_sync/utils.ts
msgid "Something went wrong. Please try again."
msgstr "Kaut kas nogāja greizi. Lūdzu, mēģiniet vēlreiz."

