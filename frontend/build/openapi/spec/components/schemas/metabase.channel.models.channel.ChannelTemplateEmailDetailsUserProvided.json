{
  "description": "Email template details schema for API-provided templates. Only handlebars-text is allowed;\n  handlebars-resource is restricted to internal use only.",
  "properties": {
    "body": {
      "type": "string"
    },
    "recipient-type": {
      "enum": [
        "cc",
        "bcc",
        "cc",
        "bcc"
      ]
    },
    "subject": {
      "type": "string"
    },
    "type": {
      "enum": [
        "email/handlebars-text",
        "email/handlebars-text"
      ]
    }
  },
  "required": [
    "type",
    "subject",
    "body"
  ],
  "type": "object"
}
