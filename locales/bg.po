msgstr "стойността трябва да е валиден map от schedule map-ове за DB."

#: metabase/sync/settings.clj
msgid "Whether an introductory modal should be shown after the next database connection is added. Defaults to false if any non-default database has already finished syncing for this instance."
msgstr "Дали да се покаже въвеждащ модал след добавяне на следващата връзка към база данни. По подразбиране е false, ако вече е завършила синхронизацията за която и да е нестандартна база данни за тази инстанция."

#: metabase/sync/sync_metadata/sync_timezone.clj
msgid "Invalid timezone {0}: {1}"
msgstr "Невалидна часова зона {0}: {1}"

