{
  "description": "ClickHouse data-skipping index, standalone. Only arg-free types; the parameterized ones need type-args the form\n  can't supply yet.",
  "properties": {
    "columns": {
      "items": {
        "$ref": "./metabase.indexes.schema.column.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "granularity": {
      "minimum": 1,
      "type": "integer"
    },
    "kind": {
      "const": "skip-index"
    },
    "name": {
      "$ref": "./metabase.indexes.schema.index-name.json"
    },
    "type": {
      "enum": [
        "minmax",
        "bloom_filter"
      ],
      "type": "string"
    }
  },
  "required": [
    "kind",
    "name",
    "columns",
    "type"
  ],
  "type": "object"
}
