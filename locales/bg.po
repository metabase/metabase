msgstr "Да се изпращат ли нови имейл нотификации до администраторите за всички нови SSO потребители?"

#: metabase/sso/settings.clj
msgid "Is Google Sign-in currently enabled?"
msgstr "В момента Google Sign-in включен ли е?"

#: metabase/sso/settings.clj
msgid "Invalid authentication mode. Must be \"sso\" or \"link-only\""
msgstr "Невалиден режим на удостоверяване. Трябва да е \"sso\" или \"link-only\""

#: metabase/sso/settings.clj
msgid "Search base for groups. Not required for LDAP directories that provide a ''memberOf'' overlay, such as Active Directory. (Will be searched recursively)"
msgstr "Search base за групи. Не е необходимо за LDAP директории, които предоставят 'memberOf' overlay, като Active Directory. (Ще се търси рекурсивно)"

#: metabase/store_api/settings.clj
msgid "Store API URL."
msgstr "Store API URL."

#: metabase/sync/api/notify.clj
msgid "Table ''{0}.{1}'' already exists"
msgstr "Таблица ''{0}.{1}'' вече съществува"

#: metabase/sync/api/notify.clj
msgid "Unable to identify table ''{0}.{1}''"
msgstr "Не може да се идентифицира таблица ''{0}.{1}''"

#: metabase/sync/schedules.clj
