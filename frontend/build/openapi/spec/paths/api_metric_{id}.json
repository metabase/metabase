{
  "get": {
    "description": "Fetch a `Metric` with ID.\n\n  Returns the metric with hydrated dimensions and dimension mappings; the `::MetricWithDimensions`\n  schema encodes them to the snake_case wire shape at the `defendpoint` edge.",
    "operationId": "get-api-metric-id",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "include-orphaned",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/metabase.metrics.api.MetricWithDimensions.json"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/metric/{id}",
    "tags": [
      "/api/metric"
    ]
  }
}
