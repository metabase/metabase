msgstr "Poimii hostin (domain-nimi ja TLD, esim. `\"metabase.com\"` arvosta `\"status.metabase.com\"`) URL-osoitteesta tai sähköpostista"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract the host from."
msgstr "URL- tai sähköpostisarake, josta host poimitaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` contains `$string2` within it (or `$string3`, etc. if specified)."
msgstr "Palauttaa `true`, jos `$string1` sisältää `$string2`:n (tai `$string3`:n jne., jos määritetty)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string1"
msgstr "string1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to check."
msgstr "Sarake tai teksti, joka tarkistetaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string2"
msgstr "string2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string of text to look for."
msgstr "Etsittävä tekstijono."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Small"
msgstr "Pieni"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more values to look for."
msgstr "Voit lisätä lisää etsittäviä arvoja."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. Set to `\"case-insensitive\"` to perform a case-insensitive match."
msgstr "Valinnainen. Aseta arvoksi `\"case-insensitive\"`, jos haluat kirjainkoon huomioimattoman haun."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` does not contain `$string2` within it (and `$string3`, etc. if specified)."
msgstr "Palauttaa `true`, jos `$string1` ei sisällä `$string2`:n (ja `$string3`:n jne., jos määritetty)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the beginning of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Palauttaa true, jos `$string1`:n alku vastaa `$string2`:ta (tai `$string3`:a jne., jos määritetty)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the end of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Palauttaa true, jos `$string1`:n loppu vastaa `$string2`:ta (tai `$string3`:a jne., jos määritetty)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is empty"
msgstr "Tarkistaa, onko sarake tyhjä"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column to check."
msgstr "Tarkistettava sarake."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not empty"
msgstr "Tarkistaa, ettei sarake ole tyhjä"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized short name (eg. `\"Apr\"`) for the given month number (eg. `4`)"
msgstr "Palauttaa lokalisoidun lyhyen nimen (esim. `\"Apr\"`) annetulle kuukauden numerolle (esim. `4`)"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "monthNumber"
msgstr "monthNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a month in the year, `1` to `12`."
msgstr "Sarake tai lauseke, joka antaa kuukauden numeron vuodessa, `1`–`12`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Birthday Month"
msgstr "Syntymäkuukausi"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns a string like `\"Q1\"`, given the quarter number"
msgstr "Palauttaa merkkijonon kuten `\"Q1\"` annetun neljänneksen numeron perusteella"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "quarterNumber"
msgstr "quarterNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a quarter of the year, `1` to `4`."
msgstr "Sarake tai lauseke, joka antaa vuosineljänneksen numeron, `1`–`4`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Fiscal Quarter"
msgstr "Tilikauden neljännes"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized name of a day of the week, given the day's number."
msgstr "Palauttaa viikonpäivän локализoidun nimen päivän numeron perusteella."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "dayNumber"
msgstr "dayNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a day of the week, `1` to `7`. Which day is `1` is defined in your localization setting; default Sunday."
msgstr "Sarake tai lauseke, joka antaa viikonpäivän numeron, `1`–`7`. Se, mikä päivä on `1`, määräytyy lokalisointiasetuksesi mukaan; oletuksena sunnuntai."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weekday"
msgstr "Viikonpäivä"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a time interval of specified length"
msgstr "Hakee tietynpituisen aikavälin"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/xrays/automagic_dashboards/names.clj
msgid "number"
msgstr "numero"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of interval, where negative values are back in time."
msgstr "Aikavälin pituus; negatiiviset arvot tarkoittavat menneisyyteen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "unit"
msgstr "yksikkö"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "Aikavälin tyyppi, kuten {0}, {1}, {2}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date column's values to see if they're within the relative range."
msgstr "Tarkistaa, ovatko päivämääräsarakkeen arvot suhteellisen alueen sisällä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to return interval of."
msgstr "Päivämääräsarake, josta aikaväli palautetaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Created At"
msgstr "Luotu"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if a column's value falls within an interval, starting from an initial, offsetting interval."
msgstr "Palauttaa true, jos sarakkeen arvo osuu väliin, joka alkaa alkuperäisestä, siirretystä aikavälistä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to check."
msgstr "Tarkistettava päivämääräsarake."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of the interval, where negative numbers go back in time."
msgstr "Aikavälin pituus; negatiiviset luvut menevät ajassa taaksepäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetValue"
msgstr "offsetValue"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The initial interval period to start from, where negative values are back in time."
msgstr "Alkuperäisen aikavälin pituus, josta aloitetaan; negatiiviset arvot ovat ajassa taaksepäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetUnit"
msgstr "offsetUnit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a timestamp relative to the current time"
msgstr "Hakee aikaleiman suhteessa nykyhetkeen"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer with the number of the year."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun vuoden numerolla."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The datetime column."
msgstr "Datetime-sarake."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`4`) with the number of the quarter in the year."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`1`–`4`), joka on vuosineljänneksen numero."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`12`) with the number of the month in the year."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`1`–`12`), joka on kuukauden numero vuodessa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the week of the year as an integer."
msgstr "Poimii vuoden viikon numeron kokonaislukuna."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The name of the column with your date or datetime value."
msgstr "Sen sarakkeen nimi, jossa on päivämäärä- tai datetime-arvosi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. The default is `\"ISO\"`.\n"
"- ISO: Week 1 starts on the Monday before the first Thursday of January.\n"
"- US: Week 1 starts on Jan 1. All other weeks start on Sunday.\n"
"- Instance: Week 1 starts on Jan 1. All other weeks start on the day defined in your Metabase localization settings."
msgstr "Valinnainen. Oletus on `\"ISO\"`.\n"
"- ISO: Viikko 1 alkaa maanantaina ennen tammikuun ensimmäistä torstaita.\n"
"- US: Viikko 1 alkaa 1. tammikuuta. Kaikki muut viikot alkavat sunnuntaina.\n"
"- Instance: Viikko 1 alkaa 1. tammikuuta. Kaikki muut viikot alkavat Metabasen lokalisointiasetuksissasi määritettynä viikon aloituspäivänä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`31`) with the number of the day of the month."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`1`–`31`), joka on kuukauden päivän numero."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`7`) with the number of the day of the week. Which day is `1` is defined in your localization settings."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`1`–`7`), joka on viikonpäivän numero. Se, mikä päivä on `1`, määräytyy lokalisointiasetuksiesi mukaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`23`) with the number of the hour. No AM/PM."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`0`–`23`), joka on tunnin numero. Ei AM/PM."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the minute in the hour."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`0`–`59`), joka on minuutin numero tunnissa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the seconds in the minute."
msgstr "Ottaa datetime-arvon ja palauttaa kokonaisluvun (`0`–`59`), joka on sekuntien numero minuutissa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Get the difference between two datetime values (`$datetime2` minus `$datetime1`) using the specified unit of time."
msgstr "Hae erotus kahden datetime-arvon välillä (`$datetime2` miinus `$datetime1`) käyttäen määritettyä aikayksikköä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime1"
msgstr "datetime1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or expression with your datetime value."
msgstr "Sarake tai lauseke, jossa on datetime-arvosi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime2"
msgstr "datetime2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Shipped At"
msgstr "Toimitettu"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, or ${ 7 }."
msgstr "Valitse: {0}, {1}, {2}, {3}, {4}, {5}, {6} tai ${ 7 }."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Adds some units of time to a date or timestamp value."
msgstr "Lisää aikayksiköitä päivämäärä- tai timestamp-arvoon."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column with your date or timestamp values."
msgstr "Sarake, jossa on päivämäärä- tai timestamp-arvosi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "amount"
msgstr "määrä"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be added."
msgstr "Lisättävien yksiköiden määrä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, or {8}."
msgstr "Valitse: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, tai {8}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Subtracts some units of time to a date or timestamp value."
msgstr "Vähentää aikayksiköitä päivämäärä- tai timestamp-arvosta."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be subtracted."
msgstr "Vähennettävien yksiköiden määrä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the current timestamp (in milliseconds)."
msgstr "Palauttaa nykyisen aikaleiman (millisekunteina)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Returns the current timestamp (in milliseconds). Currently {0} in {1}."
msgstr "Palauttaa nykyisen aikaleiman (millisekunteina). Nyt {0} kohteessa {1}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Convert timezone of a date or timestamp column.\n"
"We support tz database time zone names."
msgstr "Muunna päivämäärä- tai aikaleimasarakkeen aikavyöhyke.\n"
"Tuemme tz-tietokannan aikavyöhykkeiden nimiä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/metabot/tools/resources.clj
msgid "target"
msgstr "kohde"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The timezone you want to assign to your column."
msgstr "Aikavyöhyke, jonka haluat asettaa sarakkeellesi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "source"
msgstr "lähde"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The current time zone. Only required for timestamps with no time zone."
msgstr "Nykyinen aikavyöhyke. Tarvitaan vain aikaleimoille, joissa ei ole aikavyöhykettä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the absolute (positive) value of the specified column."
msgstr "Palauttaa annetun sarakkeen itseisarvon (positiivisen)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return absolute (positive) value of."
msgstr "Sarake tai luku, jonka itseisarvo (positiivinen) palautetaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Debt"
msgstr "Velka"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number down."
msgstr "Pyöristää desimaaliluvun alaspäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round down."
msgstr "Sarake tai luku, joka pyöristetään alaspäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
msgid "Price"
msgstr "Hinta"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number up."
msgstr "Pyöristää desimaaliluvun ylöspäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round up."
msgstr "Sarake tai luku, joka pyöristetään ylöspäin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number either up or down to the nearest integer value."
msgstr "Pyöristää desimaaliluvun lähimpään kokonaislukuun (ylös tai alas)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round to nearest integer."
msgstr "Sarake tai luku, joka pyöristetään lähimpään kokonaislukuun."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the square root."
msgstr "Palauttaa neliöjuuren."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return square root value of."
msgstr "Sarake tai luku, josta palautetaan neliöjuuri."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Hypotenuse"
msgstr "Hypotenuusa"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Raises a number to the power of the exponent value."
msgstr "Korottaa luvun eksponentin arvoon."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number raised to the exponent."
msgstr "Sarake tai luku, joka korotetaan eksponenttiin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Length"
msgstr "Pituus"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "exponent"
msgstr "eksponentti"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The value of the exponent."
msgstr "Eksponentin arvo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the base 10 log of the number."
msgstr "Palauttaa luvun 10-kantaisen logaritmin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return the base 10 logarithm value of."
msgstr "Sarake tai luku, jolle palautetaan 10-kantainen logaritmiarvo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns Euler's number, e, raised to the power of the supplied number."
msgstr "Palauttaa Eulerin luvun e korotettuna annetun luvun potenssiin."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return the exponential value of."
msgstr "Sarake tai luku, josta palautetaan eksponenttiarvo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Interest Months"
msgstr "Korkokuukaudet"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date or number column's values to see if they're within the specified range."
msgstr "Tarkistaa, ovatko päivämäärä- tai numerossarakkeen arvot annetun alueen sisällä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date or numeric column that should be within the start and end values."
msgstr "Päivämäärä- tai numerosarake, jonka arvojen tulee olla alku- ja loppuarvojen välillä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "start"
msgstr "alku"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The beginning of the range."
msgstr "Alueen alku."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "end"
msgstr "loppu"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The end of the range."
msgstr "Alueen loppu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is null"
msgstr "Tarkistaa, onko sarake null"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
msgid "Discount"
msgstr "Alennus"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not null"
msgstr "Tarkistaa, ettei sarake ole null"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Looks at the values in each argument in order and returns the first non-null value for each row."
msgstr "Käy argumenttien arvot läpi järjestyksessä ja palauttaa kullekin riville ensimmäisen ei-null-arvon."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or value to return."
msgstr "Palautettava sarake tai arvo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/explorations/components/ExplorationVisualization/ExplorationComments.tsx
#: frontend/src/metabase/rich_text_editing/tiptap/components/CommentsButton.tsx
msgid "Comments"
msgstr "Kommentit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "If `$value1` is empty, `$value2` gets returned if its not empty."
msgstr "Jos `$value1` on tyhjä, palautetaan `$value2`, jos se ei ole tyhjä."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "If `$value1` is empty, and `$value2` is empty, the next non-empty one will be returned."
msgstr "Jos `$value1` on tyhjä ja `$value2` on tyhjä, palautetaan seuraava ei-tyhjä arvo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/comments/components/Comments/Comments.tsx
msgid "No comments"
msgstr "Ei kommentteja"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Alias for `if()`. Tests an expression against a list of cases and returns the corresponding value of the first matching case, with an optional default value if nothing else is met."
msgstr "Alias `if()`-funktiolle. Testaa lausekkeen tapauslistaa vasten ja palauttaa ensimmäisen täsmäävän tapauksen vastaavan arvon sekä valinnaisen oletusarvon, jos mikään muu ei täsmää."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weight"
msgstr "Paino"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "output"
msgstr "tulos"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The value that will be returned if the preceding condition is `true`."
msgstr "Arvo, joka palautetaan, jos edeltävä ehto on `true`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Large"
msgstr "Suuri"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more conditions to test."
msgstr "Voit lisätä lisää testattavia ehtoja."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Alias for `case()`. Tests an expression against a list of cases and returns the corresponding value of the first matching case, with an optional default value if nothing else is met."
msgstr "Alias `case()`-funktiolle. Testaa lausekkeen tapauslistaa vasten ja palauttaa ensimmäisen täsmäävän tapauksen vastaavan arvon sekä valinnaisen oletusarvon, jos mikään muu ei täsmää."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if `value1` equals `$value2` (or `$value3`, etc. if specified)."
msgstr "Palauttaa true, jos `value1` on sama kuin `$value2` (tai `$value3` jne., jos määritetty)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or value to check."
msgstr "Sarake tai arvo, joka tarkistetaan."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
