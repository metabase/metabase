+// RERANK BASED ON VIBES [(prompt)] [ASC|DESC] (vibes patch).  RERANK is not a
+// fallback keyword (a fallback would let "FROM t rerank" take it as an alias);
+// instead the tokenizer only reports TK_RERANK when BASED follows.  The value is a
+// one-term list holding the prompt expression and the direction (default
+// DESC); sqlite3VibesRerankWrap() turns it into ordinary SQL once the whole
+// (possibly compound) select has been parsed.
+//
+%type rerank_opt {ExprList*}
+%destructor rerank_opt {sqlite3ExprListDelete(pParse->db, $$);}
+rerank_opt(A) ::= .                        {A = 0;}
+rerank_opt(A) ::= RERANK BASED ON VIBES sortorder(Z). {
+  A = sqlite3VibesRerankClause(pParse, 0, Z);
+}
+rerank_opt(A) ::= RERANK BASED ON VIBES LP expr(X) RP sortorder(Z). {
+  A = sqlite3VibesRerankClause(pParse, X, Z);
+}
+
 
