{
  "get": {
    "description": "Stream the result of a single completed exploration query. The optional `format` query param\n  is one of `api`, `json`, `csv`, `xlsx` (default `api`). When the underlying query is still\n  pending or has errored, returns a 409 with status info instead of streaming.",
    "operationId": "get-api-exploration-query-id",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "format",
        "required": false,
        "schema": {
          "default": "api",
          "enum": [
            "api",
            "csv",
            "json",
            "xlsx"
          ],
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/metabase.explorations.api.ExplorationQueryStreamResponse.json"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/exploration/query/{id}",
    "tags": [
      "/api/exploration"
    ]
  }
}
