{
  "delete": {
    "description": "Switch back to simple permissions. Removes any custom permissions from all specific groups, keeping only Admins and All Users.",
    "operationId": "delete-api-ee-ai-controls-permissions-advanced",
    "parameters": [],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "advanced": {
                  "type": "boolean"
                },
                "permissions": {
                  "items": {
                    "properties": {
                      "group_id": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "perm_type": {
                        "enum": [
                          "permission/metabot",
                          "permission/metabot-nlq",
                          "permission/metabot-other-tools",
                          "permission/metabot-sql-generation"
                        ],
                        "type": "string"
                      },
                      "perm_value": {
                        "enum": [
                          "yes",
                          "no"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "group_id",
                      "perm_type",
                      "perm_value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "permissions",
                "advanced"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "DELETE /api/ee/ai-controls/permissions/advanced",
    "tags": [
      "/api/ee/ai-controls/permissions"
    ]
  },
  "post": {
