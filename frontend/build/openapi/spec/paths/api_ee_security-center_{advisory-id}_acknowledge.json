{
  "post": {
    "description": "Acknowledge a security advisory. Stops repeat notifications.",
    "operationId": "post-api-ee-security-center-advisory-id-acknowledge",
    "parameters": [
      {
        "in": "path",
        "name": "advisory-id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "acknowledged_at": {
                  "oneOf": [
                    {
                      "format": "date-time",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "acknowledged_by": {
                  "oneOf": [
                    {
                      "properties": {
                        "common_name": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "email": {
                          "description": "value must be a valid email address.",
                          "type": "string"
                        },
                        "id": {
                          "description": "value must be an integer greater than zero.",
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "id",
                        "common_name",
                        "email"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "advisory_id": {
                  "$ref": "../components/schemas/metabase-enterprise.security-center.schema.advisory-id.json"
                },
                "match_status": {
                  "$ref": "../components/schemas/metabase-enterprise.security-center.schema.match-status.json"
                }
              },
              "required": [
                "advisory_id",
                "match_status",
                "acknowledged_by",
                "acknowledged_at"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/ee/security-center/{advisory-id}/acknowledge",
    "tags": [
      "/api/ee/security-center"
    ]
  }
}
