{
  "post": {
    "description": "Update a metric dimension's `display_name`, `description`, `default_temporal_unit`, and/or source\n  column.\n\n  `source` is a `{type, field-id}`; the new column must have the same effective type.",
    "operationId": "post-api-metric-id-dimension-dimension-key",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "dimension-key",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "default_temporal_unit": {
                "minLength": 1,
                "type": "string"
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_name": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "oneOf": [
                  {
                    "properties": {
                      "field-id": {
                        "description": "value must be an integer greater than zero.",
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "field-id"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {},
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/metric/{id}/dimension/{dimension-key}",
    "tags": [
      "/api/metric"
    ]
  }
}
