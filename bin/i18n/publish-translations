#!/usr/bin/env bash

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

checkout="${1:?Usage: publish-translations <checkout>}"
base=$(cat "$checkout/.git/metabase-base")
if [ "$(i18n_commit)" != "$base" ]; then
  echo "The translation pin changed while this update was being prepared. Start a new update." >&2
  exit 1
fi
git -C "$checkout" add -- 'locales/*.po'
if ! git -C "$checkout" diff --cached --quiet; then
  git -C "$checkout" -c core.hooksPath=/dev/null commit -m "Update Metabase translations" >&2
fi
commit=$(git -C "$checkout" rev-parse HEAD)
if [ "$commit" = "$base" ]; then
  echo "Translations are unchanged." >&2
  exit 0
fi
git -C "$checkout" push origin "HEAD:refs/heads/metabase-$commit" >&2
printf '%s\n' "$commit" > "$I18N_PIN"
printf '%s\n' "$commit"
