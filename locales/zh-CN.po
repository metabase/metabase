msgstr "无效的 Azure 模型 {0}。预期格式：<connection>/<family>/<deployment-name>，其中 <family> 必须是以下之一：{1}"

#: metabase/metabot/settings.clj
msgid "Unsupported model {0} for Metabase managed AI. Supported models: {1}"
msgstr "Metabase 托管 AI 不支持模型 {0}。支持的模型：{1}"

#: metabase/metabot/settings.clj
msgid "Metabot provider must be a string, got: {0}"
msgstr "Metabot provider 必须是字符串，实际为：{0}"

