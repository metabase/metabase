msgstr "Взема времеви интервал с определена дължина"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/xrays/automagic_dashboards/names.clj
msgid "number"
msgstr "число"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of interval, where negative values are back in time."
msgstr "Период на интервала, при който отрицателните стойности са назад във времето."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "unit"
msgstr "unit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "Тип интервал като {0}, {1}, {2}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date column's values to see if they're within the relative range."
msgstr "Проверява стойностите на колона за дата дали са в относителния диапазон."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to return interval of."
msgstr "Колоната за дата, за която да се върне интервал."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Created At"
msgstr "Създадено на"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if a column's value falls within an interval, starting from an initial, offsetting interval."
msgstr "Връща true, ако стойността на колона попада в интервал, започващ от начален интервал с отместване."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to check."
msgstr "Колоната с дата, която да се провери."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of the interval, where negative numbers go back in time."
msgstr "Период на интервала, като отрицателните числа връщат назад във времето."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetValue"
msgstr "offsetValue"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The initial interval period to start from, where negative values are back in time."
msgstr "Периодът на началния интервал, от който да се започне, като отрицателните стойности са назад във времето."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetUnit"
msgstr "offsetUnit"

