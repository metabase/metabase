{
  "get": {
    "description": "List conversations visible in the current user's history, most-recent first.\n\n  New conversations are participation-based (the user authored at least one\n  message); legacy conversations created before message authors were stamped\n  fall back to the conversation originator. Optionally filter by the last live\n  message's `profile_id`.",
    "operationId": "get-api-metabot-conversations",
    "parameters": [],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "data": {
                  "items": {
                    "properties": {
                      "conversation_id": {
                        "description": "value must be a valid UUID.",
                        "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                        "type": "string"
                      },
                      "created_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "forked_from_conversation_id": {
                        "oneOf": [
                          {
                            "description": "value must be a valid UUID.",
                            "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "last_message_at": {
                        "oneOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "message_count": {
                        "description": "value must be an integer greater or equal to than zero.",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "profile_id": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "title": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "user_id": {
                        "oneOf": [
                          {
                            "description": "value must be an integer greater than zero.",
                            "minimum": 1,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "conversation_id",
                      "created_at",
                      "title",
                      "user_id",
                      "profile_id",
                      "message_count",
                      "last_message_at",
                      "forked_from_conversation_id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "limit": {
                  "description": "value must be an integer greater or equal to than zero.",
                  "minimum": 0,
                  "type": "integer"
                },
                "offset": {
                  "description": "value must be an integer greater or equal to than zero.",
                  "minimum": 0,
                  "type": "integer"
                },
                "total": {
                  "description": "value must be an integer greater or equal to than zero.",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "data",
                "total",
                "limit",
                "offset"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/metabot/conversations",
    "tags": [
      "/api/metabot/conversations"
    ]
  }
}
