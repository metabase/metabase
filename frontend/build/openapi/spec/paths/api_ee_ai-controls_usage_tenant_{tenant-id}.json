      {
        "in": "path",
        "name": "tenant-id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "max_usage": {
                  "oneOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tenant_id": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "tenant_id",
                "max_usage"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
