msgid_plural "{0} downstream transforms did not run because a transform they depend on failed"
msgstr[0] "{0} последваща трансформация не се изпълни, защото трансформация, от която зависи, се провали"
msgstr[1] "{0} последващи трансформации не се изпълниха, защото трансформация, от която зависят, се провали"

#: metabase/transforms/models/transform_job.clj
msgid "Hourly job"
msgstr "Часов джоб"

#: metabase/transforms/models/transform_job.clj
msgid "Executes transforms tagged with ''hourly'' every hour"
msgstr "Изпълнява трансформации с таг ''hourly'' всеки час"

#: metabase/transforms/models/transform_job.clj
msgid "Executes transforms tagged with ''weekly'' once per week"
msgstr "Изпълнява трансформации с таг ''weekly'' веднъж седмично"

#: metabase/transforms/models/transform_job.clj
msgid "Daily job"
msgstr "Дневен джоб"

