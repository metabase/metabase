msgstr "사용자에게 이 카드를 쿼리할 권한이 없습니다."

#: metabase_enterprise/permission_debug/impl.clj
msgid "User has permission to download data from this card"
msgstr "사용자는 이 카드에서 데이터를 다운로드할 수 있는 권한이 있습니다."

#: metabase_enterprise/permission_debug/impl.clj
