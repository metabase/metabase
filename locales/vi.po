#: metabase/analytics/settings.clj
msgid "Boolean indicating whether analytics events are being sent to Metaplow. True if anonymous tracking is enabled for this instance, and a Metaplow collector URL is set."
msgstr "Giá trị boolean cho biết liệu các sự kiện analytics có đang được gửi tới Metaplow hay không. True nếu theo dõi ẩn danh được bật cho instance này và đã đặt URL collector Metaplow."

#: metabase/analytics/settings.clj
msgid "The URL of the Snowplow collector to send analytics events to."
msgstr "URL của máy thu thập Snowplow để gửi các sự kiện phân tích."

#: metabase/analytics/settings.clj
msgid "Boolean indicating whether analytics events are being sent to Snowplow. True if anonymous tracking is enabled for this instance, and a Snowplow collector is available."
msgstr "Boolean chỉ ra sự kiện phân tích có đang được gửi đến Snowplow hay không. Đúng nếu theo dõi ẩn danh được kích hoạt cho trường hợp này và có người thu thập Snowplow."

#: metabase/analytics/settings.clj
msgid "Enable logging of embed path, query parameters, user agent, IP address, and Metabot conversation metadata for users of your internal data and embeds. This information will be shown in your usage analytics."
msgstr "Bật ghi log đường dẫn nhúng, tham số truy vấn, user agent, địa chỉ IP và metadata cuộc hội thoại Metabot cho người dùng dữ liệu nội bộ và nội dung nhúng của bạn. Thông tin này sẽ được hiển thị trong Phân tích mức sử dụng của bạn."

#: metabase/analytics/settings.clj
msgid "Enable the collection of anonymous usage data in order to help Metabase improve.."
msgstr "Bật việc thu thập dữ liệu sử dụng ẩn danh để giúp Metabase cải thiện.."

#: metabase/analytics/settings.clj
msgid "The URL of the Metaplow collector to send analytics events to."
msgstr "URL của collector Metaplow để gửi các sự kiện analytics tới."

#: metabase/analytics/settings.clj
msgid "The approximate timestamp at which this instance of Metabase was created, for inclusion in analytics."
msgstr "Dấu thời gian xấp xỉ khi phiên bản Metabase này được tạo, để đưa vào phân tích."

#: metabase/analytics/settings.clj
msgid "Whether a non-table chart has already been generated. Required for analytics to track instance activation journey."
msgstr "Việc biểu đồ không phải dạng bảng đã được tạo hay chưa. Bắt buộc để analytics theo dõi hành trình kích hoạt instance."

#: metabase/analytics/settings.clj
msgid "Boolean indicating whether a Snowplow collector is available to receive analytics events. Should be set via environment variable in Cypress tests or during local development."
msgstr "Boolean chỉ ra người thu thập Snowplow có sẵn để nhận sự kiện phân tích hay không. Nên được thiết lập thông qua biến môi trường trong các bài kiểm tra Cypress hoặc trong quá trình phát triển cục bộ."

#: metabase/analytics/settings.clj
msgid "Unique identifier to be used in Snowplow analytics, to identify this instance of Metabase. This is a public setting since some analytics events are sent prior to initial setup."
msgstr "Định danh duy nhất để sử dụng trong phân tích Snowplow, để nhận diện trường hợp Metabase này. Đây là một cài đặt công khai vì một số sự kiện phân tích được gửi trước khi thiết lập ban đầu."

#: metabase/analyze/query_results.clj
msgid "value must be an array of valid results column metadata maps."
msgstr "giá trị phải là một mảng các map metadata cột kết quả hợp lệ."

