msgstr "Thông điệp hiển thị cho người dùng khi họ đạt hạn mức sử dụng."

#: metabase_enterprise/metabot/settings.clj
msgid "Whether the AI feature access admin page shows granular, per-tool group permissions instead of a single on/off toggle per group."
msgstr "Trang quản trị quyền truy cập tính năng AI có hiển thị quyền chi tiết theo từng công cụ cho từng nhóm thay vì chỉ một nút bật/tắt cho mỗi nhóm hay không."

#: metabase_enterprise/metabot/settings.clj
msgid "The unit used for Metabot usage limits: `tokens` or `messages`."
msgstr "Đơn vị dùng cho giới hạn sử dụng Metabot: `tokens` hoặc `messages`."

#: metabase_enterprise/mfa/core.clj
msgid "Failed to send the sign-in code. Please try again or contact your administrator."
msgstr "Không gửi được mã đăng nhập. Vui lòng thử lại hoặc liên hệ quản trị viên của bạn."

#: metabase_enterprise/mfa/management.clj metabase_enterprise/mfa/settings.clj
msgid "Multi-factor authentication"
msgstr "Xác thực đa yếu tố"

#: metabase_enterprise/mfa/management.clj
msgid "Invalid password."
msgstr "Mật khẩu không hợp lệ."

#: metabase_enterprise/mfa/management.clj
msgid "Two-factor authentication is already set up. Disable it before re-enrolling."
msgstr "Xác thực hai yếu tố đã được thiết lập. Hãy tắt trước khi đăng ký lại."

#: metabase_enterprise/mfa/management.clj
msgid "Two-factor authentication is not enabled on this instance."
msgstr "Xác thực hai yếu tố chưa được bật trên phiên bản cài đặt này."

#: metabase_enterprise/mfa/management.clj
msgid "You cannot administratively remove your own two-factor authentication. Please use the normal removal method in your account settings."
msgstr "Bạn không thể gỡ xác thực hai yếu tố của chính mình theo cách quản trị. Vui lòng dùng phương thức gỡ bình thường trong phần cài đặt tài khoản của bạn."

#: metabase_enterprise/mfa/settings.clj
msgid "Controls whether two-factor authentication is available to users. :off disables it entirely; :optional allows users to enroll voluntarily."
msgstr "Kiểm soát việc xác thực hai yếu tố có khả dụng cho người dùng hay không. :off tắt hoàn toàn; :optional cho phép người dùng tự nguyện đăng ký."

#: metabase_enterprise/mfa/settings.clj
msgid "Invalid value for mfa-enforcement: {0}. Allowed values are :off and :optional. (:required is reserved for a future release.)"
msgstr "Giá trị không hợp lệ cho mfa-enforcement: {0}. Các giá trị được phép là :off và :optional. (:required được dành cho một bản phát hành trong tương lai.)"

#: metabase_enterprise/permission_debug/impl.clj
