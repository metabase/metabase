msgstr "Číslo alebo dátum, ktorý sa má konvertovať na text."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string or float column to convert to integers. Float values are rounded."
msgstr "Textový alebo float stĺpec na konverziu na celé čísla. Hodnoty float sa zaokrúhľujú."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string or float column to convert to integers."
msgstr "Textový alebo datetime stĺpec na konverziu na celé čísla."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Converts a datetime or an ISO 8601 datetime string to a date. Time part is truncated."
msgstr "Konvertuje datetime alebo datetime reťazec ISO 8601 na dátum. Časová časť sa odreže."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string or datetime to convert to a date."
msgstr "Reťazec alebo datetime na konverziu na dátum."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Converts a datetime string or bytes to a datetime."
msgstr "Konvertuje datetime reťazec alebo bajty na datetime."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string, bytes, or number to convert to a datetime."
msgstr "Reťazec, bajty alebo číslo na konverziu na datetime."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "mode"
msgstr "mód"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The mode indicating the format. One of: `\"simple\"`, `\"iso\"`, `\"simpleBytes\"`, `\"isoBytes\"`, `\"unixSeconds\"`, `\"unixMilliseconds\"`, `\"unixMicroseconds\"`, `\"unixNanoseconds\"`. Default is `\"iso\"`."
msgstr "Režim určujúci formát. Jedno z: `\"simple\"`, `\"iso\"`, `\"simpleBytes\"`, `\"isoBytes\"`, `\"unixSeconds\"`, `\"unixMilliseconds\"`, `\"unixMicroseconds\"`, `\"unixNanoseconds\"`. Predvolené je `\"iso\"`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the current date."
msgstr "Vracia aktuálny dátum."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Converts a string to a floating-point number."
msgstr "Konvertuje reťazec na číslo s pohyblivou desatinnou čiarkou."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string column to convert to floats."
msgstr "Textový stĺpec na konverziu na floaty."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the string of text in all lower case."
msgstr "Vráti textový reťazec napísaný malými písmenami."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column with values to convert to lower case."
msgstr "Stĺpec s hodnotami na prevod na malé písmená."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the text in all upper case."
msgstr "Vráti text vo veľkých písmenách."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column with values to convert to upper case."
msgstr "Stĺpec s hodnotami, ktoré sa majú previesť na veľké písmená."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Expected positive integer but found {0}"
msgstr "Očakávalo sa kladné celé číslo, ale našlo sa {0}"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns a portion of the supplied text."
msgstr "Vráti časť dodaného textu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to return a portion of."
msgstr "Stĺpec alebo text, z ktorého sa má vrátiť časť."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "position"
msgstr "pozícia"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The position to start copying characters. Index starts at position `1`."
msgstr "Pozícia, od ktorej sa má začať kopírovať znaky. Index začína na pozícii `1`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "length"
msgstr "dĺžka"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of characters to return."
msgstr "Počet znakov, ktoré sa majú vrátiť."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Splits a string on a specified delimiter and returns the nth substring."
msgstr "Rozdelí reťazec podľa zadaného oddeľovača a vráti n-tú podreťazec."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "text"
msgstr "text"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "delimiter"
msgstr "oddeľovač"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The pattern describing where each split should occur."
msgstr "Vzorec opisujúci, kde sa má vykonať každé rozdelenie."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Which substring to return after the split. Index starts at position `1`."
msgstr "Ktorý podreťazec vrátiť po rozdelení. Index začína na pozícii `1`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Applies a collation to a text value for sorting and comparison purposes."
msgstr "Aplikuje koláciu na textovú hodnotu na účely triedenia a porovnávania."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to apply the collation to."
msgstr "Stĺpec alebo text, na ktorý sa má kolácia použiť."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "collation"
msgstr "kolácia"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The collation specification."
msgstr "Špecifikácia kolácie."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "en-ci-ai"
msgstr "en-ci-ai"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts matching substrings according to a regular expression."
msgstr "Extrahuje zodpovedajúce podreťazce podľa regulárneho výrazu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to search through."
msgstr "Stĺpec alebo text, cez ktorý sa má prehľadávať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Address"
msgstr "Adresa"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "regular_expression"
msgstr "regular_expression"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The regular expression to match."
msgstr "Regulárny výraz, ktorý sa má nájsť."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Extracts the pathname from a URL. E.g., `{0}` would return `{1}`."
msgstr "Extrahuje pathname z URL. Napr. `{0}` vráti `{1}`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "url"
msgstr "url"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "A column containing URLs"
msgstr "Stĺpec obsahujúci URL"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Combine two or more strings of text together."
msgstr "Spojte dva alebo viac reťazcov textu dohromady."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "value1"
msgstr "value1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to begin with."
msgstr "Stĺpec alebo text, s ktorým sa má začať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "value2"
msgstr "value2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "This will be added to the end of `$value1`."
msgstr "Toto sa pridá na koniec `$value1`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "This will be added to the end of `$value2`, and so on."
msgstr "Toto sa pridá na koniec `$value2` a tak ďalej."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "First Name"
msgstr "Meno"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Replaces a part of the input text with new text."
msgstr "Nahradí časť vstupného textu novým textom."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "find"
msgstr "nájsť"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The text to find."
msgstr "Text na nájdenie."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Enormous"
msgstr "Obrovský"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "replace"
msgstr "nahradiť"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The text to use as the replacement."
msgstr "Text na použitie ako náhrada."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gigantic"
msgstr "Gigantický"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the number of characters in text."
msgstr "Počet znakov vracia počet znakov v texte."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text you want to get the length of."
msgstr "Stĺpec alebo text, ktorého dĺžku chcete získať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
#: frontend/src/metabase/documents/components/editor-extensions/CardEmbed/CardEmbedMenuDropdown.tsx
msgid "Comment"
msgstr "Komentár"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes leading and trailing whitespace from a string of text."
msgstr "Odstráni úvodné a koncové medzery z textového reťazca."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text you want to trim."
msgstr "Stĺpec alebo text, ktorý chcete orezať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes trailing whitespace from a string of text."
msgstr "Odstráni koncové medzery z textového reťazca."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes leading whitespace from a string of text."
msgstr "Odstráni úvodné medzery z textového reťazca."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the domain name (eg. `\"metabase\"`) from a URL or email"
msgstr "Extrahuje názov domény (napr. `\"metabase\"`) z URL alebo emailu"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "urlOrEmail"
msgstr "urlOrEmail"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract domain names from."
msgstr "Stĺpec URL alebo Email, z ktorého sa majú extrahovať názvy domén."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the first subdomain (eg. `\"status\"` from `\"status.metabase.com\"`, `\"\"` from `\"bbc.co.uk\"`) from a URL. Ignores `\"www\"`."
msgstr "Extrahuje prvú subdoménu (napr. `\"status\"` z `\"status.metabase.com\"`, `\"\"` z `\"bbc.co.uk\"`) z URL. Ignoruje `\"www\"`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL column to extract the subdomain from."
msgstr "Stĺpec URL, z ktorého sa má extrahovať subdoména."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "ProfileImage"
msgstr "ProfileImage"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the host (domain name and TLD, eg. `\"metabase.com\"` from `\"status.metabase.com\"`) from a URL or email"
msgstr "Extrahuje host (názov domény a TLD, napr. `\"metabase.com\"` z `\"status.metabase.com\"`) z URL alebo emailu"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract the host from."
msgstr "Stĺpec URL alebo Email, z ktorého sa má extrahovať host."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` contains `$string2` within it (or `$string3`, etc. if specified)."
msgstr "Vracia `true`, ak `$string1` obsahuje `$string2` (alebo `$string3` atď., ak je uvedené)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string1"
msgstr "string1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to check."
msgstr "Stĺpec alebo text na kontrolu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string2"
msgstr "string2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string of text to look for."
msgstr "Textový reťazec, ktorý sa má hľadať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Small"
msgstr "Malé"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more values to look for."
msgstr "Môžete pridať ďalšie hodnoty na vyhľadanie."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. Set to `\"case-insensitive\"` to perform a case-insensitive match."
msgstr "Voliteľné. Nastavte na `\"case-insensitive\"` pre porovnanie bez rozlišovania veľkosti písmen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` does not contain `$string2` within it (and `$string3`, etc. if specified)."
msgstr "Vracia `true`, ak `$string1` neobsahuje `$string2` (a `$string3` atď., ak je uvedené)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the beginning of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Vracia true, ak sa začiatok `$string1` zhoduje s `$string2` (alebo `$string3` atď., ak je uvedené)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the end of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Vracia true, ak sa koniec `$string1` zhoduje s `$string2` (alebo `$string3` atď., ak je uvedené)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is empty"
msgstr "Kontrolovať, či je stĺpec prázdny"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column to check."
msgstr "Stĺpec na kontrolu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not empty"
msgstr "Kontroluje, či stĺpec nie je prázdny"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized short name (eg. `\"Apr\"`) for the given month number (eg. `4`)"
msgstr "Vracia lokalizovaný krátky názov (napr. `\"Apr\"`) pre zadané číslo mesiaca (napr. `4`)"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "monthNumber"
msgstr "monthNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a month in the year, `1` to `12`."
msgstr "Stĺpec alebo výraz udávajúci číslo mesiaca v roku, `1` až `12`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Birthday Month"
msgstr "Mesiac narodenia"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns a string like `\"Q1\"`, given the quarter number"
msgstr "Vracia reťazec ako `\"Q1\"` pre zadané číslo štvrťroka"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "quarterNumber"
msgstr "quarterNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a quarter of the year, `1` to `4`."
msgstr "Stĺpec alebo výraz udávajúci číslo štvrťroka roka, `1` až `4`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Fiscal Quarter"
msgstr "Fiškálny štvrťrok"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized name of a day of the week, given the day's number."
msgstr "Vráti lokalizovaný názov dňa v týždni na základe čísla dňa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "dayNumber"
msgstr "dayNumber"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a day of the week, `1` to `7`. Which day is `1` is defined in your localization setting; default Sunday."
msgstr "Stĺpec alebo výraz udávajúci číslo dňa v týždni, `1` až `7`. Ktorý deň je `1`, je definované vo vašom nastavení lokalizácie; predvolene nedeľa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weekday"
msgstr "Deň v týždni"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a time interval of specified length"
msgstr "Získa časový interval určitej dĺžky"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/xrays/automagic_dashboards/names.clj
msgid "number"
msgstr "číslo"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of interval, where negative values are back in time."
msgstr "Obdobie intervalu, kde majú záporné hodnoty význam návratu do minulosti."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "unit"
msgstr "jednotka"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "Typ intervalu, napríklad {0}, {1}, {2}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date column's values to see if they're within the relative range."
msgstr "Skontroluje hodnoty dátového stĺpca, aby sa zistilo, či sú v relatívnom rozsahu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to return interval of."
msgstr "Dátumový stĺpec, z ktorého sa má vrátiť interval."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Created At"
msgstr "Vytvorené dňa"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if a column's value falls within an interval, starting from an initial, offsetting interval."
msgstr "Vracia true, ak hodnota stĺpca spadá do intervalu, ktorý začína od počiatočného posunutého intervalu."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to check."
msgstr "Dátumový stĺpec, ktorý sa má skontrolovať."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of the interval, where negative numbers go back in time."
msgstr "Dĺžka intervalu, kde záporné čísla idú späť v čase."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetValue"
msgstr "offsetValue"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The initial interval period to start from, where negative values are back in time."
msgstr "Počiatočná dĺžka intervalu, od ktorej sa má začať, kde záporné hodnoty znamenajú späť v čase."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetUnit"
msgstr "offsetUnit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a timestamp relative to the current time"
msgstr "Získa časovú pečiatku vo vzťahu k súčasnému času"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer with the number of the year."
msgstr "Prijíma dátum a čas a vracia celé číslo s číslom roka."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The datetime column."
msgstr "Stĺpec dátum a čas."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`4`) with the number of the quarter in the year."
msgstr "Prijme datetime a vráti celé číslo (`1`-`4`) s číslom štvrťroka v roku."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`12`) with the number of the month in the year."
msgstr "Prijme datetime a vráti celé číslo (`1`-`12`) s číslom mesiaca v roku."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the week of the year as an integer."
msgstr "Extrahuje týždeň v roku ako celé číslo."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The name of the column with your date or datetime value."
msgstr "Názov stĺpca s vašou hodnotou dátumu alebo dátumu a času."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. The default is `\"ISO\"`.\n"
"- ISO: Week 1 starts on the Monday before the first Thursday of January.\n"
"- US: Week 1 starts on Jan 1. All other weeks start on Sunday.\n"
"- Instance: Week 1 starts on Jan 1. All other weeks start on the day defined in your Metabase localization settings."
msgstr "Voliteľné. Predvolené je `\"ISO\"`.\n"
"- ISO: Týždeň 1 sa začína v pondelok pred prvým štvrtkom v januári.\n"
"- US: Týždeň 1 sa začína 1. januára. Všetky ostatné týždne sa začínajú v nedeľu.\n"
"- Inštancia: Týždeň 1 sa začína 1. januára. Všetky ostatné týždne sa začínajú v deň definovaný vo vašich lokalizačných nastaveniach Metabase."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`31`) with the number of the day of the month."
msgstr "Prijme datetime a vráti celé číslo (`1`-`31`) s číslom dňa v mesiaci."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`7`) with the number of the day of the week. Which day is `1` is defined in your localization settings."
msgstr "Prijme datetime a vráti celé číslo (`1`-`7`) s číslom dňa v týždni. Ktorý deň je `1`, je definované vo vašich lokalizačných nastaveniach."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`23`) with the number of the hour. No AM/PM."
