msgstr "Da li automatski uvoziti iz udaljenog git repozitorijuma. Važi samo ako je remote-sync-type :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Ako je remote-sync-type :read-only i remote-sync-auto-import je true, učestalost (u minutima) provere ažuriranja za uvoz. Podrazumevano je 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The maximum amount of time a remote sync task will be given to complete"
msgstr "Maksimalno vreme koje će udaljeni sync zadatak imati da se završi"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Mrežni timeout (u sekundama) za udaljene git operacije kao što su fetch, push, clone i ls-remote. Veza koja je zastala bi u suprotnom mogla da blokira sinhronizaciju neograničeno."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Da li sinhronizovati transformacije putem remote-sync. Kada je omogućeno, sve transformacije, oznake transformacija i poslovi transformacija sinhronizuju se kao jedna celina (sve-ili-ništa)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live u sekundama za keš provere udaljenih promena. Podrazumevano je 60 sekundi."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Allow specific remote sync behaviors. Set to overwrite-unpublished to allow overwriting unpublished changes on startup."
msgstr "Dozvoli specifična ponašanja udaljene sinhronizacije. Postavite na overwrite-unpublished da biste dozvolili prepisivanje neobjavljenih promena pri pokretanju."

