msgstr "Fjerner innledende og avsluttende blanktegn fra en tekststreng."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text you want to trim."
msgstr "Kolonnen eller teksten du vil trimme."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes trailing whitespace from a string of text."
msgstr "Fjerner avsluttende blanktegn fra en tekststreng."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Removes leading whitespace from a string of text."
msgstr "Fjerner innledende blanktegn fra en tekststreng."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the domain name (eg. `\"metabase\"`) from a URL or email"
msgstr "Henter ut domenenavnet (f.eks. `\"metabase\"`) fra en URL eller e-post"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "urlOrEmail"
msgstr "urlEllerEpost"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract domain names from."
msgstr "URL- eller e-postkolonnen det skal hentes ut domenenavn fra."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the first subdomain (eg. `\"status\"` from `\"status.metabase.com\"`, `\"\"` from `\"bbc.co.uk\"`) from a URL. Ignores `\"www\"`."
msgstr "Henter ut det første subdomenet (f.eks. `\"status\"` fra `\"status.metabase.com\"`, `\"\"` fra `\"bbc.co.uk\"`) fra en URL. Ignorerer `\"www\"`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL column to extract the subdomain from."
msgstr "URL-kolonnen det skal hentes ut subdomene fra."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "ProfileImage"
msgstr "ProfileImage"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the host (domain name and TLD, eg. `\"metabase.com\"` from `\"status.metabase.com\"`) from a URL or email"
msgstr "Henter ut verten (domenenavn og TLD, f.eks. `\"metabase.com\"` fra `\"status.metabase.com\"`) fra en URL eller e-post"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The URL or Email column to extract the host from."
msgstr "URL- eller e-postkolonnen det skal hentes ut vert fra."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` contains `$string2` within it (or `$string3`, etc. if specified)."
msgstr "Returnerer `true` hvis `$string1` inneholder `$string2` i seg (eller `$string3`, osv. hvis angitt)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string1"
msgstr "streng1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to check."
msgstr "Kolonnen eller teksten som skal sjekkes."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string2"
msgstr "streng2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string of text to look for."
msgstr "Tekststrengen det skal letes etter."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Small"
msgstr "Liten"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more values to look for."
msgstr "Du kan legge til flere verdier å lete etter."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. Set to `\"case-insensitive\"` to perform a case-insensitive match."
msgstr "Valgfritt. Sett til `\"case-insensitive\"` for å utføre et match uten hensyn til store/små bokstaver."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns `true` if `$string1` does not contain `$string2` within it (and `$string3`, etc. if specified)."
msgstr "Returnerer `true` hvis `$string1` ikke inneholder `$string2` i seg (og `$string3`, osv. hvis angitt)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the beginning of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Returnerer true hvis begynnelsen av `$string1` matcher `$string2` (eller `$string3`, osv. hvis angitt)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if the end of the `$string1` matches the `$string2` (or `$string3`, etc. if specified)."
msgstr "Returnerer true hvis slutten av `$string1` matcher `$string2` (eller `$string3`, osv. hvis angitt)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is empty"
msgstr "Sjekker om en kolonne er tom"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column to check."
msgstr "Kolonnen som skal sjekkes."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not empty"
msgstr "Sjekker om en kolonne ikke er tom"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized short name (eg. `\"Apr\"`) for the given month number (eg. `4`)"
msgstr "Returnerer det lokaliserte korte navnet (f.eks. `\"Apr\"`) for det gitte månedsnummeret (f.eks. `4`)"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "monthNumber"
msgstr "månedsnummer"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a month in the year, `1` to `12`."
msgstr "Kolonne eller uttrykk som gir nummeret på en måned i året, `1` til `12`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Birthday Month"
msgstr "Bursdagsmåned"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns a string like `\"Q1\"`, given the quarter number"
msgstr "Returnerer en streng som `\"Q1\"`, gitt kvartalnummeret"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "quarterNumber"
msgstr "kvartalsnummer"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a quarter of the year, `1` to `4`."
msgstr "Kolonne eller uttrykk som gir nummeret på et kvartal i året, `1` til `4`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Fiscal Quarter"
msgstr "Regnskapskvartal"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the localized name of a day of the week, given the day's number."
msgstr "Returnerer det lokaliserte navnet på en ukedag, gitt dagens nummer."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "dayNumber"
msgstr "dagsnummer"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Column or expression giving the number of a day of the week, `1` to `7`. Which day is `1` is defined in your localization setting; default Sunday."
msgstr "Kolonne eller uttrykk som gir nummeret på en ukedag, `1` til `7`. Hvilken dag som er `1` er definert i lokaliseringsinnstillingen din; standard søndag."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weekday"
msgstr "Ukedag"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a time interval of specified length"
msgstr "Henter et tidsintervall med angitt lengde"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/xrays/automagic_dashboards/names.clj
msgid "number"
msgstr "tall"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of interval, where negative values are back in time."
msgstr "Lengde på intervallet, der negative verdier er bakover i tid."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "unit"
msgstr "enhet"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Type of interval like {0}, {1}, {2}."
msgstr "Type intervall som {0}, {1}, {2}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date column's values to see if they're within the relative range."
msgstr "Sjekker verdiene i en datokolonne for å se om de er innenfor det relative området."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to return interval of."
msgstr "Datokolonnen som det skal returneres intervall for."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Created At"
msgstr "Opprettet"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns true if a column's value falls within an interval, starting from an initial, offsetting interval."
msgstr "Returnerer true hvis en kolonnes verdi faller innenfor et intervall, som starter fra et innledende offset-intervall."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date column to check."
msgstr "Datokolonnen som skal sjekkes."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Period of the interval, where negative numbers go back in time."
msgstr "Periode for intervallet, der negative tall går tilbake i tid."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetValue"
msgstr "offsetValue"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The initial interval period to start from, where negative values are back in time."
msgstr "Den innledende intervallperioden å starte fra, der negative verdier er tilbake i tid."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "offsetUnit"
msgstr "offsetUnit"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gets a timestamp relative to the current time"
msgstr "Henter et tidsstempel relativt til gjeldende tid"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer with the number of the year."
msgstr "Tar en datotid og returnerer et heltall med årstallet."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The datetime column."
msgstr "Datotid-kolonnen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`4`) with the number of the quarter in the year."
msgstr "Tar en datetime og returnerer et heltall (`1`-`4`) med nummeret på kvartalet i året."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`12`) with the number of the month in the year."
msgstr "Tar en datetime og returnerer et heltall (`1`-`12`) med nummeret på måneden i året."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Extracts the week of the year as an integer."
msgstr "Uthenter ukedagen i året som et heltall."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The name of the column with your date or datetime value."
msgstr "Navnet på kolonnen med dine dato- eller datetime-verdier."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. The default is `\"ISO\"`.\n"
"- ISO: Week 1 starts on the Monday before the first Thursday of January.\n"
"- US: Week 1 starts on Jan 1. All other weeks start on Sunday.\n"
"- Instance: Week 1 starts on Jan 1. All other weeks start on the day defined in your Metabase localization settings."
msgstr "Valgfritt. Standard er `\"ISO\"`.\n"
"- ISO: Uke 1 starter på mandagen før første torsdag i januar.\n"
"- US: Uke 1 starter 1. jan. Alle andre uker starter på søndag.\n"
"- Instance: Uke 1 starter 1. jan. Alle andre uker starter på dagen som er definert i Metabase-lokaliseringsinnstillingene dine."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`31`) with the number of the day of the month."
msgstr "Tar en datetime og returnerer et heltall (`1`-`31`) med nummeret på dagen i måneden."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`1`-`7`) with the number of the day of the week. Which day is `1` is defined in your localization settings."
msgstr "Tar en datetime og returnerer et heltall (`1`-`7`) med nummeret på ukedagen. Hvilken dag som er `1` er definert i lokaliseringsinnstillingene dine."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`23`) with the number of the hour. No AM/PM."
msgstr "Tar en datetime og returnerer et heltall (`0`-`23`) med nummeret på timen. Ingen AM/PM."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the minute in the hour."
msgstr "Tar en datetime og returnerer et heltall (`0`-`59`) med antall minutter i timen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Takes a datetime and returns an integer (`0`-`59`) with the number of the seconds in the minute."
msgstr "Tar en datetime og returnerer et heltall (`0`-`59`) med antall sekunder i minuttet."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Get the difference between two datetime values (`$datetime2` minus `$datetime1`) using the specified unit of time."
msgstr "Få differansen mellom to datetime-verdier (`$datetime2` minus `$datetime1`) ved å bruke den angitte tidsenheten."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime1"
msgstr "datetime1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or expression with your datetime value."
msgstr "Kolonnen eller uttrykket med datotid-verdien din."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "datetime2"
msgstr "datetime2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Shipped At"
msgstr "Sendt"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, or ${ 7 }."
msgstr "Velg blant: {0}, {1}, {2}, {3}, {4}, {5}, {6}, eller ${ 7 }."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Adds some units of time to a date or timestamp value."
msgstr "Legger til noen tidsenheter i en dato- eller tidsstempelverdi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column with your date or timestamp values."
msgstr "Kolonnen med dato- eller tidsstempelverdiene dine."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "amount"
msgstr "antall"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be added."
msgstr "Antall enheter som skal legges til."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, or {8}."
msgstr "Velg mellom: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, eller {8}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Subtracts some units of time to a date or timestamp value."
msgstr "Trekker fra noen tidsenheter fra en dato- eller tidsstempelverdi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The number of units to be subtracted."
msgstr "Antall enheter som skal trekkes fra."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the current timestamp (in milliseconds)."
msgstr "Returnerer nåværende tidsstempel (i millisekunder)."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Returns the current timestamp (in milliseconds). Currently {0} in {1}."
msgstr "Returnerer nåværende tidsstempel (i millisekunder). Nå {0} i {1}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Convert timezone of a date or timestamp column.\n"
"We support tz database time zone names."
msgstr "Konverter tidssone for en dato- eller tidsstempelkolonne.\n"
"Vi støtter tidssonenavn fra tz-databasen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: metabase/metabot/tools/resources.clj
msgid "target"
msgstr "mål"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The timezone you want to assign to your column."
msgstr "Tidssonen du vil tilordne kolonnen din."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "source"
msgstr "kilde"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The current time zone. Only required for timestamps with no time zone."
msgstr "Gjeldende tidssone. Kun nødvendig for tidsstempler uten tidssone."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the absolute (positive) value of the specified column."
msgstr "Returnerer den absolutte (positive) verdien av den angitte kolonnen."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return absolute (positive) value of."
msgstr "Kolonnen eller tallet som det skal returneres absolutt (positiv) verdi av."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Debt"
msgstr "Gjeld"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number down."
msgstr "Avrunder et desimaltall ned."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round down."
msgstr "Kolonnen eller tallet som skal avrundes ned."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
msgid "Price"
msgstr "Pris"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number up."
msgstr "Avrunder et desimaltall opp."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round up."
msgstr "Kolonnen eller tallet som skal avrundes opp."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Rounds a decimal number either up or down to the nearest integer value."
msgstr "Avrunder et desimaltall enten opp eller ned til nærmeste heltallsverdi."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to round to nearest integer."
msgstr "Kolonnen eller tallet som skal avrundes til nærmeste heltall."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the square root."
msgstr "Returnerer kvadratroten."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return square root value of."
msgstr "Kolonnen eller tallet som det skal returneres kvadratrotsverdi av."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Hypotenuse"
msgstr "Hypotenus"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Raises a number to the power of the exponent value."
msgstr "Opphøyer et tall til eksponentverdien."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number raised to the exponent."
msgstr "Kolonnen eller tallet som opphøyes til eksponenten."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Length"
msgstr "Lengde"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "exponent"
msgstr "eksponent"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The value of the exponent."
msgstr "Verdien til eksponenten."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the base 10 log of the number."
msgstr "Returnerer tierlogaritmen (base 10) til tallet."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return the base 10 logarithm value of."
msgstr "Kolonnen eller tallet du vil returnere 10-logaritmen til."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns Euler's number, e, raised to the power of the supplied number."
msgstr "Returnerer Eulers tall, e, opphøyd i den angitte verdien."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or number to return the exponential value of."
msgstr "Kolonnen eller tallet som det skal returneres eksponentialverdi av."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Interest Months"
msgstr "Rentemåneder"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks a date or number column's values to see if they're within the specified range."
msgstr "Sjekker verdiene i en dato- eller tallkolonne for å se om de er innenfor det angitte området."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The date or numeric column that should be within the start and end values."
msgstr "Dato- eller tallkolonnen som skal være mellom start- og sluttverdiene."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "start"
msgstr "start"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The beginning of the range."
msgstr "Begynnelsen av området."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "end"
msgstr "slutt"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The end of the range."
msgstr "Slutten av området."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is null"
msgstr "Sjekker om en kolonne er null"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/common/utils/fields.ts
msgid "Discount"
msgstr "Rabatt"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Checks if a column is not null"
msgstr "Sjekker om en kolonne ikke er null"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Looks at the values in each argument in order and returns the first non-null value for each row."
msgstr "Ser på verdiene i hvert argument i rekkefølge og returnerer den første ikke-null-verdien for hver rad."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or value to return."
msgstr "Kolonnen eller verdien som skal returneres."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/explorations/components/ExplorationVisualization/ExplorationComments.tsx
#: frontend/src/metabase/rich_text_editing/tiptap/components/CommentsButton.tsx
msgid "Comments"
msgstr "Kommentarer"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "If `$value1` is empty, `$value2` gets returned if its not empty."
msgstr "Hvis `$value1` er tom, returneres `$value2` hvis den ikke er tom."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "If `$value1` is empty, and `$value2` is empty, the next non-empty one will be returned."
msgstr "Hvis `$value1` er tom, og `$value2` er tom, blir den neste ikke-tomme returnert."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#: frontend/src/metabase/comments/components/Comments/Comments.tsx
msgid "No comments"
msgstr "Ingen kommentarer"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Alias for `if()`. Tests an expression against a list of cases and returns the corresponding value of the first matching case, with an optional default value if nothing else is met."
msgstr "Alias for `if()`. Tester et uttrykk mot en liste med case og returnerer den tilsvarende verdien for det første matchende caset, med en valgfri standardverdi hvis ingenting annet oppfylles."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Weight"
msgstr "Vekt"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "output"
msgstr "utdata"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The value that will be returned if the preceding condition is `true`."
msgstr "Verdien som returneres hvis den foregående betingelsen er `true`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Large"
msgstr "Stor"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more conditions to test."
msgstr "Du kan legge til flere betingelser å teste."

