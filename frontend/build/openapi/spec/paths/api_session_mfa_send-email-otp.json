{
  "post": {
    "description": "Email a one-time code as a fallback second factor (for a user who lost their authenticator but\n  still has recovery codes disabled or unavailable). Requires a valid challenge token from\n  `POST /api/session`; the code is single-use with a 10-minute expiry and is accepted by\n  `POST /mfa/verify` like any other code.",
    "operationId": "post-api-session-mfa-send-email-otp",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "challenge_token": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "challenge_token"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "success": {
                  "const": true
                }
              },
              "required": [
                "success"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/session/mfa/send-email-otp",
    "tags": [
      "/api/session"
    ]
  }
}
