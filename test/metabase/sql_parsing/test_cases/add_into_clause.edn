{:cases
 [{:name       "a SELECT gets the INTO table, and each base table is read through a self-UNION"
   :dialect    "tsql"
   :sql        "SELECT id, name FROM users WHERE active = 1"
   :table-name "#tmp_results"
   :expected   "SELECT id, name INTO [#tmp_results] FROM (SELECT * FROM users UNION ALL SELECT * FROM users WHERE 1 = 0) AS users WHERE active = 1"}

  {:name       "a UNION is not a SELECT, so it fails"
   :dialect    "tsql"
   :sql        "SELECT id FROM a UNION ALL SELECT id FROM b"
   :table-name "#tmp_all"
   :error      "ValueError: SQL must be a SELECT statement"}]}
