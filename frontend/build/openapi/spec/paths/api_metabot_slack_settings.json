                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "slack-connect-client-id": {
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "slack-connect-client-secret": {
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
