msgstr "Truy vấn {0} không phải là truy vấn SQL"

#: metabase/metabot/tools/sql/edit.clj
msgid "Text to replace found multiple times: {0}"
msgstr "Văn bản để thay thế được tìm thấy nhiều lần: {0}"

#: metabase/metabot/usage.clj
msgid "You''ve used all of your included AI service tokens. To keep using AI features, end your trial early and start your subscription, or add your own AI provider API key."
msgstr "Bạn đã dùng hết tất cả token dịch vụ AI được bao gồm. Để tiếp tục dùng các tính năng AI, hãy kết thúc sớm giai đoạn dùng thử và bắt đầu gói đăng ký, hoặc thêm khóa API của nhà cung cấp AI của riêng bạn."

#: metabase/metrics/core.clj
msgid "Cannot set an orphaned dimension as the default."
msgstr "Không thể đặt một chiều dữ liệu mồ côi làm mặc định."

#: metabase/metrics/core.clj
msgid "Cannot change a dimension''s source column to one of a different type."
msgstr "Không thể đổi cột nguồn của một chiều dữ liệu sang cột có kiểu khác."

#: metabase/metrics/core.clj
msgid "Source column is not available for this metric."
msgstr "Cột nguồn không khả dụng cho chỉ số này."

#: metabase/metrics/core.clj
msgid "{0} is not a temporal unit this dimension can be bucketed by."
msgstr "{0} không phải là đơn vị thời gian mà chiều dữ liệu này có thể phân nhóm theo khoảng."

#: metabase/metrics/core.clj
msgid "Dimension not found."
msgstr "Không tìm thấy chiều dữ liệu."

#: metabase/model_persistence/api.clj
msgid "Database does not support persisting"
msgstr "Cơ sở dữ liệu không hỗ trợ lưu trữ liên tục"

#: metabase/model_persistence/api.clj
msgid "Card is not a model"
msgstr "Thẻ không phải là một mô hình"

#: metabase/model_persistence/api.clj
msgid "String representing a cron schedule"
msgstr "Chuỗi ký tự đại diện cho lịch biểu cron"

#: metabase/model_persistence/api.clj
msgid "Must be a valid cron string not specifying a year"
msgstr "Phải là chuỗi cron hợp lệ không chỉ định năm"

#: metabase/model_persistence/api.clj
msgid "Value must be a string representing a cron schedule of format <seconds> <minutes> <hours> <day of month> <month> <day of week> <year>"
msgstr "Giá trị phải là một chuỗi đại diện cho lịch trình cron với định dạng <giây> <phút> <giờ> <ngày trong tháng> <tháng> <ngày trong tuần> <năm>"

#: metabase/model_persistence/api.clj
msgid "Cannot refresh an archived model"
msgstr "Không thể làm mới mô hình đã lưu trữ"

#: metabase/model_persistence/api.clj
msgid "Cannot refresh a non-model question"
msgstr "Không thể làm mới một câu hỏi không phải là mô hình"

#: metabase/model_persistence/api.clj
msgid "Persisting models is not enabled."
msgstr "Mô hình lưu trữ không được kích hoạt."

#: metabase/model_persistence/api.clj
msgid "Granular cache controls"
msgstr "Điều khiển cache chi tiết"

#: metabase/model_persistence/api.clj
msgid "Persisting models not enabled for database"
msgstr "Mô hình lưu trữ không được kích hoạt cho cơ sở dữ liệu"

#: metabase/model_persistence/settings.clj
msgid "cron syntax string to schedule refreshing persisted models."
msgstr "Chuỗi cú pháp cron để lập lịch làm mới các mô hình lưu trữ."

#: metabase/model_persistence/settings.clj
msgid "Allow persisting models into the source database."
msgstr "Cho phép duy trì mô hình vào cơ sở dữ liệu nguồn."

#: metabase/model_persistence/settings.clj
msgid "Whether to enable models persistence for a specific Database."
msgstr "Có bật lưu kết quả mô hình cho một Database cụ thể hay không."

#: metabase/models/humanization.clj
msgid "Invalid humanization strategy ''{0}''. Valid strategies are: {1}"
msgstr "Chiến lược humanization ''{0}'' không hợp lệ. Các chiến lược hợp lệ là: {1}"

#: metabase/models/humanization.clj
msgid "To make table and field names more human-friendly, Metabase will replace dashes and underscores in them with spaces. We’ll capitalize each word while at it, so ‘last_visited_at’ will become ‘Last Visited At’."
msgstr "Để làm cho tên bảng và tên trường thân thiện hơn với người dùng, Metabase sẽ thay thế dấu gạch ngang và gạch dưới bởi dấu cách. Chúng tôi sẽ viết hoa từng từ, ví dụ: 'last_visited_at' sẽ trở thành 'Last Visited At'."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question / model {0} belongs to database {1}, but this query targets database {2}. Cross-database queries are not supported."
msgstr "Câu hỏi / mô hình đã lưu {0} thuộc về cơ sở dữ liệu {1}, nhưng truy vấn này nhắm tới cơ sở dữ liệu {2}. Không hỗ trợ truy vấn cross-database."

#: metabase/models/serialization/resolve/mp.clj
msgid "No table with id {0} in metadata provider."
msgstr "Không có bảng với id {0} trong metadata provider."

#: metabase/models/serialization/resolve/mp.clj
msgid "No table found matching portable FK {0}. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and schemas, then retry with an exact portable FK from the response."
msgstr "Không tìm thấy bảng nào khớp với FK portable {0}. Hãy gọi `read_resource` với `metabase://database/<numeric id>/tables` để liệt kê các bảng và schema khả dụng, rồi thử lại với một FK portable chính xác từ phản hồi."

#: metabase/models/serialization/resolve/mp.clj
msgid "No field with id {0} in metadata provider."
msgstr "Không có field với id {0} trong metadata provider."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable field FK {0} must have at least 4 elements."
msgstr "FK field portable {0} phải có ít nhất 4 phần tử."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure {0} belongs to a table in a different database than this query (target database id {1}). Cross-database queries are not supported."
msgstr "Chỉ số {0} thuộc về một bảng ở cơ sở dữ liệu khác với truy vấn này (id cơ sở dữ liệu đích {1}). Không hỗ trợ truy vấn cross-database."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous column {0} on table {1}.{2}.{3}."
msgstr "Cột {0} trên bảng {1}.{2}.{3} bị nhập nhằng."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous portable table FK {0}: {1} candidates. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and retry with a more specific portable FK."
msgstr "FK portable của bảng không rõ ràng {0}: {1} ứng viên. Hãy gọi `read_resource` với `metabase://database/<numeric id>/tables` để liệt kê các bảng khả dụng và thử lại với một FK portable cụ thể hơn."

#: metabase/models/serialization/resolve/mp.clj
msgid "Segment id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Phân khúc id {0} không có entity_id, nên không thể export dưới dạng biểu diễn portable."

#: metabase/models/serialization/resolve/mp.clj
msgid "No column {0} on table {1}.{2}.{3}. Call `read_resource` with `metabase://table/<numeric id>/fields` to list this table''s columns."
msgstr "Không có cột {0} trên bảng {1}.{2}.{3}. Hãy gọi `read_resource` với `metabase://table/<numeric id>/fields` để liệt kê các cột của bảng này."

#: metabase/models/serialization/resolve/mp.clj
