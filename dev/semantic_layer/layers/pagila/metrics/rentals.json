{
  "name": "Rentals",
  "description": "Number of rentals, by month rented.",
  "type": "metric",
  "display": "line",
  "collection_id": "{{c:metrics}}",
  "visualization_settings": {},
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": "{{db}}",
    "stages": [
      {
        "lib/type": "mbql.stage/mbql",
        "source-table": "{{t:rentals}}",
        "aggregation": [
          [
            "count",
            {}
          ]
        ],
        "breakout": [
          [
            "field",
            {
              "temporal-unit": "month"
            },
            "{{f:rentals.rental_date}}"
          ]
        ]
      }
    ]
  }
}
