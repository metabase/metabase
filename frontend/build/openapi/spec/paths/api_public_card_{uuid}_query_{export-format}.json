{
  "get": {
    "description": "Fetch a publicly-accessible Card and return query results in the specified format. Does not require auth\n  credentials. Public sharing must be enabled.",
    "operationId": "get-api-public-card-uuid-query-export-format",
    "parameters": [
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "uuid",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      },
      {
        "in": "path",
        "name": "export-format",
        "required": true,
        "schema": {
          "$ref": "../components/schemas/metabase.query-processor.schema.export-format.json"
        }
      },
      {
        "in": "query",
        "name": "format_rows",
        "required": false,
        "schema": {
          "default": false,
          "type": "boolean"
        }
      },
      {
        "in": "query",
        "name": "pivot_results",
        "required": false,
        "schema": {
          "default": false,
          "type": "boolean"
        }
      },
      {
        "in": "query",
        "name": "parameters",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "$ref": "../components/schemas/metabase.parameters.schema..api.parameter-values.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "csv_include_bom",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    ],
    "responses": {
      "2XX": {
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/public/card/{uuid}/query/{export-format}",
    "tags": [
      "/api/public"
    ]
  }
}
