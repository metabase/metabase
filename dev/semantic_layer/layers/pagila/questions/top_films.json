{
  "name": "Top 10 films by revenue",
  "description": "The ten films that have earned the most.",
  "type": "question",
  "display": "row",
  "collection_id": "{{c:pagila}}",
  "visualization_settings": {
    "graph.dimensions": [
      "title"
    ],
    "graph.metrics": [
      "revenue"
    ]
  },
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": "{{db}}",
    "stages": [
      {
        "lib/type": "mbql.stage/mbql",
        "source-table": "{{t:films}}",
        "fields": [
          [
            "field",
            {},
            "{{f:films.title}}"
          ],
          [
            "field",
            {},
            "{{f:films.revenue}}"
          ],
          [
            "field",
            {},
            "{{f:films.rental_count}}"
          ]
        ],
        "order-by": [
          [
            "desc",
            {},
            [
              "field",
              {},
              "{{f:films.revenue}}"
            ]
          ]
        ],
        "limit": 10
      }
    ]
  }
}
