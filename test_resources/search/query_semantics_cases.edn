  :query "the"
  :docs {:A {:name "the"}
         :B {:name "theater"}
         :C {:name "other"}
         :D {:name "widget"}}
  :expect {:in-place [:A :B :C]
           :appdb-h2 [:A :B :C]
           :appdb-postgres []
           :keyword []
           :vector []
           :semantic []}}
