msgstr "Aby boli názvy tabuliek a polí pre používateľov priateľskejšie, Metabase nahradí pomlčky a podčiarknutia medzerami. Každé slovo bude z veľkým písmenom, takže 'last_visited_at' sa stane 'Last Visited At'."

#: metabase/models/serialization/resolve/mp.clj
msgid "No table found matching portable FK {0}. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and schemas, then retry with an exact portable FK from the response."
msgstr "Nenašla sa žiadna tabuľka zodpovedajúca portable FK {0}. Zavolajte `read_resource` s `metabase://database/<numeric id>/tables`, aby ste zobrazili dostupné tabuľky a schémy, potom to skúste znova s presným portable FK z odpovede."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable table FK references database {0}, but metadata provider is for {1}."
msgstr "Prenosný FK tabuľky odkazuje na databázu {0}, ale poskytovateľ metadát je pre {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous portable table FK {0}: {1} candidates. Call `read_resource` with `metabase://database/<numeric id>/tables` to list available tables and retry with a more specific portable FK."
msgstr "Nejednoznačné portable FK tabuľky {0}: {1} kandidátov. Zavolajte `read_resource` s `metabase://database/<numeric id>/tables`, aby ste zobrazili dostupné tabuľky, a skúste to znova s konkrétnejším portable FK."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable field FK {0} must have at least 4 elements."
msgstr "Prenosný FK poľa {0} musí mať aspoň 4 prvky."

#: metabase/models/serialization/resolve/mp.clj
msgid "No column {0} on table {1}.{2}.{3}. Call `read_resource` with `metabase://table/<numeric id>/fields` to list this table''s columns."
msgstr "Žiadny stĺpec {0} v tabuľke {1}.{2}.{3}. Zavolajte `read_resource` s `metabase://table/<numeric id>/fields`, aby ste zobrazili stĺpce tejto tabuľky."

#: metabase/models/serialization/resolve/mp.clj
msgid "Ambiguous column {0} on table {1}.{2}.{3}."
msgstr "Nejednoznačný stĺpec {0} v tabuľke {1}.{2}.{3}."

#: metabase/models/serialization/resolve/mp.clj
msgid "{0} is not implemented for the metadata-provider-backed resolver in Phase 1."
msgstr "{0} nie je implementované pre resolver založený na poskytovateľovi metadát vo Fáze 1."

#: metabase/models/serialization/resolve/mp.clj
msgid "Portable database reference {0} does not match metadata provider database {1}."
msgstr "Prenosný odkaz na databázu {0} sa nezhoduje s databázou poskytovateľa metadát {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Cannot export database id {0}: metadata provider is for database id {1}."
msgstr "Nedá sa exportovať databáza s id {0}: poskytovateľ metadát je pre databázu s id {1}."

#: metabase/models/serialization/resolve/mp.clj
msgid "No saved question, model, or metric found with id {0}."
msgstr "Nenašla sa uložená otázka, model ani metrika s id {0}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question / model / metric id {0} belongs to database {1}, but this resolver targets database {2}."
msgstr "Uložená otázka / model / metrika s id {0} patrí do databázy {1}, ale tento resolver cieli na databázu {2}."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question, model, or metric id {0} does not have an entity_id, so it cannot be exported as a portable representation."
msgstr "Uložená otázka, model alebo metrika s id {0} nemá entity_id, takže ju nemožno exportovať ako prenosnú reprezentáciu."

#: metabase/models/serialization/resolve/mp.clj
msgid "Saved question / model {0} belongs to database {1}, but this query targets database {2}. Cross-database queries are not supported."
msgstr "Uložená otázka / model {0} patrí do databázy {1}, ale tento dotaz cieli na databázu {2}. Dotazy naprieč databázami nie sú podporované."

#: metabase/models/serialization/resolve/mp.clj
msgid "No measure found with entity_id {0}. Do not invent or guess entity_ids: read the table that owns the measure with `read_resource` (`metabase://table/<numeric id>`) and copy the exact `portable_entity_id` from its `<measure>` tag."
msgstr "Nenašla sa žiadna metrika s entity_id {0}. Nevymýšľajte ani neháďte entity_ids: načítajte tabuľku, ktorej metrika patrí, pomocou `read_resource` (`metabase://table/<numeric id>`) a skopírujte presné `portable_entity_id` z jej tagu `<measure>`."

#: metabase/models/serialization/resolve/mp.clj
msgid "Measure {0} belongs to a table in a different database than this query (target database id {1}). Cross-database queries are not supported."
msgstr "Metrika {0} patrí do tabuľky v inej databáze než tento dotaz (cieľové id databázy {1}). Dotazy naprieč databázami nie sú podporované."

#: metabase/models/serialization/resolve/mp.clj
