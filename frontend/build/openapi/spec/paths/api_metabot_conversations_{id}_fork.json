{
  "post": {
    "description": "Fork a conversation at an assistant message, returning a brand-new conversation\n  that copies the thread from the start up to and including that message.\n\n  Only the conversation's originator may fork it, for now. `message_id` is the\n  `external_id` of the message to fork at, which must be a live, finished,\n  non-errored assistant message. The clone gets fresh conversation/message ids,\n  fresh timestamps, the current user as owner, and zeroed token usage so the fork\n  does not double-count tokens in the analytics views.",
    "operationId": "post-api-metabot-conversations-id-fork",
    "parameters": [
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "message_id": {
                "description": "value must be a valid UUID.",
                "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                "type": "string"
              }
            },
            "required": [
              "message_id"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "conversation_id": {
                  "description": "value must be a valid UUID.",
                  "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                  "type": "string"
                },
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "forked_from_conversation_id": {
                  "oneOf": [
                    {
                      "description": "value must be a valid UUID.",
                      "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messages": {
                  "items": {
                    "properties": {},
                    "type": "object"
                  },
                  "type": "array"
                },
                "saved_entities": {
                  "items": {
                    "properties": {
                      "card_id": {
                        "description": "value must be an integer greater than zero.",
                        "minimum": 1,
                        "type": "integer"
                      },
                      "chart_id": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "card_id",
                      "chart_id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "state": {
                  "oneOf": [
                    {
                      "$ref": "../components/schemas/metabase.metabot.schema.state.json"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "title": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "user_id": {
                  "oneOf": [
                    {
                      "description": "value must be an integer greater than zero.",
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "conversation_id",
                "created_at",
                "title",
                "user_id",
                "forked_from_conversation_id",
                "saved_entities",
                "messages"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/metabot/conversations/{id}/fork",
    "tags": [
      "/api/metabot/conversations"
    ]
  }
}
