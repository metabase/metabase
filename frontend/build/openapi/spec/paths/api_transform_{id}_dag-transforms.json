{
  "get": {
    "description": "Preview the transforms a DAG reprocess from this transform would run (see `POST /:id/run-dag`),\n  in execution order.",
    "operationId": "get-api-transform-id-dag-transforms",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "direction",
        "required": true,
        "schema": {
          "enum": [
            "upstream",
            "downstream"
          ],
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/transform/{id}/dag-transforms",
    "tags": [
      "/api/transform"
    ]
  }
}
