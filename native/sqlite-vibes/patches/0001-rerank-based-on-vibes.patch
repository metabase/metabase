+/*
+** RERANK BASED ON VIBES (vibes patch).
+**
+**     S RERANK BASED ON VIBES [(P)] [ASC|DESC] [LIMIT L]
+**
+** is desugared at parse time into
+**
+**     [WITH ...moved from S]
+**     SELECT * FROM (SELECT row_number() OVER () AS __vibes_id, * FROM (S))
+**                   AS __vibes_cand
+**     ORDER BY vibes(P, __vibes_id, <roster>, <nonce>) DESC, __vibes_id ASC
+**     [LIMIT L]
+**
+** and selectExpander() later (once the column names are known) fills in
+** <roster> as
+**
+**     json_group_object(__vibes_id, json_object('c1', __vibes_cand.c1, ...))
+**         OVER ()
+**
+** and <nonce> as min(random()) OVER (), one random number per execution that
+** lets the rows of one statement share a failed scoring, and drops __vibes_id
+** from the result set.  vibes() itself is an ordinary
+** application-defined function, resolved like any other.  P defaults to
+** (SELECT prompt FROM user_prompt).
+*/
+static Expr *vibesFunction(Parse *pParse, const char *zName, ExprList *pArgs){
+  Token t;
+  sqlite3TokenInit(&t, (char*)zName);
+  return sqlite3ExprFunction(pParse, pArgs, &t, 0);
+}
+static Expr *vibesWindowFunction(
+  Parse *pParse,
+  const char *zName,
+  ExprList *pArgs
+){
+  Expr *p = vibesFunction(pParse, zName, pArgs);
+  if( p ){
+    Window *pWin = sqlite3WindowAlloc(pParse, 0, TK_UNBOUNDED, 0,
+                                      TK_CURRENT, 0, 0);
+    if( pWin ){
+      sqlite3WindowAttach(pParse, p, pWin);
+    }else{
+      sqlite3ExprDelete(pParse->db, p);
+      p = 0;
+    }
+  }
+  return p;
+}
+
+/*
+** The value of the grammar's rerank_opt: a one-term list holding the prompt
+** expression, with the term's sort order as the direction.
+*/
+ExprList *sqlite3VibesRerankClause(Parse *pParse, Expr *pPrompt, int eDir){
+  ExprList *pList;
+  if( pPrompt==0 ){
+    Token t;
+    Select *pSel;
+    sqlite3TokenInit(&t, "user_prompt");
+    pSel = sqlite3SelectNew(pParse,
+        sqlite3ExprListAppend(pParse, 0,
+                              sqlite3Expr(pParse->db, TK_ID, "prompt")),
+        sqlite3SrcListAppend(pParse, 0, &t, 0), 0, 0, 0, 0, 0, 0);
+    pPrompt = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
+    sqlite3PExprAddSelect(pParse, pPrompt, pSel);
+  }
+  pList = sqlite3ExprListAppend(pParse, 0, pPrompt);
+  sqlite3ExprListSetSortOrder(pList,
+      eDir==SQLITE_SO_UNDEFINED ? SQLITE_SO_DESC : eDir, SQLITE_SO_UNDEFINED);
+  return pList;
+}
+
+/*
+** Called for every complete select (compound, with its WITH clause
+** attached).  Returns p unchanged unless its last term carries a RERANK
+** clause, in which case returns the desugared select described above.
+*/
+Select *sqlite3VibesRerankWrap(Parse *pParse, Select *p){
+  sqlite3 *db = pParse->db;
+  ExprList *pRerank, *pEList, *pArgs, *pOrderBy;
+  Expr *pPrompt, *pLimit;
+  With *pWith;
+  SrcList *pSrc;
+  Select *pNum, *pNew;
+  Token t;
+  int eDir;
+
+  if( p==0 || p->pRerank==0 ) return p;
+  pRerank = p->pRerank;
+  p->pRerank = 0;
+  if( pParse->nVibesRerank<255 ) pParse->nVibesRerank++;
+  pPrompt = pRerank->a[0].pExpr;
+  pRerank->a[0].pExpr = 0;
+  eDir = (pRerank->a[0].fg.sortFlags & KEYINFO_ORDER_DESC)
+             ? SQLITE_SO_DESC : SQLITE_SO_ASC;
+  sqlite3ExprListDelete(db, pRerank);
+
+  pWith = p->pWith;
+  p->pWith = 0;
+  pLimit = p->pLimit;
+  p->pLimit = 0;
+  /* The select's own ORDER BY numbers the candidates: the tiebreak. */
+  if( p->pOrderBy ) p->selFlags |= SF_OrderByReqd;
+
+  /* SELECT row_number() OVER () AS __vibes_id, * FROM (p) */
+  pEList = sqlite3ExprListAppend(pParse, 0,
+                                 vibesWindowFunction(pParse, "row_number", 0));
+  sqlite3TokenInit(&t, "__vibes_id");
+  sqlite3ExprListSetName(pParse, pEList, &t, 0);
+  pEList = sqlite3ExprListAppend(pParse, pEList,
+                                 sqlite3Expr(db, TK_ASTERISK, 0));
+  t.z = 0;
+  t.n = 0;
+  pSrc = sqlite3SrcListAppendFromTerm(pParse, 0, 0, 0, &t, p, 0);
+  pNum = sqlite3SelectNew(pParse, pEList, pSrc, 0, 0, 0, 0, 0, 0);
+
+  /* SELECT * FROM (pNum) AS __vibes_cand
+  ** ORDER BY vibes(P, __vibes_id, NULL, NULL) dir, __vibes_id ASC LIMIT L */
+  sqlite3TokenInit(&t, "__vibes_cand");
+  pSrc = sqlite3SrcListAppendFromTerm(pParse, 0, 0, 0, &t, pNum, 0);
+  pArgs = sqlite3ExprListAppend(pParse, 0, pPrompt);
+  pArgs = sqlite3ExprListAppend(pParse, pArgs,
+                                sqlite3Expr(db, TK_ID, "__vibes_id"));
+  pArgs = sqlite3ExprListAppend(pParse, pArgs, sqlite3Expr(db, TK_NULL, 0));
+  pArgs = sqlite3ExprListAppend(pParse, pArgs, sqlite3Expr(db, TK_NULL, 0));
+  pOrderBy = sqlite3ExprListAppend(pParse, 0,
+                                   vibesFunction(pParse, "vibes", pArgs));
+  sqlite3ExprListSetSortOrder(pOrderBy, eDir, SQLITE_SO_UNDEFINED);
+  pOrderBy = sqlite3ExprListAppend(pParse, pOrderBy,
+                                   sqlite3Expr(db, TK_ID, "__vibes_id"));
+  sqlite3ExprListSetSortOrder(pOrderBy, SQLITE_SO_ASC, SQLITE_SO_UNDEFINED);
+  pNew = sqlite3SelectNew(pParse, 0, pSrc, 0, 0, 0, pOrderBy, 0, pLimit);
+  if( pNew ){
+    pNew->pWith = pWith;
+    pNew->selFlags |= SF_VibesRerank;
+  }else{
+    sqlite3WithDelete(db, pWith);
+  }
+  return pNew;
+}
+
+/*
+** selectExpander() step for a select made by sqlite3VibesRerankWrap(),
+** after its "*" has been expanded: build the roster from the candidate
+** columns, add the per-execution nonce and hide __vibes_id.  Returns non-zero
+** on error.
+*/
+static int vibesRerankExpand(Parse *pParse, Select *p){
+  sqlite3 *db = pParse->db;
+  ExprList *pEList = p->pEList;
+  ExprList *pObj = 0, *pArgs;
+  Expr *pVibes, *pRoster, *pNonce;
+  Table *pTab;
+  int i;
+
+  p->selFlags &= ~(u32)SF_VibesRerank;
+  /* The prompt may be correlated, and it lives in the ORDER BY. */
+  p->selFlags |= SF_VibesOuterOB;
+  if( pParse->nErr ) return 1;
+  pTab = p->pSrc->nSrc==1 ? p->pSrc->a[0].pSTab : 0;
+  pVibes = p->pOrderBy && p->pOrderBy->nExpr==2 ? p->pOrderBy->a[0].pExpr : 0;
+  if( pTab==0 || pEList==0 || pEList->nExpr!=pTab->nCol || pTab->nCol<2
+   || sqlite3StrICmp(pTab->aCol[0].zCnName, "__vibes_id")!=0
+   || pVibes==0 || pVibes->op!=TK_FUNCTION || !ExprUseXList(pVibes)
+   || pVibes->x.pList==0 || pVibes->x.pList->nExpr!=4
+  ){
+    sqlite3ErrorMsg(pParse, "malformed RERANK BASED ON VIBES");
+    return 1;
+  }
+  for(i=1; i<pTab->nCol; i++){
+    const char *zName = pTab->aCol[i].zCnName;
+    pObj = sqlite3ExprListAppend(pParse, pObj,
+                                 sqlite3Expr(db, TK_STRING, zName));
+    pObj = sqlite3ExprListAppend(pParse, pObj,
+        sqlite3PExpr(pParse, TK_DOT, sqlite3Expr(db, TK_ID, "__vibes_cand"),
+                     sqlite3Expr(db, TK_ID, zName)));
+  }
+  pArgs = sqlite3ExprListAppend(pParse, 0,
+                                sqlite3Expr(db, TK_ID, "__vibes_id"));
+  pArgs = sqlite3ExprListAppend(pParse, pArgs,
+                                vibesFunction(pParse, "json_object", pObj));
+  pRoster = vibesWindowFunction(pParse, "json_group_object", pArgs);
+  if( pRoster==0 ) return 1;
+  sqlite3ExprDelete(db, pVibes->x.pList->a[2].pExpr);
+  pVibes->x.pList->a[2].pExpr = pRoster;
+  pNonce = vibesWindowFunction(pParse, "min",
+      sqlite3ExprListAppend(pParse, 0, vibesFunction(pParse, "random", 0)));
+  if( pNonce==0 ) return 1;
+  sqlite3ExprDelete(db, pVibes->x.pList->a[3].pExpr);
+  pVibes->x.pList->a[3].pExpr = pNonce;
+
+  sqlite3ExprDelete(db, pEList->a[0].pExpr);
+  sqlite3DbFree(db, pEList->a[0].zEName);
+  memmove(&pEList->a[0], &pEList->a[1], (pEList->nExpr-1)*sizeof(pEList->a[0]));
+  pEList->nExpr--;
+  return pParse->nErr!=0;
+}
