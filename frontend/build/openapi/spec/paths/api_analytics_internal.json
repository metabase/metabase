      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "events": {
                "items": {
                  "properties": {
                    "amount": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "labels": {
                      "oneOf": [
                        {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "metric": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "inc",
                        "dec",
                        "set",
                        "observe",
                        "clear"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "metric"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "events"
            ],
            "type": "object"
          }
        }
