{
  "post": {
    "description": "Fetches the values for filling in execution parameters. Pass PK parameters and values to select.\n\n  Parameters are sent in the request body rather than the query string so their values stay out of URLs and logs.",
    "operationId": "post-api-public-dashboard-uuid-dashcard-dashcard-id-execute-values",
    "parameters": [
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "uuid",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      },
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "dashcard-id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "parameters": {
                "$ref": "../components/schemas/metabase.actions.schema.prefetch-parameter-values.json"
              }
            },
            "required": [
              "parameters"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": {},
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/public/dashboard/{uuid}/dashcard/{dashcard-id}/execute/values",
    "tags": [
      "/api/public"
    ]
  }
}
