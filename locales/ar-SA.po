msgstr "يحل محل جزء من نص الإدخال بنص جديد."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "find"
msgstr "تجد"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The text to find."
msgstr "النص للعثور عليه."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Enormous"
msgstr "ضخم"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "replace"
msgstr "يحل محل"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The text to use as the replacement."
msgstr "النص لاستخدامه كبديل."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Gigantic"
msgstr "عملاق"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Returns the number of characters in text."
msgstr "إرجاع عدد الأحرف في النص."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text you want to get the length of."
msgstr "العمود أو النص الذي تريد الحصول عليه."

