{
  "post": {
    "description": "Send a chat message to the LLM via the AI Proxy.",
    "operationId": "post-api-metabot-agent-streaming",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "assistant_message_id": {
                "oneOf": [
                  {
                    "description": "value must be a valid UUID.",
                    "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "context": {
                "$ref": "../components/schemas/metabase.metabot.context.context.json"
              },
              "conversation_id": {
                "description": "value must be a valid UUID.",
                "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                "type": "string"
              },
              "debug": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eval_session_id": {
                "oneOf": [
                  {
                    "allOf": [
                      {
                        "maxLength": 200,
                        "type": "string"
                      },
                      {
                        "pattern": "\\A[A-Za-z0-9][A-Za-z0-9._-]*\\z",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "metabot_id": {
                "type": "string"
              },
              "parent_message_id": {
                "oneOf": [
                  {
                    "description": "value must be a valid UUID.",
                    "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "profile_id": {
                "type": "string"
              },
              "retry_message_id": {
                "oneOf": [
                  {
                    "description": "value must be a valid UUID.",
                    "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "user_message_id": {
                "oneOf": [
                  {
                    "description": "value must be a valid UUID.",
                    "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "message",
              "context",
              "conversation_id"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/metabot/agent-streaming",
    "tags": [
      "/api/metabot"
    ]
  }
}
