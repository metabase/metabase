        }
      },
      "required": [
        "strategy"
      ],
      "type": "object"
    },
    {
      "properties": {
        "bin-width": {
          "$ref": "./metabase.lib.schema.common.positive-number.json"
        },
        "strategy": {
          "const": "bin-width"
        }
      },
      "required": [
        "strategy",
        "bin-width"
      ],
      "type": "object"
    },
    {
      "properties": {
        "num-bins": {
          "minimum": 1,
          "type": "integer"
        },
        "strategy": {
          "const": "num-bins"
        }
      },
      "required": [
        "strategy",
        "num-bins"
      ],
      "type": "object"
    }
  ]
}
