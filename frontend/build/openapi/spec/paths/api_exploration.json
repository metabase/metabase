{
  "post": {
    "description": "Create a new exploration with a single thread, persist the user's selected metrics, dimensions,\n  and timelines, and stamp the thread as started. Actual planning is async; this endpoint returns\n  immediately with an empty queries list. Clients should poll `GET /:id` until the queries appear\n  and reach a terminal status.\n\n  Accepts the per-area `:blocks` payload (one entry per Research-plan block), persisted\n  verbatim, plus a thread-scoped `:timeline_ids`.",
    "operationId": "post-api-exploration",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "blocks": {
                "oneOf": [
                  {
                    "items": {
                      "properties": {
                        "dimensions": {
                          "oneOf": [
                            {
                              "items": {
                                "properties": {
                                  "dimension-id": {
                                    "description": "value must be a valid UUID.",
                                    "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
                                    "type": "string"
                                  },
                                  "display-name": {
                                    "oneOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "effective-type": {
                                    "oneOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "semantic-type": {
                                    "oneOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "dimension-id"
                                ],
                                "type": "object"
                              },
                              "type": "array"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "metrics": {
                          "oneOf": [
                            {
                              "items": {
                                "properties": {
                                  "card_id": {
                                    "description": "value must be an integer greater than zero.",
                                    "minimum": 1,
                                    "type": "integer"
                                  },
                                  "dimension_mappings": {
                                    "oneOf": [
                                      {
                                        "items": {
                                          "$ref": "../components/schemas/metabase.metrics.core.dimension-mapping.json"
                                        },
                                        "type": "array"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "card_id"
                                ],
                                "type": "object"
                              },
                              "type": "array"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "type": {
                          "oneOf": [
                            {
                              "enum": [
                                "metric",
                                "dimension"
                              ],
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "collection_id": {
                "oneOf": [
                  {
                    "description": "value must be an integer greater than zero.",
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "maxLength": 254,
                "minLength": 1,
                "type": "string"
              },
              "prompt": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeline_ids": {
                "oneOf": [
                  {
                    "items": {
                      "description": "value must be an integer greater than zero.",
                      "minimum": 1,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/metabase.explorations.api.HydratedExploration.json"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/exploration",
    "tags": [
      "/api/exploration"
    ]
  }
}
