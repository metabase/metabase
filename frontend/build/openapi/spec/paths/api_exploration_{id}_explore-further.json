                          "type": "array"
                        },
                        "operator": {
                          "const": "="
                        },
                        "value": {
                          "oneOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "operator",
                        "field_ref",
                        "value",
                        "display_value"
                      ],
                      "type": "object"
                    },
                    {
