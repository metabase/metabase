#: metabase/metabot/self/openrouter.clj
msgid "OpenRouter API error (HTTP {0})"
msgstr "خطای API OpenRouter (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "AI proxy is not supported for vLLM"
msgstr "پراکسی هوش مصنوعی برای vLLM پشتیبانی نمی‌شود"

#: metabase/metabot/self/vllm.clj
msgid "No vLLM base URL is set"
msgstr "هیچ URL پایه‌ای برای vLLM تنظیم نشده است"

#: metabase/metabot/self/vllm.clj
msgid "No vLLM model is set"
msgstr "هیچ مدل vLLM تنظیم نشده است"

#: metabase/metabot/self/vllm.clj
msgid "vLLM rejected the request — usually an unsupported schema, or a model that cannot compile the tool grammar"
msgstr "vLLM درخواست را رد کرد — معمولاً به‌خاطر یک schema پشتیبانی‌نشده، یا مدلی که نمی‌تواند grammar ابزار را کامپایل کند"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API key expired or invalid — check the key your server was started with via --api-key"
msgstr "کلید API vLLM منقضی شده یا نامعتبر است — کلیدی را که سرور با --api-key با آن راه‌اندازی شده بررسی کنید"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API endpoint was not found — the base URL should end in /v1"
msgstr "اندپوینت API vLLM پیدا نشد — URL پایه باید به /v1 ختم شود"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "صف درخواستِ سرور vLLM پر است — بار هم‌زمان را کاهش دهید، یا آن را با --max-num-seqs بزرگ‌تر راه‌اندازی مجدد کنید"

#: metabase/metabot/self/vllm.clj
msgid "vLLM returned an internal server error"
msgstr "vLLM یک خطای داخلی سرور برگرداند"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "خطای API vLLM (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "Could not reach the vLLM server at {0}. Check that it is running and that the base URL is correct."
msgstr "امکان دسترسی به سرور vLLM در {0} نبود. بررسی کنید در حال اجراست و URL پایه درست است."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "سرور vLLM در {0} در بازه {1}ms پاسخ نداد. بررسی کنید در حال اجراست و تحت بار زیاد نیست."

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "بررسی کنید {0} API سازگار با OpenAI روی یک سرور vLLM باشد — URL پایه باید به /v1 ختم شود."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} با یک پنجره کانتکست {1} توکنی سرو می‌شود که برای Metabot خیلی کوچک است — حداقل به {2} نیاز دارد. vLLM را با --max-model-len بزرگ‌تر راه‌اندازی مجدد کنید."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} استدلالش را به‌صورت متن چت استریم کرد. vLLM را با --reasoning-parser راه‌اندازی مجدد کنید تا فکر کردن داخل پاسخ‌های Metabot دیده نشود."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} در میانهٔ یک فراخوانی ابزار به سقف {1} توکنِ connection-test رسید. مدلی که قبل از فراخوانی ابزار این‌قدر تولید می‌کند، برای راه‌اندازی Metabot بیش از حد کند است."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "سرور vLLM یک فراخوانی ابزار برگرداند که آرگومان‌هایش JSON معتبر نیست. به‌احتمال زیاد --tool-call-parser با فرمت خروجی {0} هم‌خوان نیست."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} کل بودجه {1} توکنِ connection-test را صرف استدلال کرد بدون اینکه ابزاری را فراخوانی کند. مدلی که برای یک پرامپت ساده این‌قدر طولانی فکر می‌کند، برای راه‌اندازی Metabot بیش از حد کند است."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} قبل از کامل کردن یک فراخوانی ابزار به سقف {1} توکنِ connection-test رسید. مدلی که قبل از فراخوانی ابزار این‌قدر تولید می‌کند، برای راه‌اندازی Metabot بیش از حد کند است."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "سرور vLLM به‌جای فراخوانی ابزار با متن پاسخ داد. آن را با --enable-auto-tool-choice و یک --tool-call-parser که با فرمت خروجی {0} هم‌خوان باشد راه‌اندازی مجدد کنید."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} بدون تولید یک فراخوانی ابزارِ اجباری به سقف {1} توکنِ connection-test رسید. Metabot برای عنوان‌های گفتگو و تولید SQL به پشتیبانی خروجی ساخت‌یافته نیاز دارد."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "سرور vLLM یک فراخوانی ابزارِ اجباری را رعایت نکرد. Metabot برای عنوان‌های گفتگو و تولید SQL به پشتیبانی خروجی ساخت‌یافته نیاز دارد."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "سرور vLLM قابل دسترسی است اما هیچ مدلی سرو نمی‌کند."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "سرور vLLM در حال سرو کردن {0} نیست. در حال سرو کردن این‌هاست: {1}."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "سرور vLLM در بازه {0}ms به تست اتصال پاسخ نداد. بررسی کنید تحت بار زیاد نباشد — سروری که برای پاسخ به یک پرامپت ساده این‌قدر کند است نمی‌تواند Metabot را راه‌اندازی کند."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "سرور vLLM بعد از {0}ms دیگر پاسخ نداد. تایم‌اوت درخواست vLLM را افزایش دهید، یا یک مدل سریع‌تر سرو کنید."

#: metabase/metabot/self/vllm.clj
msgid "The connection to the vLLM server was interrupted before the response finished."
msgstr "اتصال به سرور vLLM قبل از اینکه پاسخ تمام شود قطع شد."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not respond within {0}ms. Check that it is not overloaded, or raise the vLLM request timeout."
msgstr "سرور vLLM در بازه {0}ms پاسخ نداد. بررسی کنید تحت بار زیاد نباشد، یا تایم‌اوت درخواست vLLM را افزایش دهید."

#: metabase/metabot/self/zai.clj
msgid "AI proxy is not supported for Z.AI"
msgstr "پروکسی هوش مصنوعی برای Z.AI پشتیبانی نمی‌شود"

#: metabase/metabot/self/zai.clj
msgid "Z.AI API key expired or invalid"
msgstr "کلید API Z.AI منقضی شده یا نامعتبر است"

#: metabase/metabot/self/zai.clj
msgid "Z.AI API endpoint was not found — check the base URL"
msgstr "اندپوینت API Z.AI پیدا نشد — URL پایه را بررسی کنید"

#: metabase/metabot/self/zai.clj
msgid "Z.AI has rate limited us"
msgstr "Z.AI ما را rate limit کرده است"

#: metabase/metabot/self/zai.clj
msgid "Z.AI returned an internal server error"
msgstr "Z.AI یک خطای داخلی سرور برگرداند"

#: metabase/metabot/self/zai.clj
msgid "Z.AI API error (HTTP {0})"
msgstr "خطای API Z.AI (HTTP {0})"

#: metabase/metabot/settings.clj
msgid "Override Metabot ID for agent streaming requests."
msgstr "بازنویسی ID ‏Metabot برای درخواست‌های استریمینگ ایجنت."

#: metabase/metabot/settings.clj
msgid "Whether Metabot is enabled for regular usage."
msgstr "اینکه آیا Metabot برای استفادهٔ معمول فعال است یا نه."

#: metabase/metabot/settings.clj
msgid "The display name for Metabot, shown throughout the Metabase UI."
msgstr "نام نمایشی Metabot، که در سراسر UIِ Metabase نمایش داده می‌شود."

#: metabase/metabot/settings.clj
msgid "The icon for Metabot. Set to `metabot` for the default icon, or a data URI for a custom uploaded image (up to 1MB)."
msgstr "آیکن Metabot. برای آیکن پیش‌فرض روی `metabot` تنظیم کنید، یا یک data URI برای تصویر سفارشیِ آپلودشده (تا 1MB)."

#: metabase/metabot/settings.clj
msgid "Whether to show Metabot illustrations in the UI."
msgstr "اینکه آیا تصاویر Metabot در UI نمایش داده شوند یا نه."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the chat experience (the AI sidebar and embedded Metabot)."
msgstr "دستورالعمل‌های سفارشی که به system promptِ Metabot برای تجربهٔ چت اضافه می‌شود (سایدبار هوش مصنوعی و Metabot تعبیه‌شده)."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the natural language query (AI exploration) experience."
msgstr "دستورالعمل‌های سفارشی که به system promptِ Metabot برای تجربهٔ کوئریِ زبان طبیعی (کاوش هوش مصنوعی) اضافه می‌شود."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the SQL generation experience."
msgstr "دستورالعمل‌های سفارشی که به system promptِ Metabot برای تجربهٔ تولید SQL اضافه می‌شود."

#: metabase/metabot/settings.clj
msgid "Whether Metabot is enabled for embedding."
msgstr "اینکه آیا Metabot برای تعبیه‌سازی فعال است یا نه."

#: metabase/metabot/settings.clj
msgid "Whether the user''s recently viewed items are included in the Metabot system prompt."
msgstr "اینکه آیا آیتم‌های اخیراً مشاهده‌شدهٔ کاربر در پرامپت سیستم Metabot لحاظ شوند یا نه."

#: metabase/metabot/settings.clj
msgid "Invalid Azure model {0}. Expected format: <connection>/<family>/<deployment-name> where <family> is one of: {1}"
msgstr "مدل Azure نامعتبر {0}. فرمت مورد انتظار: <connection>/<family>/<deployment-name> که <family> یکی از این‌هاست: {1}"

#: metabase/metabot/settings.clj
msgid "Unsupported model {0} for Metabase managed AI. Supported models: {1}"
msgstr "مدل {0} برای هوش مصنوعی مدیریت‌شدهٔ Metabase پشتیبانی نمی‌شود. مدل‌های پشتیبانی‌شده: {1}"

#: metabase/metabot/settings.clj
msgid "Metabot provider must be a string, got: {0}"
msgstr "ارائه‌دهنده Metabot باید یک رشته باشد، دریافت شد: {0}"

#: metabase/metabot/settings.clj
msgid "Model name is required. Expected format: connection/model, e.g. \"anthropic/claude-haiku-4-5\""
msgstr "نام مدل الزامی است. فرمت مورد انتظار: connection/model، مثلاً \"anthropic/claude-haiku-4-5\""

#: metabase/metabot/settings.clj
msgid "The AI provider connection and model for Metabot. Format: connection-key/model-name, e.g. `anthropic/claude-haiku-4-5`, `openai/gpt-5.4`, `openrouter/anthropic/claude-haiku-4.5`. The connection key names an entry in the `llm-providers` setting and defaults to the provider type."
msgstr "اتصال ارائه‌دهنده هوش مصنوعی و مدل برای Metabot. فرمت: connection-key/model-name، مثلاً `anthropic/claude-haiku-4-5`، `openai/gpt-5.4`، `openrouter/anthropic/claude-haiku-4.5`. کلید اتصال نامِ یک ورودی در تنظیم `llm-providers` است و به‌صورت پیش‌فرض برابر با نوع ارائه‌دهنده است."

#: metabase/metabot/settings.clj
msgid "The AI provider connection and model used for quick background tasks, such as naming Metabot conversations, in the same connection-key/model-name format as `llm-metabot-provider`. Defaults to the fastest model offered by the connection Metabot runs on."
msgstr "اتصال ارائه‌دهنده هوش مصنوعی و مدل مورد استفاده برای کارهای سریعِ پس‌زمینه، مثل نام‌گذاری گفتگوهای Metabot، با همان فرمت connection-key/model-name مانند `llm-metabot-provider`. مقدار پیش‌فرض سریع‌ترین مدلی است که اتصالِ اجراشده توسط Metabot ارائه می‌دهد."

#: metabase/metabot/settings.clj
msgid "Number of days to retain rows in the ai_usage_log, metabot_conversation, and metabot_message tables. Minimum value is 30; set to 0 to retain data indefinitely."
msgstr "تعداد روزهایی که ردیف‌ها در جدول‌های ai_usage_log، metabot_conversation و metabot_message نگه‌داری می‌شوند. حداقل مقدار 30 است؛ برای نگه‌داری نامحدود داده‌ها مقدار را 0 بگذارید."

#: metabase/metabot/tools/construct.clj
msgid "`source-table:` does not accept URIs like `{0}`. {1}"
msgstr "`source-table:` URIهایی مثل `{0}` را قبول نمی‌کند. {1}"

#: metabase/metabot/tools/construct.clj
msgid "Unknown database: `{0}`. Use the exact database name as reported by search / `read_resource` (it appears as the first element of every portable FK, e.g. `source-table: [<db-name>, <schema>, <table>]`)."
msgstr "دیتابیس ناشناخته: `{0}`. از نام دقیق دیتابیس همان‌طور که توسط search / `read_resource` گزارش می‌شود استفاده کنید (به‌عنوان اولین عنصر هر portable FK نمایش داده می‌شود، مثلاً `source-table: [<db-name>, <schema>, <table>]`)."

#: metabase/metabot/tools/construct.clj
msgid "Multiple databases share the name `{0}` (ids: {1}). The agent has no way to disambiguate; ask the user to rename one of the databases or use a more specific identifier."
msgstr "چند پایگاه داده نام `{0}` را دارند (idها: {1}). ایجنت راهی برای رفع ابهام ندارد؛ از کاربر بخواهید نام یکی از پایگاه داده‌ها را تغییر دهد یا از یک شناسهٔ دقیق‌تر استفاده کند."

#: metabase/metabot/tools/construct.clj
#: metabase/models/serialization/resolve/mp.clj
msgid "No saved question or model found with entity_id {0}. Do not invent or guess entity_ids: call `read_resource` with `metabase://question/<numeric id>` or `metabase://model/<numeric id>` first, then copy the exact `portable_entity_id` from the response into `source-card:`."
msgstr "هیچ سؤال ذخیره‌شده یا مدلی با entity_id {0} پیدا نشد. entity_idها را ابداع یا حدس نزنید: ابتدا `read_resource` را با `metabase://question/<numeric id>` یا `metabase://model/<numeric id>` فراخوانی کنید، سپس `portable_entity_id` دقیق را از پاسخ در `source-card:` کپی کنید."

#: metabase/metabot/tools/construct.clj
msgid "First stage must have either `source-table:` (as a portable FK `[<db-name>, <schema>, <table>]`) or `source-card:` (as an entity_id string). Neither was found in `stages[0]`."
msgstr "مرحلهٔ اول باید یکی از این‌ها را داشته باشد: `source-table:` (به‌صورت FK قابل‌حمل `[<db-name>, <schema>, <table>]`) یا `source-card:` (به‌صورت یک رشتهٔ entity_id). هیچ‌کدام در `stages[0]` پیدا نشد."

