{
  "description": "Schema for an Exploration with hydrated creator and threads.",
  "properties": {
    "archived": {
      "type": "boolean"
    },
    "collection_id": {
      "oneOf": [
        {
          "description": "value must be an integer greater than zero.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "oneOf": [
        {
          "properties": {},
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator_id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "threads": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.explorations.api.HydratedThread.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "oneOf": [
        {},
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "creator_id"
  ],
  "type": "object"
}
