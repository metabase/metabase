#: metabase/metabot/self/vllm.clj
msgid "vLLM API endpoint was not found — the base URL should end in /v1"
msgstr "vLLM API endpoint tidak ditemui — URL asas sepatutnya berakhir dengan /v1"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "Baris gilir permintaan server vLLM penuh — kurangkan beban serentak, atau mulakan semula dengan --max-num-seqs yang lebih besar"

#: metabase/metabot/self/vllm.clj
msgid "vLLM returned an internal server error"
msgstr "vLLM mengembalikan ralat server dalaman"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "ralat API vLLM (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "Could not reach the vLLM server at {0}. Check that it is running and that the base URL is correct."
msgstr "Tidak dapat mencapai server vLLM di {0}. Semak bahawa ia berjalan dan URL asas adalah betul."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "Server vLLM di {0} tidak memberi respons dalam {1}ms. Semak bahawa ia berjalan dan tidak terlebih beban."

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "Pastikan {0} ialah API kompatibel OpenAI bagi server vLLM — URL asas sepatutnya berakhir dengan /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} disediakan dengan tetingkap konteks {1} token, yang terlalu kecil untuk Metabot — ia perlukan sekurang-kurangnya {2}. Mulakan semula vLLM dengan --max-model-len yang lebih besar."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} menstrimkan penalarannya sebagai teks chat. Mulakan semula vLLM dengan --reasoning-parser supaya pemikiran tidak muncul dalam jawapan Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} mencapai siling connection-test {1} token di pertengahan panggilan tool. Model yang menjana sebanyak ini sebelum memanggil tool terlalu lambat untuk memacu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "Server vLLM mengembalikan panggilan tool yang argumennya bukan JSON yang sah. --tool-call-parser besar kemungkinan tidak sepadan dengan format output {0}."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} menggunakan keseluruhan bajet connection-test {1} token untuk penalaran tanpa memanggil tool. Model yang berfikir selama ini tentang prompt remeh terlalu lambat untuk memacu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} mencapai siling connection-test {1} token sebelum melengkapkan panggilan tool. Model yang menjana sebanyak ini sebelum memanggil tool terlalu lambat untuk memacu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "Server vLLM menjawab dengan teks вместо memanggil tool. Mulakan semula dengan --enable-auto-tool-choice dan --tool-call-parser yang sepadan dengan format output {0}."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} mencapai siling connection-test {1} token tanpa menghasilkan panggilan tool yang dipaksa. Metabot perlukan sokongan output berstruktur untuk tajuk perbualan dan penjanaan SQL."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "Server vLLM tidak mematuhi panggilan tool yang dipaksa. Metabot perlukan sokongan output berstruktur untuk tajuk perbualan dan penjanaan SQL."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "Server vLLM boleh dicapai tetapi tidak menyediakan sebarang model."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "Server vLLM tidak menyediakan {0}. Ia menyediakan: {1}."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "Server vLLM tidak menjawab ujian sambungan dalam {0}ms. Semak supaya ia tidak terlebih beban — server yang begitu lambat untuk menjawab prompt remeh tidak boleh memacu Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "Server vLLM berhenti memberi respons selepas {0}ms. Tingkatkan timeout permintaan vLLM, atau sediakan model yang lebih pantas."

#: metabase/metabot/self/vllm.clj
msgid "The connection to the vLLM server was interrupted before the response finished."
msgstr "Sambungan ke server vLLM terganggu sebelum respons selesai."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not respond within {0}ms. Check that it is not overloaded, or raise the vLLM request timeout."
msgstr "Server vLLM tidak memberi respons dalam {0}ms. Semak supaya ia tidak terlebih beban, atau tingkatkan timeout permintaan vLLM."

