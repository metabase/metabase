#: frontend/src/metabase/admin/permissions/components/DataPermissionsHelp/DataPermissionsHelp.tsx
msgid "ANY native questions querying the database, regardless of schema/table."
msgstr "스키마/테이블에 관계없이 데이터베이스를 쿼리하는 모든 기본 질문입니다."

