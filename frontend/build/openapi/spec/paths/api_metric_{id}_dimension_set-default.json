{
  "post": {
    "description": "Mark exactly one dimension as the metric's default, clearing any previous default. A null\n  `dimension_id` clears the default without setting a new one, so the metric renders as a scalar.\n  Returns the updated list of added dimensions.",
    "operationId": "post-api-metric-id-dimension-set-default",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "dimension_id": {
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "dimension_id"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "items": {
                "properties": {},
                "type": "object"
              },
              "type": "array"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/metric/{id}/dimension/set-default",
    "tags": [
      "/api/metric"
    ]
  }
}
