msgid "Invalid temporal literal {0} in :absolute-datetime — use an ISO-8601 date, datetime, year, or year-month."
msgstr "Érvénytelen időbeli literál: {0} a :absolute-datetime mezőben — használj ISO-8601 dátumot, dátum-időt, évet vagy év-hónapot."

