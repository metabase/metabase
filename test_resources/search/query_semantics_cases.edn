 {:id "S20"
  :focus "only final OR-branch term receives prefix completion"
  :config "simple"
  :query "amb or co"
  :docs {:A {:name "amber"}
         :B {:name "amb"}
         :C {:name "cobalt"}
         :D {:name "corgi"}
         :E {:name "taco"}
         :F {:name "amber cobalt"}
         :G {:name "amb or cobalt"}
         :H {:name "orbit"}}
  :expect {:in-place [:A :B :C :D :E :F :G :H]
           :appdb-h2 [:G]
           :appdb-postgres [:B :C :D :F :G]
