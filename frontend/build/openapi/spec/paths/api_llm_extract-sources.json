      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "database_id": {
                "minimum": 1,
                "type": "integer"
              },
              "sql": {
                "type": "string"
              },
              "template_tags": {
                "additionalProperties": {
                  "properties": {
                    "card-id": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "type": "object"
                },
                "type": "object"
              }
            },
            "required": [
