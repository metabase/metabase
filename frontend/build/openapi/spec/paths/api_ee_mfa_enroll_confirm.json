{
  "post": {
    "description": "Confirm TOTP enrollment by verifying a code from the authenticator app. Activates the second\n  factor and returns the single-use recovery codes — the only time they exist in plaintext.",
    "operationId": "post-api-ee-mfa-enroll-confirm",
    "parameters": [],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "recovery_codes": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "recovery_codes"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "POST /api/ee/mfa/enroll/confirm",
    "tags": [
      "/api/ee/mfa"
    ]
  }
}
