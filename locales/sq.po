msgstr "Lista e marrësve të email-it për njoftimet e Security Center."

#: metabase_enterprise/security_center/settings.clj
msgid "Number of days between repeat notifications for each severity level."
msgstr "Numri i ditëve midis njoftimeve të përsëritura për secilin nivel ashpërsie."

