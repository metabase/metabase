{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo",
    "outDir": "build",
    "paths": {
      "*": [
        "./frontend/src/*",
        "./frontend/test/*",
        "./enterprise/frontend/src/*",
        "./enterprise/frontend/test/*"
      ],
      "build-configs/*": ["./frontend/build/*"],
      "cljs/*": ["./target/cljs_dev/*"],
      "echarts/types/src/*": ["./node_modules/echarts/types/src/*"],
      "zrender/lib/core/types": ["./node_modules/zrender/lib/core/types"],
      "ee-plugins": ["./frontend/src/metabase/plugins/noop"],
      "locale-catalog": ["./frontend/src/metabase/api/load-locale-catalog"],
      "sdk-ee-plugins": ["./frontend/src/metabase/plugins/noop"],
      "sdk-iframe-embedding-ee-plugins": [
        "./frontend/src/metabase/plugins/noop"
      ],
      "sdk-iframe-embedding-script-ee-plugins": [
        "./frontend/src/metabase/plugins/noop"
      ],
      "custom-viz": ["./enterprise/frontend/src/custom-viz/src/index.ts"],
      "@metabase/embedding-sdk-react": [
        "./enterprise/frontend/src/embedding-sdk-package/index.ts"
      ],
      "@metabase/embedding-sdk-react/data-app": [
        "./enterprise/frontend/src/embedding-sdk-package/data-app.ts"
      ],
      "@metabase/embedding-sdk-react/data-app-dev": [
        "./enterprise/frontend/src/embedding-sdk-package/data-app-dev.ts"
      ],
      "@metabase/embedding-sdk-react/data-app-dev/config": [
        "./enterprise/frontend/src/embedding-sdk-package/data-app-dev.config.ts"
      ]
    },
    "plugins": [
      {
        "name": "typescript-plugin-css-modules",
        "options": {
          "goToDefinition": true
        }
      }
    ]
  },
  "include": [
    "frontend/src/**/*",
    "frontend/build/**/*",
    "enterprise/frontend/src/**/*",
    "frontend/test/**/*",
    "enterprise/frontend/test/**/*",
    ".github/scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "enterprise/frontend/src/custom-viz",
    // Vendored custom-viz plugin bundles (pre-built UMD) — opaque to
    // type-checking; the surrounding story/helper handles the typing.
    "frontend/test/__support__/custom-viz-fixtures/**/*.js"
  ]
}
