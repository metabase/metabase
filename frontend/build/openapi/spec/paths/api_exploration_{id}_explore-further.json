{
  "post": {
    "description": "Start a follow-up investigation scoped to a clicked chart segment.\n\n  The user clicked a bar/point on the chart for `page_id`; we copy that page's block (its metric\n  selection + the same dimensions) into a brand-new thread and append each `explore_filters`\n  entry onto every metric selection's `:explore_filters` vector. The background planner then\n  materializes the same set of charts, but every query is scoped to those filters — and to any\n  filters the source block already carried, so drilling from within an already-drilled thread\n  keeps the earlier scope (see\n  `metabase.explorations.query-plan.context/build-row-context`). Returns immediately with the new\n  thread stamped `started_at`; clients poll `GET /:id` for the queries to land, exactly like create.",
    "operationId": "post-api-exploration-id-explore-further",
    "parameters": [
      {
        "description": "value must be an integer greater than zero.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "explore_filters": {
                "items": {
                  "oneOf": [
                    {
                      "properties": {
                        "dimension_name": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "display_value": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "field_ref": {
