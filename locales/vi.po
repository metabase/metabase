#: metabase/app_db/liquibase.clj
msgid "Database has migration lock; cannot run migrations."
msgstr "Database đang bị khóa migration; không thể chạy migration."

#: metabase/app_db/liquibase.clj
msgid "You can force-release these locks by running `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate release-locks`."
msgstr "Bạn có thể buộc giải phóng các khóa này bằng cách chạy `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate release-locks`."

#: metabase/app_db/setup.clj
msgid "Database setup"
msgstr "Thiết lập database"

#: metabase/app_db/setup.clj
msgid "See: https://www.metabase.com/docs/latest/installation-and-operation/upgrading-metabase#rolling-back-an-upgrade"
msgstr "Xem: https://www.metabase.com/docs/latest/installation-and-operation/upgrading-metabase#rolling-back-an-upgrade"

#: metabase/app_db/setup.clj
msgid "Once your database has been downgraded, try running the application again."
msgstr "Sau khi database của bạn đã được downgrade, hãy thử chạy lại ứng dụng."

#: metabase/app_db/setup.clj
msgid "You must run `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate down` from version {0}."
msgstr "Bạn phải chạy `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate down` từ phiên bản {0}."

#: metabase/app_db/setup.clj
msgid "Your metabase instance appears to have been downgraded without a corresponding database downgrade."
msgstr "Phiên bản cài đặt metabase của bạn có vẻ đã bị downgrade mà không downgrade database tương ứng."

#: metabase/app_db/setup.clj
msgid "ERROR: Downgrade detected."
msgstr "LỖI: Phát hiện downgrade."

#: metabase/app_db/setup.clj
msgid "Metabase {0} DB version not supported (found {1}, required {2}). Please upgrade your database to a supported version and try again."
msgstr "Phiên bản DB {0} của Metabase không được hỗ trợ (đã tìm thấy {1}, yêu cầu {2}). Vui lòng nâng cấp cơ sở dữ liệu của bạn lên phiên bản được hỗ trợ và thử lại."

#: metabase/app_db/setup.clj
msgid "Unable to connect to Metabase {0} DB."
msgstr "Không thể kết nối tới DB {0} của Metabase."

#: metabase/app_db/setup.clj
msgid "Database requires manual upgrade."
msgstr "Database yêu cầu nâng cấp thủ công."

#: metabase/appearance/settings.clj
