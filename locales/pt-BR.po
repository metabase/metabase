msgstr "Verifique se {0} é uma API compatível com OpenAI de um servidor vLLM — a URL base deve terminar em /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} transmitiu seu raciocínio como texto do chat. Reinicie o vLLM com --reasoning-parser para que o pensamento não apareça dentro das respostas do Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "O servidor vLLM em {0} não respondeu dentro de {1}ms. Verifique se ele está em execução e não está sobrecarregado."

