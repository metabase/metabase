{
  "description": "Schema for a persisted dimension definition with status tracking.\n   Persisted dimensions include additional metadata about their status\n   and any issues that prevent them from being used.\n   Note: target field references are stored in dimension-mappings, not here.",
  "properties": {
    "default": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "default-temporal-unit": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension-interestingness": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "display-name": {
      "oneOf": [
        {
          "$ref": "./metabase.lib.schema.common.non-blank-string.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective-type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "group": {
      "oneOf": [
        {
          "$ref": "./metabase.metrics.dimension.group.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "has-field-values": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "./metabase.lib-metric.schema.dimension-id.json"
    },
    "name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic-type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.metrics.dimension.source.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "$ref": "./metabase.lib-metric.schema.dimension-status.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "status-message": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}
