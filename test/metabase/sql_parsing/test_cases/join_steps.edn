    [{:source "cte",
      :table nil,
      :alias "c",
      :strategy "left",
      :sql
      "WITH c AS (SELECT 1 AS x) SELECT COUNT(*) AS n, COUNT(CASE WHEN a.id = c.x THEN 1 END) AS m FROM dbo.a LEFT JOIN c ON a.id = c.x"}]}}
