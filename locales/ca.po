#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} ha arribat al límit del test de connexió de {1} tokens a mig camí d'una crida d'eina. Un model que genera tant abans de cridar una eina és massa lent per fer anar Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not respond within {0}ms. Check that it is not overloaded, or raise the vLLM request timeout."
msgstr "El servidor vLLM no ha respost en {0}ms. Comprova que no estigui sobrecarregat o augmenta el temps d'espera de sol·licitud de vLLM."

#: metabase/metabot/self/vllm.clj
msgid "AI proxy is not supported for vLLM"
msgstr "El proxy d'IA no és compatible amb vLLM"

#: metabase/metabot/self/vllm.clj
msgid "vLLM API endpoint was not found — the base URL should end in /v1"
msgstr "vLLM API endpoint was not found — l'URL base hauria d'acabar en /v1"

#: metabase/metabot/self/vllm.clj
msgid "vLLM returned an internal server error"
msgstr "vLLM ha retornat un error intern del servidor"

#: metabase/metabot/self/vllm.clj
msgid "vLLM rejected the request — usually an unsupported schema, or a model that cannot compile the tool grammar"
msgstr "vLLM ha rebutjat la sol·licitud — normalment un esquema no compatible o un model que no pot compilar la gramàtica d'eines"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server''s request queue is full — reduce concurrent load, or restart it with a larger --max-num-seqs"
msgstr "La cua de sol·licituds del servidor vLLM és plena — redueix la càrrega concurrent o reinicia'l amb un --max-num-seqs més gran"

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} ha arribat al límit del test de connexió de {1} tokens sense produir una crida d'eina forçada. Metabot necessita suport de sortida estructurada per als títols de converses i la generació d'SQL."

#: metabase/metabot/self/vllm.clj
msgid "vLLM API error (HTTP {0})"
msgstr "vLLM API error (HTTP {0})"

#: metabase/metabot/self/vllm.clj
msgid "Check that {0} is a vLLM server''s OpenAI-compatible API — the base URL should end in /v1."
msgstr "Comprova que {0} sigui l'API compatible amb OpenAI d'un servidor vLLM — l'URL base hauria d'acabar en /v1."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} ha transmès el seu raonament com a text de xat. Reinicia vLLM amb --reasoning-parser perquè el pensament no aparegui dins les respostes de Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server at {0} did not respond within {1}ms. Check that it is running and not overloaded."
msgstr "El servidor vLLM a {0} no ha respost en {1}ms. Comprova que estigui en execució i que no estigui sobrecarregat."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is not serving {0}. It is serving: {1}."
msgstr "El servidor vLLM no està servint {0}. Està servint: {1}."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} ha arribat al límit del test de connexió de {1} tokens abans d'acabar una crida d'eina. Un model que genera tant abans de cridar una eina és massa lent per fer anar Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not answer the connection test within {0}ms. Check that it is not overloaded — a server this slow to answer a trivial prompt cannot drive Metabot."
msgstr "El servidor vLLM no ha respost al test de connexió en {0}ms. Comprova que no estigui sobrecarregat — un servidor tan lent per respondre a un prompt trivial no pot fer anar Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "El servidor vLLM ha retornat una crida d'eina els arguments de la qual no són JSON vàlid. El --tool-call-parser probablement no coincideix amb el format de sortida de {0}."

#: metabase/metabot/self/vllm.clj
msgid "The connection to the vLLM server was interrupted before the response finished."
msgstr "La connexió amb el servidor vLLM s'ha interromput abans que acabés la resposta."

#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} se serveix amb una finestra de context de {1} tokens, que és massa petita per a Metabot — en necessita com a mínim {2}. Reinicia vLLM amb un --max-model-len més gran."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server stopped responding after {0}ms. Raise the vLLM request timeout, or serve a faster model."
msgstr "El servidor vLLM ha deixat de respondre després de {0}ms. Augmenta el temps d'espera de sol·licitud de vLLM o serveix un model més ràpid."

#: metabase/metabot/self/vllm.clj
msgid "No vLLM base URL is set"
msgstr "No s'ha establert cap URL base de vLLM"

#: metabase/metabot/self/vllm.clj
msgid "Could not reach the vLLM server at {0}. Check that it is running and that the base URL is correct."
msgstr "No s'ha pogut arribar al servidor vLLM a {0}. Comprova que estigui en execució i que l'URL base sigui correcte."

#: metabase/metabot/self/vllm.clj
msgid "No vLLM model is set"
msgstr "No s'ha establert cap model de vLLM"

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "El servidor vLLM no ha respectat una crida d'eina forçada. Metabot necessita suport de sortida estructurada per als títols de converses i la generació d'SQL."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server is reachable but is not serving any models."
msgstr "El servidor vLLM és accessible però no està servint cap model."

#: metabase/metabot/self/vllm.clj
msgid "vLLM API key expired or invalid — check the key your server was started with via --api-key"
msgstr "vLLM API key expired or invalid — comprova la clau amb què es va iniciar el servidor via --api-key"

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} ha gastat tot el pressupost del test de connexió de {1} tokens raonant sense cridar cap eina. Un model que pensa tant sobre un prompt trivial és massa lent per fer anar Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "El servidor vLLM ha respost amb text en lloc de cridar una eina. Reinicia'l amb --enable-auto-tool-choice i un --tool-call-parser que coincideixi amb el format de sortida de {0}."

#: metabase/metabot/self/zai.clj
msgid "Z.AI API key expired or invalid"
msgstr "La clau d’API de Z.AI ha caducat o no és vàlida"

#: metabase/metabot/self/zai.clj
msgid "Z.AI has rate limited us"
msgstr "Z.AI ens ha aplicat límit de taxa"

#: metabase/metabot/self/zai.clj
msgid "AI proxy is not supported for Z.AI"
msgstr "El proxy d’IA no és compatible amb Z.AI"

#: metabase/metabot/self/zai.clj
msgid "Z.AI returned an internal server error"
msgstr "Z.AI ha retornat un error intern del servidor"

#: metabase/metabot/self/zai.clj
