{
  "get": {
    "description": "Paginated unified run history: every row is a root run — a job run, a manual DAG-reprocess run,\n  or a standalone transform run — never a member run of a job/DAG (those are listed by `GET /run`\n  and the per-run `transform-runs` endpoints).\n\n  `types` selects which kinds to include (all by default); `transform-ids` narrows to runs that ran\n  any of the given transforms. The remaining filters work as in `GET /run`.",
    "operationId": "get-api-transform-runs",
    "parameters": [
      {
        "in": "query",
        "name": "types",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "items": {
                "enum": [
                  "job",
                  "dag",
                  "transform"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "statuses",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "items": {
                "enum": [
                  "started",
                  "succeeded",
                  "failed",
                  "timeout",
                  "canceled",
                  "canceling"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "run-methods",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "items": {
                "enum": [
                  "manual",
                  "cron"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "start-time",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "end-time",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "transform-ids",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "items": {
                "description": "value must be an integer greater than zero.",
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "sort-column",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "enum": [
                "start_time",
                "end_time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "sort-direction",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": false,
              "properties": {
                "data": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "direction": {
                        "oneOf": [
                          {
                            "enum": [
                              "upstream",
                              "downstream"
                            ],
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "end_time": {
                        "oneOf": [
                          {},
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "entity_id": {
                        "oneOf": [
                          {
                            "minimum": 1,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "id": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "is_active": {
                        "oneOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "message": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "name": {
                        "oneOf": [
                          {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "anyOf": [
                                  {},
                                  {}
                                ]
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "run_method": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "run_type": {
                        "enum": [
                          "job",
                          "dag",
                          "transform"
                        ],
                        "type": "string"
                      },
                      "start_time": {},
                      "status": {
                        "enum": [
                          "started",
                          "succeeded",
                          "failed",
                          "timeout",
                          "canceled",
                          "canceling"
                        ],
                        "type": "string"
                      },
                      "transform_count": {
                        "oneOf": [
                          {
                            "minimum": 1,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "user_id": {
                        "oneOf": [
                          {
                            "minimum": 1,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "run_type",
                      "id",
                      "entity_id",
                      "name",
                      "direction",
                      "transform_count",
                      "run_method",
                      "status",
                      "is_active",
                      "start_time",
                      "message",
                      "user_id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "limit": {
                  "minimum": 1,
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "required": [
                "data",
                "limit",
                "offset",
                "total"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/transform/runs",
    "tags": [
      "/api/transform"
    ]
  }
}
