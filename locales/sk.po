#: metabase_enterprise/remote_sync/settings.clj
msgid "Is Git sync currently enabled?"
msgstr "Je synchronizácia s Gitom momentálne zapnutá?"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The remote branch to sync with, e.g. `main`"
msgstr "Vzdialený branch na synchronizáciu, napr. `main`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "An Authorization Bearer token allowing access to the git repo over HTTP"
msgstr "Authorization Bearer token umožňujúci prístup k git repozitáru cez HTTP"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The location of your git repository, e.g. https://github.com/acme-inco/metabase.git"
msgstr "Umiestnenie vášho git repozitára, napr. https://github.com/acme-inco/metabase.git"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Git synchronization type - :read-write or :read-only"
msgstr "Typ synchronizácie Gitu - :read-write alebo :read-only"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to automatically import from the remote git repository. Only applies if remote-sync-type is :read-only."
msgstr "Či automaticky importovať zo vzdialeného git repozitára. Platí iba ak je remote-sync-type :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Ak je remote-sync-type :read-only a remote-sync-auto-import je true, frekvencia (v minútach), ako často kontrolovať aktualizácie na import. Predvolene 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The maximum amount of time a remote sync task will be given to complete"
msgstr "Maximálny čas, ktorý bude mať úloha vzdialenej synchronizácie na dokončenie"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Sieťový timeout (v sekundách) pre vzdialené git operácie ako fetch, push, clone a ls-remote. Zaseknuté pripojenie by inak mohlo sync zablokovať na neurčito."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Či sa majú transformácie synchronizovať cez remote-sync. Keď je to povolené, všetky transformácie, tagy transformácií a joby transformácií sa synchronizujú ako jedna jednotka (všetko alebo nič)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live v sekundách pre cache kontroly vzdialených zmien. Predvolená hodnota je 60 sekúnd."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Allow specific remote sync behaviors. Set to overwrite-unpublished to allow overwriting unpublished changes on startup."
msgstr "Povoľte špecifické správania vzdialenej synchronizácie. Nastavte na overwrite-unpublished, aby bolo možné pri štarte prepísať nepublikované zmeny."

