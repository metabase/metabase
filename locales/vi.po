msgid "Choose the message to show while a query is running. Possible values are \"doing-science\", \"running-query\", or \"loading-results\""
msgstr "Chọn thông báo để hiển thị khi truy vấn đang chạy. Các giá trị có thể là \"doing-science\", \"running-query\", hoặc \"loading-results\""

