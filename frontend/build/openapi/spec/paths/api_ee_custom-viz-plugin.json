  "post": {
    "description": "Register a new custom visualization plugin from an uploaded tar.gz bundle.\n\n  The archive must contain `metabase-plugin.json` at the root and\n  `dist/index.js` for the JS bundle. The only static asset served from the bundle\n  is the manifest `icon` (under `dist/assets/`); plugins do not ship arbitrary\n  assets. The plugin's `identifier` is taken from the manifest's `name` field.",
    "operationId": "post-api-ee-custom-viz-plugin",
    "parameters": [],
    "requestBody": {
      "content": {
        "multipart/form-data": {
          "schema": {
            "properties": {
