msgstr "Sama ada Metabot didayakan untuk penggunaan biasa."

#: metabase/metabot/settings.clj
msgid "The display name for Metabot, shown throughout the Metabase UI."
msgstr "Nama paparan untuk Metabot, ditunjukkan di seluruh UI Metabase."

#: metabase/metabot/settings.clj
msgid "The icon for Metabot. Set to `metabot` for the default icon, or a data URI for a custom uploaded image (up to 1MB)."
msgstr "Ikon untuk Metabot. Tetapkan kepada `metabot` untuk ikon lalai, atau data URI untuk imej tersuai yang dimuat naik (sehingga 1MB)."

#: metabase/metabot/settings.clj
msgid "Whether to show Metabot illustrations in the UI."
msgstr "Sama ada untuk menunjukkan ilustrasi Metabot dalam UI."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the chat experience (the AI sidebar and embedded Metabot)."
msgstr "Arahan tersuai yang ditambah pada prompt sistem Metabot untuk pengalaman chat (sidebar AI dan Metabot terbenam)."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the natural language query (AI exploration) experience."
msgstr "Arahan tersuai yang ditambah pada prompt sistem Metabot untuk pengalaman kueri bahasa semula jadi (penerokaan AI)."

#: metabase/metabot/settings.clj
msgid "Custom instructions appended to Metabot''s system prompt for the SQL generation experience."
msgstr "Arahan tersuai yang ditambah pada prompt sistem Metabot untuk pengalaman penjanaan SQL."

#: metabase/metabot/settings.clj
msgid "Whether Metabot is enabled for embedding."
msgstr "Sama ada Metabot didayakan untuk pembenaman."

