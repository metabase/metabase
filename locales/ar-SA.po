msgstr "العمود أو النص لتبدأ."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "value2"
msgstr "القيمة2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "This will be added to the end of `$value1`."
msgstr "سيتم إضافة هذا إلى نهاية `$value1`."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "This will be added to the end of `$value2`, and so on."
msgstr "سيتم إضافة هذا إلى نهاية `$value2`، وهكذا."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "First Name"
msgstr "الاسم الأول"

