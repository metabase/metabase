#: metabase_enterprise/remote_sync/settings.clj
msgid "Is Git sync currently enabled?"
msgstr "Vai Git sinhronizācija pašlaik ir iespējota?"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The remote branch to sync with, e.g. `main`"
msgstr "Attālais atzars, ar ko sinhronizēt, piem., `main`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "An Authorization Bearer token allowing access to the git repo over HTTP"
msgstr "Authorization Bearer tokens, kas ļauj piekļūt git repozitorijam caur HTTP"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The location of your git repository, e.g. https://github.com/acme-inco/metabase.git"
msgstr "Jūsu git repozitorija atrašanās vieta, piem., https://github.com/acme-inco/metabase.git"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Git synchronization type - :read-write or :read-only"
msgstr "Git sinhronizācijas tips - :read-write vai :read-only"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to automatically import from the remote git repository. Only applies if remote-sync-type is :read-only."
msgstr "Vai automātiski importēt no attālā git repozitorija. Attiecas tikai, ja remote-sync-type ir :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Ja remote-sync-type ir :read-only un remote-sync-auto-import ir true, biežums (minūtēs), cik bieži pārbaudīt atjauninājumus importēšanai. Noklusējums ir 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The maximum amount of time a remote sync task will be given to complete"
msgstr "Maksimālais laiks, kas attālās sinhronizācijas uzdevumam tiek dots izpildei"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Tīkla taimauts (sekundēs) attālām git darbībām, piemēram, fetch, push, clone un ls-remote. Pretējā gadījumā iestrēgusi savienojuma dēļ sinhronizācija varētu iestrēgt uz nenoteiktu laiku."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Vai sinhronizēt pārveidojumus, izmantojot remote-sync. Ja ieslēgts, visi pārveidojumi, pārveidojumu birkas un pārveidojumu darbi tiek sinhronizēti kā viena vienība (viss vai nekas)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live sekundēs attālo izmaiņu pārbaudes kešatmiņai. Noklusējums ir 60 sekundes."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Allow specific remote sync behaviors. Set to overwrite-unpublished to allow overwriting unpublished changes on startup."
msgstr "Atļaut konkrētas attālās sinhronizācijas darbības. Iestatiet uz overwrite-unpublished, lai startējot atļautu pārrakstīt nepublicētas izmaiņas."

