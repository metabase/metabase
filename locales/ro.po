msgstr "Colecția unei aplicații de date este sincronizată cu aplicația ei și nu poate fi marcată ca sincronizată."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Is Git sync currently enabled?"
msgstr "Este activată în prezent sincronizarea Git?"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The remote branch to sync with, e.g. `main`"
msgstr "Branch-ul remote cu care să se sincronizeze, de ex. `main`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "An Authorization Bearer token allowing access to the git repo over HTTP"
msgstr "Un token Authorization Bearer care permite acces la repo-ul git prin HTTP"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The location of your git repository, e.g. `https://github.com/acme-inco/metabase.git`"
msgstr "Locația repository-ului tău git, de ex. `https://github.com/acme-inco/metabase.git`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Git synchronization type - :read-write or :read-only"
msgstr "Tip de sincronizare Git - :read-write sau :read-only"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to automatically import from the remote git repository. Only applies if remote-sync-type is :read-only."
msgstr "Dacă să se importe automat din repo-ul git remote. Se aplică doar dacă remote-sync-type este :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Dacă remote-sync-type este :read-only și remote-sync-auto-import este true, frecvența (în minute) la care să verifice actualizări de importat. Implicit 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "How long a remote sync task may go without proving its process is alive (via heartbeat, or progress on rows without one) before it is treated as dead and superseded. A slow but live task is never affected. The task itself is aborted after ten times this limit."
msgstr "Cât timp poate o sarcină de sincronizare la distanță să meargă fără să dovedească faptul că procesul ei este activ (prin heartbeat sau prin progres pe rânduri fără heartbeat) înainte să fie considerată moartă și înlocuită. O sarcină lentă, dar activă, nu este niciodată afectată. Sarcina în sine este întreruptă după de zece ori acest prag."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Timeout de rețea (în secunde) pentru operațiuni git remote precum fetch, push, clone și ls-remote. Altfel, o conexiune blocată ar face ca o sincronizare să rămână suspendată pe termen nelimitat."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, transforms, transform tags, transform tests, Python libraries, and transforms folders are synced."
msgstr "Dacă să se sincronizeze transformările prin remote-sync. Când este activată, se sincronizează transformările, etichetele de transformări, testele de transformări, bibliotecile Python și folderele de transformări."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Stop syncing the collections besides the Library, transforms, snippets and data apps before turning off remote-sync-custom-collections-enabled."
msgstr ""

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether remote sync can sync collections besides the Library, transforms, snippets and data apps. When off, no other collection can be marked as synced, and a pull or a serialization import refuses content with other synced collections, so set `MB_REMOTE_SYNC_CUSTOM_COLLECTIONS_ENABLED=true` on an instance that pulls or imports such content. It can only be turned off once no other collection is synced."
msgstr ""

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live în secunde pentru cache-ul verificării modificărilor remote. Implicit este 60 de secunde."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Allow specific remote sync behaviors. Set to overwrite-unpublished to allow overwriting unpublished changes on startup."
msgstr "Permite anumite comportamente de sincronizare la distanță. Setează la overwrite-unpublished pentru a permite suprascrierea modificărilor nepublicate la pornire."

