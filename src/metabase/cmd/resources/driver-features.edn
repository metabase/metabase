;; The hand-curated half of `docs/databases/feature-support.md`. The other half, which database supports which
;; feature, comes from each driver's `driver/database-supports?` methods. See [[metabase.cmd.driver-feature-dox]].
;;
;; Every keyword in `metabase.driver/features` goes in exactly one place: a section's `:features`, or `:internal`.
;; `metabase.cmd.driver-feature-dox-test` fails until a new keyword is classified.
;;
;; `:drivers` are the table columns, in page order.
;;   - `:dbms-version` is merged into both of the fake databases the driver is asked about. It turns a driver into a
;;     variant, like MariaDB, which is the `:mysql` driver with a different flavor.
;;   - `:newest` and `:oldest` replace the default `:semantic-version` of the two fake databases, for drivers that
;;     store their version in another shape.
;;   - `:notes` explain a cell that is supported on the newest database but not on the oldest one, keyed by feature.
;;     A note is a sentence that names the database, since the notes print below the table.
;;
;; `:sections` are the tables, in page order. A row's `:feature` is a keyword, or a vector of keywords when the page
;; treats several driver features as one; a database supports the row when it supports any of them. `:doc` paths are
;; relative to `docs/databases/`.
{:drivers
 [{:driver :athena             :label "Athena"}
  {:driver :bigquery-cloud-sdk :label "BigQuery"}
  {:driver :clickhouse         :label "ClickHouse"
   :newest {:semantic-version {:major 999 :minor 0}}
   :oldest {:semantic-version {:major 1 :minor 0}}
   :notes  {:uploads                  "ClickHouse Cloud only."
            :connection-impersonation "ClickHouse 24.4 and later."}}
  {:driver :databricks         :label "Databricks"}
  {:driver :druid-jdbc         :label "Druid"}
  {:driver :mongo              :label "MongoDB"
   :notes  {:expressions                 "MongoDB 4.2 and later."
            :now                         "MongoDB 4.2 and later."
            :date-arithmetics            "MongoDB 5.0 and later."
            :datetime-diff               "MongoDB 5.0 and later."
            :window-functions/cumulative "MongoDB 5.0 and later."}}
  {:driver :mysql              :label "MariaDB"
   :dbms-version {:flavor "MariaDB"}}
  {:driver :mysql              :label "MySQL"
   :dbms-version {:flavor "MySQL"}}
  {:driver :oracle             :label "Oracle"}
  {:driver :postgres           :label "PostgreSQL"}
  {:driver :presto-jdbc        :label "Presto"}
  {:driver :redshift           :label "Redshift"}
  {:driver :snowflake          :label "Snowflake"}
  {:driver :sparksql           :label "SparkSQL"}
  {:driver :sqlserver          :label "SQL Server"
   :notes  {:percentile-aggregations "SQL Server 2022 (version 16) and later."}}
  {:driver :sqlite             :label "SQLite"}
  {:driver :starburst          :label "Starburst"}
  {:driver :vertica            :label "Vertica"}]

