#: metabase/metabot/self/vllm.clj
msgid "{0} is served with a {1} token context window, which is too small for Metabot — it needs at least {2}. Restart vLLM with a larger --max-model-len."
msgstr "{0} je poskytovaný s kontextovým oknom {1} tokenov, čo je pre Metabot príliš málo — potrebuje aspoň {2}. Reštartujte vLLM s väčším --max-model-len."

#: metabase/metabot/self/vllm.clj
msgid "{0} streamed its reasoning as chat text. Restart vLLM with --reasoning-parser so thinking doesn''t appear inside Metabot''s answers."
msgstr "{0} streamoval svoje uvažovanie ako text v chate. Reštartujte vLLM s --reasoning-parser, aby sa „thinking“ nezobrazovalo v odpovediach Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling partway through a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} dosiahol strop {1} tokenov pre connection-test uprostred volania nástroja. Model, ktorý pred volaním nástroja generuje toľko, je príliš pomalý na používanie Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server returned a tool call whose arguments are not valid JSON. The --tool-call-parser most likely does not match {0}''s output format."
msgstr "Server vLLM vrátil volanie nástroja, ktorého argumenty nie sú platný JSON. --tool-call-parser sa s najväčšou pravdepodobnosťou nezhoduje s výstupným formátom {0}."

#: metabase/metabot/self/vllm.clj
msgid "{0} spent the entire {1} token connection-test budget reasoning without calling a tool. A model that thinks this long about a trivial prompt is too slow to drive Metabot."
msgstr "{0} strávil celý rozpočet {1} tokenov pre connection-test uvažovaním bez volania nástroja. Model, ktorý nad triviálnym promptom premýšľa tak dlho, je príliš pomalý na používanie Metabot."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling before completing a tool call. A model that generates this much before calling a tool is too slow to drive Metabot."
msgstr "{0} dosiahol strop {1} tokenov pre connection-test pred dokončením volania nástroja. Model, ktorý pred volaním nástroja generuje toľko, je príliš pomalý na používanie Metabot."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server answered with text instead of calling a tool. Restart it with --enable-auto-tool-choice and a --tool-call-parser matching {0}''s output format."
msgstr "Server vLLM odpovedal textom namiesto volania nástroja. Reštartujte ho s --enable-auto-tool-choice a --tool-call-parser, ktorý zodpovedá výstupnému formátu {0}."

#: metabase/metabot/self/vllm.clj
msgid "{0} reached the {1} token connection-test ceiling without producing a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "{0} dosiahol strop {1} tokenov pre connection-test bez toho, aby vytvoril vynútené volanie nástroja. Metabot potrebuje podporu štruktúrovaného výstupu pre názvy konverzácií a generovanie SQL."

#: metabase/metabot/self/vllm.clj
msgid "The vLLM server did not honor a forced tool call. Metabot needs structured output support for conversation titles and SQL generation."
msgstr "Server vLLM nerešpektoval vynútené volanie nástroja. Metabot potrebuje podporu štruktúrovaného výstupu pre názvy konverzácií a generovanie SQL."

#: metabase/metabot/self/vllm.clj
