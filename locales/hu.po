msgstr "Az OpenRouter API-kulcs jogosultságai nem elegendőek"

#: metabase/metabot/self/openrouter.clj
msgid "OpenRouter API error (HTTP {0})"
msgstr "OpenRouter API hiba (HTTP {0})"

#: metabase/metabot/self/openrouter.clj
msgid "OpenRouter API key expired or invalid"
msgstr "Az OpenRouter API-kulcs lejárt vagy érvénytelen"

#: metabase/metabot/self/openrouter.clj
msgid "AI proxy is not supported for OpenRouter"
msgstr "Az OpenRouter nem támogatja az MI proxyt"

#: metabase/metabot/self/openrouter.clj
