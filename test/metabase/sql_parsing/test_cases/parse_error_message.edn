{:cases
 [{:name       "a keyword the parser was still waiting for"
   :dialect    "postgres"
   :sql        "SELECT !!!"
   :internals  "<class 'sqlglot.expressions.core.Not'>"
   :diagnostic "ParseError: Required keyword: 'this' missing. Line 1, Col: 10.\n  SELECT !!!\n           ^"}

  {:name       "a token where a table name belonged"
   :dialect    "postgres"
   :sql        "SELECT * FROM WHERE ("
   :internals  "<Token token_type: TokenType.WHERE, text: WHERE,"
   :diagnostic "ParseError: Expected table name but got 'WHERE'. Line 1, Col: 19.\n  SELECT * FROM WHERE (\n                ^^^^^"}

  {:name       "the end of the query where a table name belonged"
   :dialect    "postgres"
   :sql        "SELECT * FROM a JOIN"
   :internals  "<Token token_type: TokenType.SENTINEL"
   :diagnostic "ParseError: Expected table name but got the end of the query. Line 1, Col: 20.\n  SELECT * FROM a JOIN\n                  ^^^^"}

  {:name       "a query that is not SQL at all"
   :dialect    "postgres"
   :sql        "complete nonsense query"
   :internals  "["
   :diagnostic "ParseError: Invalid expression / Unexpected token. Line 1, Col: 23.\n  complete nonsense query\n                    ^^^^^"}

  {:name       "a greater-than sign where a table name belonged"
   :dialect    "postgres"
   :sql        "SELECT * FROM >"
   :internals  "<Token token_type: TokenType.GT, text: >,"
   :diagnostic "ParseError: Expected table name but got '>'. Line 1, Col: 15.\n  SELECT * FROM >\n                ^"}

  {:name       "a greater-than-or-equal sign where a table name belonged"
   :dialect    "postgres"
   :sql        "SELECT * FROM >="
   :internals  "<Token token_type: TokenType.GTE, text: >=,"
   :diagnostic "ParseError: Expected table name but got '>='. Line 1, Col: 16.\n  SELECT * FROM >=\n                ^^"}

  {:name       "a comma where a table name belonged"
   :dialect    "postgres"
   :sql        "SELECT * FROM ,"
   :internals  "<Token token_type: TokenType.COMMA, text: ,,"
   :diagnostic "ParseError: Expected table name but got ','. Line 1, Col: 15.\n  SELECT * FROM ,\n                ^"}

  {:name       "a token on the second of three lines"
   :dialect    "postgres"
   :sql        "SELECT 1\nFROM WHERE venues\nLIMIT 1"
   :internals  "<Token token_type: TokenType.WHERE, text: WHERE, line: 2,"
   :diagnostic "ParseError: Expected table name but got 'WHERE'. Line 2, Col: 10.\n  SELECT 1\nFROM WHERE venues\n     ^^^^^\nLIMIT 1"}]}
