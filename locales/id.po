msgid "string1"
msgstr "string1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The column or text to check."
msgstr "Kolom atau teks yang akan diperiksa."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "string2"
msgstr "string2"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "The string of text to look for."
msgstr "String teks yang ingin dicari."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Small"
msgstr "Kecil"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "You can add more values to look for."
msgstr "Anda dapat menambahkan lebih banyak nilai untuk dicari."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Optional. Set to `\"case-insensitive\"` to perform a case-insensitive match."
msgstr "Opsional. Setel ke `\"case-insensitive\"` untuk melakukan pencocokan tanpa membedakan huruf besar/kecil."

