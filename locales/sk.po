msgstr "Verzia DB {0} pre Metabase nie je podporovaná (nájdené {1}, vyžadované {2}). Aktualizujte prosím databázu na podporovanú verziu a skúste to znova."

#: metabase/app_db/setup.clj
msgid "ERROR: Downgrade detected."
msgstr "ERROR: Zistený downgrade."

#: metabase/app_db/setup.clj
msgid "Your metabase instance appears to have been downgraded without a corresponding database downgrade."
msgstr "Zdá sa, že vaša inštancia metabase bola downgradovaná bez zodpovedajúceho downgradu databázy."

#: metabase/app_db/setup.clj
msgid "You must run `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate down` from version {0}."
msgstr "Musíte spustiť `java --add-opens java.base/java.nio=ALL-UNNAMED -jar metabase.jar migrate down` z verzie {0}."

#: metabase/app_db/setup.clj
msgid "Once your database has been downgraded, try running the application again."
msgstr "Keď bude vaša databáza downgradovaná, skúste aplikáciu spustiť znova."

#: metabase/app_db/setup.clj
msgid "See: https://www.metabase.com/docs/latest/installation-and-operation/upgrading-metabase#rolling-back-an-upgrade"
msgstr "Pozri: https://www.metabase.com/docs/latest/installation-and-operation/upgrading-metabase#rolling-back-an-upgrade"

#: metabase/app_db/setup.clj
msgid "Database setup"
msgstr "Nastavenie databázy"

#: metabase/appearance/settings.clj
