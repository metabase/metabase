msgid "Failed setting `query-caching-max-kb` to {0}."
msgstr "Không thể đặt `query-caching-max-kb` thành {0}."

#: metabase/cache/settings.clj
msgid "Values greater than {0} ({1}) are not allowed."
msgstr "Không cho phép các giá trị lớn hơn {0} ({1})."

#: metabase/cache/settings.clj
msgid "Refresh cached results this fraction of their cache duration before they expire, so requests keep being served from cache instead of waiting for a recomputation. Set to 0 to only refresh once results have expired."
msgstr "Làm mới các kết quả đã cache trước khi hết hạn theo tỷ lệ này của thời lượng cache, để các yêu cầu tiếp tục được phục vụ từ cache thay vì phải chờ tính toán lại. Đặt thành 0 để chỉ làm mới sau khi kết quả đã hết hạn."

#: metabase/cache/settings.clj
msgid "The maximum size of the cache, per saved question, in kilobytes:"
msgstr "Kích thước tối đa của cache, cho mỗi Câu hỏi đã lưu, tính bằng kilobyte:"

#: metabase/cache/settings.clj
msgid "The absolute maximum time to keep any cached query results, in seconds."
msgstr "Thời gian tối đa tuyệt đối để giữ bất kỳ kết quả truy vấn đã cache nào, tính bằng giây."

#: metabase/cache/settings.clj
