{
  "allOf": [
    {
      "description": "Valid MBQL 5 query.",
      "properties": {
        "constraints": {
          "$ref": "./metabase.lib.schema.constraints.constraints.json"
        },
        "create-row": {
          "$ref": "./metabase.lib.schema.actions.row.json"
        },
        "database": {
          "oneOf": [
            {
              "$ref": "./metabase.lib.schema.id.saved-questions-virtual-database.json"
            },
            {
              "$ref": "./metabase.lib.schema.id.database.json"
            }
          ]
        },
        "info": {
          "$ref": "./metabase.lib.schema.info.info.json"
        },
        "lib/metadata": {
          "$ref": "./metabase.lib.schema.metadata.metadata-provider.json"
        },
        "lib/type": {
          "const": "mbql/query",
          "default": "mbql/query"
        },
        "middleware": {
          "$ref": "./metabase.lib.schema.middleware-options.middleware-options.json"
        },
        "parameters": {
          "$ref": "./metabase.lib.schema.parameter.parameters.json"
        },
        "pivot-cols": {
          "oneOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "pivot-measures": {
          "oneOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "pivot-rows": {
          "oneOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "$ref": "./metabase.lib.schema.settings.settings.json"
        },
        "show-column-totals": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "show-row-totals": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "stages": {
          "$ref": "./metabase.lib.schema.stages.json"
        },
        "update-row": {
          "$ref": "./metabase.lib.schema.actions.row.json"
        },
        "was-pivot": {
          "description": "Whether this query was originally run as a pivot query. Stamped into the saved `json_query` by\n  `metabase.query-processor.middleware.process-userland-query` and sent back by clients re-downloading pivot query\n  results.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stages"
      ],
      "type": "object"
    },
    {
      "$ref": "./metabase.lib.schema.util.unique-uuids.json"
    },
    {
      "$ref": "./metabase.lib.schema.pivot-only-on-last-stage.json"
    },
    {
      "allOf": []
    }
  ]
}
