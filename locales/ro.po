msgstr "Moonshot a respins cererea — verifică modelul și parametrii cererii"

#: metabase/metabot/self/moonshot.clj
msgid "Moonshot API key expired or invalid"
msgstr "Cheia API Moonshot a expirat sau este invalidă"

#: metabase/metabot/self/moonshot.clj
