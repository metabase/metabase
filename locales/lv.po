#: metabase/tracing/settings.clj
msgid "Enable OpenTelemetry tracing. When true, spans are exported to the configured OTLP collector."
msgstr "Iespējot OpenTelemetry treisošanu. Ja ieslēgts, span tiek eksportēti uz konfigurēto OTLP kolektoru."

#: metabase/tracing/settings.clj
msgid "OTLP HTTP collector endpoint for trace export (e.g., http://localhost:4318/v1/traces)."
msgstr "OTLP HTTP kolektora galapunkts treisu eksportam (piem., http://localhost:4318/v1/traces)."

#: metabase/tracing/settings.clj
msgid "Comma-separated list of trace groups to enable, or \"all\" for everything."
msgstr "Ar komatiem atdalīts to treisu grupu saraksts, kuras iespējot, vai \"all\" visam."

#: metabase/tracing/settings.clj
msgid "Log level threshold during traced spans. When a span is active, log events at this level and above bypass per-logger level gates via Log4j2 DynamicThresholdFilter. Requires the filter in log4j2.xml. Valid values: \"INFO\", \"DEBUG\", \"TRACE\"."
msgstr "Žurnāla līmeņa slieksnis treisēto span laikā. Kad spans ir aktīvs, žurnāla notikumi šajā līmenī un augstāk apiet per-logger līmeņu vārtus, izmantojot Log4j2 DynamicThresholdFilter. Nepieciešams filtrs log4j2.xml. Derīgās vērtības: \"INFO\", \"DEBUG\", \"TRACE\"."

#: metabase/tracing/settings.clj
msgid "Maximum number of spans queued for export. When the queue is full, new spans are dropped silently. Controls memory usage when the collector is slow or unavailable."
msgstr "Maksimālais eksportam rindā ieliekamo span skaits. Kad rinda ir pilna, jaunie span tiek klusi atmesti. Kontrolē atmiņas patēriņu, kad kolektors ir lēns vai nav pieejams."

#: metabase/tracing/settings.clj
msgid "Maximum time in milliseconds to wait for a batch export to complete. If the collector is slow or unreachable, the batch is dropped after this timeout."
msgstr "Maksimālais gaidīšanas laiks milisekundēs, līdz pabeidzas pakešu eksports. Ja kolektors ir lēns vai nav sasniedzams, šis pakešu eksports pēc šī taimauta tiek atmests."

#: metabase/tracing/settings.clj
msgid "Delay in milliseconds between consecutive batch span exports to the collector."
msgstr "Aizture milisekundēs starp secīgiem pakešu span eksportiem uz kolektoru."

