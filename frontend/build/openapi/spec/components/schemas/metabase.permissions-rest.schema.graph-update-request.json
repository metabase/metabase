{
  "description": "the permissions graph, plus the sandboxes and connection impersonations to write with it",
  "properties": {
    "force": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "groups": {
      "oneOf": [
        {
          "additionalProperties": {
            "oneOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "$ref": "./metabase.permissions-rest.schema.db-perms.json"
                    },
                    {}
                  ]
                },
                "type": "object"
              },
              {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {}
                ]
              }
            ]
          },
          "type": "object"
        },
        {}
      ]
    },
    "impersonations": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.permissions-rest.schema.impersonation-update.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "oneOf": [
        {
          "description": "value must be an integer.",
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandboxes": {
      "oneOf": [
        {
          "items": {
            "$ref": "./metabase.permissions-rest.schema.sandbox-update.json"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "groups"
  ],
  "type": "object"
}
