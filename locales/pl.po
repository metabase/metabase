#: metabase_enterprise/remote_sync/settings.clj
msgid "Is Git sync currently enabled?"
msgstr "Czy synchronizacja Git jest obecnie włączona?"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The remote branch to sync with, e.g. `main`"
msgstr "Zdalna gałąź do synchronizacji, np. `main`"

#: metabase_enterprise/remote_sync/settings.clj
msgid "An Authorization Bearer token allowing access to the git repo over HTTP"
msgstr "Token Authorization Bearer umożliwiający dostęp do repozytorium git przez HTTP"

#: metabase_enterprise/remote_sync/settings.clj
msgid "The location of your git repository, e.g. https://github.com/acme-inco/metabase.git"
msgstr "Lokalizacja Twojego repozytorium git, np. https://github.com/acme-inco/metabase.git"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Git synchronization type - :read-write or :read-only"
msgstr "Typ synchronizacji Git - :read-write lub :read-only"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to automatically import from the remote git repository. Only applies if remote-sync-type is :read-only."
msgstr "Czy automatycznie importować ze zdalnego repozytorium git. Dotyczy tylko, jeśli remote-sync-type to :read-only."

#: metabase_enterprise/remote_sync/settings.clj
msgid "If remote-sync-type is :read-only and remote-sync-auto-import is true, the rate (in minutes) at which to check for updates to import. Defaults to 5."
msgstr "Jeśli remote-sync-type to :read-only i remote-sync-auto-import jest true, częstotliwość (w minutach) sprawdzania aktualizacji do importu. Domyślnie 5."

#: metabase_enterprise/remote_sync/settings.clj
msgid "The maximum amount of time a remote sync task will be given to complete"
msgstr "Maksymalny czas, jaki zadanie zdalnej synchronizacji ma na ukończenie"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Limit czasu sieci (w sekundach) dla zdalnych operacji git, takich jak fetch, push, clone i ls-remote. Zawieszone połączenie w przeciwnym razie blokowałoby synchronizację bez końca."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Czy synchronizować przekształcenia przez remote-sync. Po włączeniu wszystkie przekształcenia, tagi przekształceń i joby przekształceń są synchronizowane jako jedna całość (wszystko albo nic)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live w sekundach dla cache sprawdzania zdalnych zmian. Domyślnie 60 sekund."

#: metabase_enterprise/remote_sync/settings.clj
