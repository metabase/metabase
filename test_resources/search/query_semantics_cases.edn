;; S cases from the metabase-wiki identical-query corpus. Each map is an isolated
;; document set, shared by the in-place, app-db, and semantic test namespaces.
[{:id "S01"
  :focus "default multiword Boolean and cross-field matches"
  :config "simple"
  :query "amber cobalt"
  :docs {:A {:name "amber"}
         :B {:name "cobalt"}
         :C {:name "amber cobalt"}
         :D {:name "amber", :description "cobalt"}
         :E {:name "indigo"}}
  :expect {:in-place [:A :B :C :D]
           :appdb-h2 [:C :D]
           :appdb-postgres [:C :D]
           :keyword [:C :D]
           :vector []
           :semantic [:C :D]}}
 {:id "S02"
  :focus "infix substring versus lexeme-start completion"
  :config "simple"
  :query "hat"
  :docs {:A {:name "chatty"}
         :B {:name "hatter"}
         :C {:name "top hat"}
         :D {:name "coat"}}
  :expect {:in-place [:A :B :C]
           :appdb-h2 [:A :B :C]
           :appdb-postgres [:B :C]
           :keyword [:B :C]
           :vector []
           :semantic [:B :C]}}
 {:id "S03"
  :focus "last-word prefix versus arbitrary substring"
  :config "simple"
  :query "amber co"
  :docs {:A {:name "amber cobalt"}
         :B {:name "amber corgi"}
         :C {:name "amber taco"}
         :D {:name "amber"}
         :E {:name "co amber"}}
  :expect {:in-place [:A :B :C :D :E]
           :appdb-h2 [:A :B :C :E]
           :appdb-postgres [:A :B :E]
           :keyword [:A :B :E]
           :vector []
           :semantic [:A :B :E]}}
 {:id "S04"
  :focus "only the final PostgreSQL word is prefix-completed"
  :config "simple"
  :query "amb cobalt"
  :docs {:A {:name "amber cobalt"}
         :B {:name "amb cobalt"}
         :C {:name "amber macobalt"}
         :D {:name "cobalt"}}
  :expect {:in-place [:A :B :C :D]
           :appdb-h2 [:A :B :C]
           :appdb-postgres [:B]
           :keyword [:B]
           :vector []
           :semantic [:B]}}
 {:id "S05"
  :focus "unquoted or operator versus literal substring"
  :config "simple"
  :query "amber or cobalt"
  :docs {:A {:name "amber"}
         :B {:name "cobalt"}
         :C {:name "amber cobalt"}
         :D {:name "amber or cobalt"}
         :E {:name "orbit"}}
  :expect {:in-place [:A :B :C :D :E]
           :appdb-h2 [:D]
           :appdb-postgres [:A :B :C :D]
           :keyword [:A :B :C :D]
           :vector []
           :semantic [:A :B :C :D]}}
 {:id "S06"
  :focus "leading hyphen negation"
  :config "simple"
  :query "amber -cobalt"
  :docs {:A {:name "amber"}
         :B {:name "amber cobalt"}
         :C {:name "cobalt"}
         :D {:name "amber -cobalt"}}
  :expect {:in-place [:A :B :D]
           :appdb-h2 [:D]
           :appdb-postgres [:A]
           :keyword [:A]
           :vector []
           :semantic [:A]}}
 {:id "S07"
  :focus "ordered phrase, including the name/searchable-text boundary"
  :config "simple"
  :query "\"amber cobalt\""
  :docs {:A {:name "amber cobalt"}
         :B {:name "amber bright cobalt"}
         :C {:name "cobalt amber"}
         :D {:name "\"amber cobalt\""}}
  :expect {:in-place [:D]
           :appdb-h2 [:D]
           :appdb-postgres [:A :C :D]
           :keyword [:A :C :D]
           :vector []
           :semantic [:A :C :D]}}
 {:id "S08"
  :focus "unquoted and is discarded only by the tsquery parser"
  :config "simple"
  :query "amber and cobalt"
  :docs {:A {:name "amber cobalt"}
         :B {:name "amber and cobalt"}
         :C {:name "amber and"}
         :D {:name "cobalt"}
         :E {:name "and"}}
  :expect {:in-place [:A :B :C :D :E]
           :appdb-h2 [:B]
           :appdb-postgres [:A :B]
           :keyword [:A :B]
           :vector []
           :semantic [:A :B]}}
