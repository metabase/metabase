msgstr "الجمع بين سلاسل أو أكثر من النص معا."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "value1"
msgstr "قيمة1"

#: frontend/src/metabase-lib/query/clauses/clauses.ts
