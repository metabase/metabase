{
  "get": {
    "description": "List OAuth dynamic client registration events (registered, approved, or denied), newest first.\n   Joins client info and, for decision events, the deciding user. Superuser only.",
    "operationId": "get-api-oauth-authorizations",
    "parameters": [
      {
        "in": "query",
        "name": "client-id",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      {
        "in": "query",
        "name": "event-type",
        "required": false,
        "schema": {
          "oneOf": [
            {
              "enum": [
                "registered",
                "approved",
                "denied"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "data": {
                  "items": {
                    "properties": {},
                    "type": "object"
                  },
                  "type": "array"
                },
                "limit": {
                  "description": "value must be an integer greater than zero.",
                  "minimum": 1,
                  "type": "integer"
                },
                "offset": {
                  "description": "value must be an integer greater or equal to than zero.",
                  "minimum": 0,
                  "type": "integer"
                },
                "total": {
                  "description": "value must be an integer greater or equal to than zero.",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "total",
                "limit",
                "offset",
                "data"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/oauth/authorizations",
    "tags": [
      "/api/oauth"
    ]
  }
}
