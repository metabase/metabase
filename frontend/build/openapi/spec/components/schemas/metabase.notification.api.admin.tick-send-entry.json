{
  "additionalProperties": false,
  "description": "One tick's worth of sends, rolled up across all channels that fired in that tick.",
  "properties": {
    "at": {
      "format": "date-time",
      "type": "string"
    },
    "channels": {
      "items": {
        "$ref": "./metabase.notification.api.admin.channel-entry.json"
      },
      "type": "array"
    },
    "error": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "./metabase.notification.api.admin.run-status.json"
    }
  },
  "required": [
    "at",
    "status",
    "error",
    "channels"
  ],
  "type": "object"
}
