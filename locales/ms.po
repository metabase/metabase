msgstr "Tempoh masa maksimum yang diberikan kepada tugasan sync jauh untuk disiapkan"

#: metabase_enterprise/remote_sync/settings.clj
msgid "Network timeout (in seconds) for remote git operations such as fetch, push, clone, and ls-remote. A stalled connection would otherwise hang a sync indefinitely."
msgstr "Had masa tamat rangkaian (dalam saat) untuk operasi git jauh seperti fetch, push, clone dan ls-remote. Sambungan yang tersekat sebaliknya akan menyebabkan sync tergantung tanpa had."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Whether to sync transforms via remote-sync. When enabled, all transforms, transform tags, and transform jobs are synced as a single unit (all-or-nothing)."
msgstr "Sama ada hendak menyegerakkan transformasi melalui remote-sync. Apabila didayakan, semua transformasi, tag transformasi dan kerja transformasi akan disegerakkan sebagai satu unit (semua-atau-tiada)."

#: metabase_enterprise/remote_sync/settings.clj
msgid "Time-to-live in seconds for the remote changes check cache. Default is 60 seconds."
msgstr "Time-to-live dalam saat untuk cache semakan perubahan remote. Lalai ialah 60 saat."

#: metabase_enterprise/remote_sync/settings.clj
