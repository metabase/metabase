msgstr "Броят единици, които да се добавят."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
#, javascript-format
msgid "Choose from: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, or {8}."
msgstr "Изберете от: {0}, {1}, {2}, {3}, {4}, {5}, {6}, ${ 7 }, или {8}."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
msgid "Subtracts some units of time to a date or timestamp value."
msgstr "Изважда определени единици време от стойност дата или timestamp."

#: frontend/src/metabase-lib/query/clauses/clauses.ts
