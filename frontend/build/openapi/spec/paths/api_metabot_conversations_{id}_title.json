{
  "get": {
    "description": "Return the title generation status for a conversation.\n\n  Accessible to any participant in the conversation or to any superuser.",
    "operationId": "get-api-metabot-conversations-id-title",
    "parameters": [
      {
        "description": "value must be a valid UUID.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "pattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
          "type": "string"
        }
      }
    ],
    "responses": {
      "2XX": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "status": {
                  "enum": [
                    "ready",
                    "pending",
                    "missing"
                  ],
                  "type": "string"
                },
                "title": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "status",
                "title"
              ],
              "type": "object"
            }
          }
        },
        "description": "Successful response"
      },
      "4XX": {
        "description": "Client error response"
      },
      "5XX": {
        "description": "Server error response"
      }
    },
    "summary": "GET /api/metabot/conversations/{id}/title",
    "tags": [
      "/api/metabot/conversations"
    ]
  }
}
