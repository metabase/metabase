{:cases
 [{:name "a LEFT JOIN step counts the chain as written and with the join made INNER",
   :dialect "postgres",
   :sql "SELECT * FROM orders o LEFT JOIN people p ON p.id = o.user_id WHERE o.total > 10",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "orders"], :alias "o"},
    :base_sql "SELECT COUNT(*) AS n FROM orders AS o",
    :steps
    [{:source "table",
      :table [nil nil "people"],
      :alias "p",
      :strategy "left",
      :sql
      "SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM orders AS o LEFT JOIN people AS p ON p.id = o.user_id) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM orders AS o JOIN people AS p ON p.id = o.user_id) AS m"}]}}
  {:name "an INNER JOIN step counts the chain once, keeping a compound condition whole",
   :dialect "postgres",
   :sql "SELECT * FROM orders o JOIN products pr ON pr.id = o.product_id AND pr.category = 'Widget'",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "orders"], :alias "o"},
    :base_sql "SELECT COUNT(*) AS n FROM orders AS o",
    :steps
    [{:source "table",
      :table [nil nil "products"],
      :alias "pr",
      :strategy "inner",
      :sql
      "SELECT COUNT(*) AS n FROM orders AS o JOIN products AS pr ON pr.id = o.product_id AND pr.category = 'Widget'"}]}}
  {:name "a WITH clause is kept, and a join against a CTE or a derived table is described as one",
   :dialect "postgres",
   :sql
   "WITH c AS (SELECT id FROM people) SELECT * FROM orders o LEFT JOIN c ON c.id = o.user_id JOIN (SELECT id FROM products) d ON d.id = o.product_id",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "orders"], :alias "o"},
    :base_sql "WITH c AS (SELECT id FROM people) SELECT COUNT(*) AS n FROM orders AS o",
    :steps
    [{:source "cte",
      :table nil,
      :alias "c",
      :strategy "left",
      :sql
      "WITH c AS (SELECT id FROM people) SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM orders AS o LEFT JOIN c ON c.id = o.user_id) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM orders AS o JOIN c ON c.id = o.user_id) AS m"}
     {:source "derived",
      :table nil,
      :alias "d",
      :strategy "inner",
      :sql
      "WITH c AS (SELECT id FROM people) SELECT COUNT(*) AS n FROM orders AS o LEFT JOIN c ON c.id = o.user_id JOIN (SELECT id FROM products) AS d ON d.id = o.product_id"}]}}
  {:name "a CTE does not shadow a qualified table of the same name",
   :dialect "postgres",
   :sql "WITH orders AS (SELECT 1 AS id) SELECT * FROM public.orders JOIN orders x ON x.id = public.orders.id",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil "public" "orders"], :alias "orders"},
    :base_sql "WITH orders AS (SELECT 1 AS id) SELECT COUNT(*) AS n FROM public.orders",
    :steps
    [{:source "cte",
      :table nil,
      :alias "x",
      :strategy "inner",
      :sql
      "WITH orders AS (SELECT 1 AS id) SELECT COUNT(*) AS n FROM public.orders JOIN orders AS x ON x.id = public.orders.id"}]}}
  {:name "USING and NATURAL joins are rebuilt as they are",
   :dialect "postgres",
   :sql "SELECT * FROM a LEFT JOIN b USING (id) NATURAL FULL OUTER JOIN c",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "a"], :alias "a"},
    :base_sql "SELECT COUNT(*) AS n FROM a",
    :steps
    [{:source "table",
      :table [nil nil "b"],
      :alias "b",
      :strategy "left",
      :sql
      "SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM a LEFT JOIN b USING (id)) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM a JOIN b USING (id)) AS m"}
     {:source "table",
      :table [nil nil "c"],
      :alias "c",
      :strategy "full",
      :sql
      "SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM a LEFT JOIN b USING (id) NATURAL FULL OUTER JOIN c) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM a LEFT JOIN b USING (id) NATURAL JOIN c) AS m"}]}}
  {:name "quoted mixed-case names keep their quotes",
   :dialect "postgres",
   :sql "SELECT * FROM \"Orders\" \"O\" RIGHT JOIN \"People\" ON \"People\".id = \"O\".user_id",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "Orders"], :alias "O"},
    :base_sql "SELECT COUNT(*) AS n FROM \"Orders\" AS \"O\"",
    :steps
    [{:source "table",
      :table [nil nil "People"],
      :alias "People",
      :strategy "right",
      :sql
      "SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM \"Orders\" AS \"O\" RIGHT JOIN \"People\" ON \"People\".id = \"O\".user_id) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM \"Orders\" AS \"O\" JOIN \"People\" ON \"People\".id = \"O\".user_id) AS m"}]}}
  {:name "a CROSS JOIN is a step with one count",
   :dialect "postgres",
   :sql "SELECT * FROM a CROSS JOIN b",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "a"], :alias "a"},
    :base_sql "SELECT COUNT(*) AS n FROM a",
    :steps
    [{:source "table",
      :table [nil nil "b"],
      :alias "b",
      :strategy "cross",
      :sql "SELECT COUNT(*) AS n FROM a CROSS JOIN b"}]}}
  {:name "T-SQL keeps its WITH clause before the outer SELECT",
   :dialect "tsql",
   :sql "WITH c AS (SELECT 1 AS x) SELECT * FROM dbo.a LEFT JOIN c ON a.id = c.x",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil "dbo" "a"], :alias "a"},
    :base_sql "WITH c AS (SELECT 1 AS x) SELECT COUNT(*) AS n FROM dbo.a",
    :steps
    [{:source "cte",
      :table nil,
      :alias "c",
      :strategy "left",
      :sql
      "WITH c AS (SELECT 1 AS x) SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM dbo.a LEFT JOIN c ON a.id = c.x) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM dbo.a JOIN c ON a.id = c.x) AS m"}]}}
  {:name "a query with no joins has only the base count",
   :dialect "postgres",
   :sql "SELECT id FROM orders WHERE total > 1",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "orders"], :alias "orders"},
    :base_sql "SELECT COUNT(*) AS n FROM orders",
    :steps []}}
  {:name "the default dialect, for H2",
   :dialect nil,
   :sql "SELECT * FROM PUBLIC.ORDERS o LEFT JOIN PUBLIC.PEOPLE p ON p.ID = o.USER_ID",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil "PUBLIC" "ORDERS"], :alias "o"},
    :base_sql "SELECT COUNT(*) AS n FROM PUBLIC.ORDERS AS o",
    :steps
    [{:source "table",
      :table [nil "PUBLIC" "PEOPLE"],
      :alias "p",
      :strategy "left",
      :sql
      "SELECT w.n, m.n FROM (SELECT COUNT(*) AS n FROM PUBLIC.ORDERS AS o LEFT JOIN PUBLIC.PEOPLE AS p ON p.ID = o.USER_ID) AS w CROSS JOIN (SELECT COUNT(*) AS n FROM PUBLIC.ORDERS AS o JOIN PUBLIC.PEOPLE AS p ON p.ID = o.USER_ID) AS m"}]}}
  {:name "a bracketed SELECT is read as the SELECT inside",
   :dialect "postgres",
   :sql "(SELECT * FROM a JOIN b ON a.id = b.id)",
   :expected
   {:status "ok",
    :from {:source "table", :table [nil nil "a"], :alias "a"},
    :base_sql "SELECT COUNT(*) AS n FROM a",
    :steps
    [{:source "table",
      :table [nil nil "b"],
      :alias "b",
      :strategy "inner",
      :sql "SELECT COUNT(*) AS n FROM a JOIN b ON a.id = b.id"}]}}
  {:name "a data-modifying CTE is refused: every count query would run it",
   :dialect "postgres",
   :sql "WITH gone AS (DELETE FROM t RETURNING *) SELECT * FROM a JOIN b ON a.id = b.id",
   :expected {:status "unsupported", :reason "not-read-only"}}
  {:name "a locking SELECT is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a JOIN b ON a.id = b.id FOR UPDATE",
   :expected {:status "unsupported", :reason "not-read-only"}}
  {:name "a comma join is refused: its condition is in the WHERE clause",
   :dialect "postgres",
   :sql "SELECT * FROM a, b WHERE a.id = b.id",
   :expected {:status "unsupported", :reason "comma-join"}}
  {:name "a comma join after a JOIN is refused too",
   :dialect "postgres",
   :sql "SELECT * FROM a JOIN b ON a.id = b.id, c",
   :expected {:status "unsupported", :reason "comma-join"}}
  {:name "a set operation is refused",
   :dialect "postgres",
   :sql "SELECT id FROM a UNION SELECT id FROM b",
   :expected {:status "unsupported", :reason "set-operation"}}
  {:name "a statement that is not a SELECT is refused",
   :dialect "postgres",
   :sql "INSERT INTO a SELECT * FROM b",
   :expected {:status "unsupported", :reason "not-a-select"}}
  {:name "more than one statement is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a; SELECT * FROM b",
   :expected {:status "unsupported", :reason "multiple-statements"}}
  {:name "a SELECT without FROM is refused",
   :dialect "postgres",
   :sql "SELECT 1",
   :expected {:status "unsupported", :reason "no-from"}}
  {:name "a semi join is refused",
   :dialect "spark",
   :sql "SELECT * FROM a LEFT SEMI JOIN b ON a.x = b.x",
   :expected {:status "unsupported", :reason "unsupported-join"}}
  {:name "a LATERAL source is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a LEFT JOIN LATERAL (SELECT 1 AS y) t ON true",
   :expected {:status "unsupported", :reason "unsupported-source"}}
  {:name "an APPLY source is refused",
   :dialect "tsql",
   :sql "SELECT * FROM a CROSS APPLY f(a.x) t",
   :expected {:status "unsupported", :reason "unsupported-source"}}
  {:name "a table function source is refused",
   :dialect "postgres",
   :sql "SELECT * FROM generate_series(1, 3) g",
   :expected {:status "unsupported", :reason "unsupported-source"}}
  {:name "a sampled table is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a TABLESAMPLE BERNOULLI (10)",
   :expected {:status "unsupported", :reason "unsupported-source"}}
  {:name "a Hive LATERAL VIEW is refused",
   :dialect "spark",
   :sql "SELECT * FROM a LATERAL VIEW EXPLODE(a.xs) t AS x",
   :expected {:status "unsupported", :reason "unsupported-join"}}
  {:name "an ASOF join is refused",
   :dialect "duckdb",
   :sql "SELECT * FROM a ASOF JOIN b ON a.id = b.id AND a.t >= b.t",
   :expected {:status "unsupported", :reason "unsupported-join"}}
  {:name "a join with an argument a step cannot carry, Snowflake's MATCH_CONDITION, is refused",
   :dialect "snowflake",
   :sql "SELECT * FROM a ASOF JOIN b MATCH_CONDITION (a.t >= b.t) ON a.id = b.id",
   :expected {:status "unsupported", :reason "unsupported-join"}}
  {:name "a pivoted derived table is refused",
   :dialect "postgres",
   :sql "SELECT * FROM (SELECT 1 AS x) d PIVOT (SUM(x) FOR y IN (1))",
   :expected {:status "unsupported", :reason "unsupported-source"}}
  {:name "a parenthesized join tree is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a JOIN (b JOIN c ON b.x = c.x) ON a.x = b.x",
   :expected {:status "unsupported", :reason "nested-join"}}
  {:name "a placeholder is refused",
   :dialect "postgres",
   :sql "SELECT * FROM a JOIN b ON a.x = b.x WHERE a.y = ?",
   :expected {:status "unsupported", :reason "parameters"}}
  {:name "unparseable SQL is refused",
   :dialect "postgres",
   :sql "SELECT * FROM (a",
   :expected {:status "unsupported", :reason "unparseable"}}
  {:name "empty SQL is refused",
   :dialect "postgres",
   :sql "",
   :expected {:status "unsupported", :reason "not-a-select"}}
  {:name "brackets with an outer WITH are refused, since the steps would lose the CTE",
   :dialect "postgres",
   :sql "WITH c AS (SELECT 1 AS id) (SELECT * FROM a JOIN c ON a.id = c.id) ORDER BY 1",
   :expected {:status "unsupported", :reason "not-a-select"}}
  {:name "brackets with a trailing clause of their own are refused",
   :dialect "postgres",
   :sql "(SELECT * FROM a JOIN b ON a.id = b.id) LIMIT 5",
   :expected {:status "unsupported", :reason "not-a-select"}}]}
