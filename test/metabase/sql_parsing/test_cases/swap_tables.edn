{:cases
 [{:name         "a reference without an alias takes its own name as alias"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT id FROM orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id FROM mb_tmp AS orders"}

  {:name         "a reference with an alias keeps it, written with AS or without"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT o.id, p.id FROM orders o JOIN orders AS p ON o.id = p.parent_id WHERE o.total > 0"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT o.id, p.id FROM mb_tmp o JOIN mb_tmp AS p ON o.id = p.parent_id WHERE o.total > 0"}

  {:name         "a column qualifier that names the table stays as written, a wildcard too"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT orders.id, orders.* FROM orders WHERE orders.total > 0"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT orders.id, orders.* FROM mb_tmp AS orders WHERE orders.total > 0"}

  {:name         "a dot before a table name, which MariaDB reads as the current database, stays as written"
   :dialects     ["mysql"]
   :sql          "SELECT id FROM .orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id FROM .mb_tmp AS orders"}

  {:name         "the whole schema-qualified name is replaced"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT id FROM public.orders"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id FROM mb_tmp AS orders"}

  {:name         "a column qualifier with the schema loses the schema"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT public.orders.id, orders.total FROM public.orders WHERE public.orders.total > 0"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT orders.id, orders.total FROM mb_tmp AS orders WHERE orders.total > 0"}

  {:name         "whitespace around the dot of a qualified name goes with the name"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT id FROM public . orders o"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id FROM mb_tmp o"}

  {:name         "a double-quoted reference: the replacement is quoted, and the alias is the name as written"
   :dialects     ["postgres" "redshift" "clickhouse"]
   :sql          "SELECT \"Orders\".\"Id\" FROM \"public\".\"Orders\""
   :replacements {:tables [[{:schema "public" :table "Orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT \"Orders\".\"Id\" FROM \"mb_tmp\" AS \"Orders\""}

  {:name         "a backtick-quoted reference"
   :dialect      "mysql"
   :sql          "SELECT `Orders`.`Id` FROM `public`.`Orders`"
   :replacements {:tables [[{:schema "public" :table "Orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT `Orders`.`Id` FROM `mb_tmp` AS `Orders`"}

  {:name         "a bracket-quoted reference"
   :dialect      "tsql"
   :sql          "SELECT [Orders].[Id] FROM [public].[Orders]"
   :replacements {:tables [[{:schema "public" :table "Orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT [Orders].[Id] FROM [mb_tmp] AS [Orders]"}

  {:name         "a reference written in another case is replaced, and its alias keeps the case written"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "select  ID\nfrom\tORDERS\n  where Total>1"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "select  ID\nfrom\tmb_tmp AS ORDERS\n  where Total>1"}

  {:name         "a reference inside a subquery"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT * FROM (SELECT id FROM orders WHERE total > 0) AS s WHERE s.id IN (SELECT parent_id FROM orders o)"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT * FROM (SELECT id FROM mb_tmp AS orders WHERE total > 0) AS s WHERE s.id IN (SELECT parent_id FROM mb_tmp o)"}

  {:name         "a reference inside the body of a CTE"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "WITH recent AS (SELECT id FROM orders) SELECT * FROM recent"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "WITH recent AS (SELECT id FROM mb_tmp AS orders) SELECT * FROM recent"}

  {:name         "a CTE that shadows a table is not replaced where the reference names the CTE"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "WITH orders AS (SELECT 1 AS id) SELECT orders.id FROM orders JOIN people ON orders.id = people.id"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "people"} {:db nil :schema nil :table "mb_people"}]]}
   :expected     "WITH orders AS (SELECT 1 AS id) SELECT orders.id FROM orders JOIN mb_people AS people ON orders.id = people.id"}

  {:name         "the body of a CTE named after the table it reads is replaced, and the reference to the CTE is not"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "WITH orders AS (SELECT * FROM orders) SELECT * FROM orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "WITH orders AS (SELECT * FROM mb_tmp AS orders) SELECT * FROM orders"}

  {:name         "a table name inside a string or a comment does not change"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT 'orders' AS a, 'FROM orders' AS b /* FROM orders */ FROM orders -- orders\n WHERE c = 'public.orders'"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT 'orders' AS a, 'FROM orders' AS b /* FROM orders */ FROM mb_tmp AS orders -- orders\n WHERE c = 'public.orders'"}

  {:name         "placeholders stay where they are"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT id, ? AS p FROM orders WHERE a = ? AND b IN (?, ?) ORDER BY id LIMIT ?"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id, ? AS p FROM mb_tmp AS orders WHERE a = ? AND b IN (?, ?) ORDER BY id LIMIT ?"}

  {:name         "a placeholder with a cast, before and after the reference"
   :dialects     ["postgres" "redshift"]
   :sql          "SELECT ?::date AS d, id FROM orders WHERE x = ?::int AND public.orders.y = ?::text"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT ?::date AS d, id FROM mb_tmp AS orders WHERE x = ?::int AND orders.y = ?::text"}

  {:name         "forms a rebuild writes another way come back as written"
   :dialects     ["postgres" "mysql" "clickhouse" "tsql"]
   :sql          "SELECT LOG10(total) AS l, date_part('year', created_at) AS y FROM orders -- recent\n WHERE total > 0x1F"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT LOG10(total) AS l, date_part('year', created_at) AS y FROM mb_tmp AS orders -- recent\n WHERE total > 0x1F"}

  {:name         "a Postgres cast and a hexadecimal number come back as written"
   :dialect      "postgres"
   :sql          "SELECT now()::date AS d, 0x1F AS h FROM orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT now()::date AS d, 0x1F AS h FROM mb_tmp AS orders"}

  {:name         "MySQL DIV, LOG10 and ! come back as written"
   :dialect      "mysql"
   :sql          "SELECT total DIV 3 AS q, LOG10(total) AS l, !flag AS f FROM orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT total DIV 3 AS q, LOG10(total) AS l, !flag AS f FROM mb_tmp AS orders"}

  {:name         "a -- comment that opens the body of a CTE comes back as written"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "WITH c AS (\n  -- note\n  SELECT id FROM orders) SELECT * FROM c"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "WITH c AS (\n  -- note\n  SELECT id FROM mb_tmp AS orders) SELECT * FROM c"}

  {:name         "a character outside the Basic Multilingual Plane before the reference"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT '😀' AS e FROM orders WHERE public.orders.id = 1"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT '😀' AS e FROM mb_tmp AS orders WHERE orders.id = 1"}

  {:name         "a table that has no replacement stays"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT * FROM orders JOIN people p ON orders.id = p.id"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT * FROM mb_tmp AS orders JOIN people p ON orders.id = p.id"}

  {:name         "SQL that names no replaced table comes back as given"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT  1 AS a -- orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT  1 AS a -- orders"}

  {:name         "every statement is swapped, and the text between them stays"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT 1 FROM orders ;\nSELECT 2 FROM orders o"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT 1 FROM mb_tmp AS orders ;\nSELECT 2 FROM mb_tmp o"}

  {:name         "ClickHouse FINAL follows the alias"
   :dialect      "clickhouse"
   :sql          "SELECT orders.id FROM orders FINAL"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT orders.id FROM mb_tmp AS orders FINAL"}

  {:name         "the table a statement writes is replaced and takes no alias"
   :dialect      "postgres"
   :sql          "INSERT INTO orders (id) SELECT id FROM staging"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "staging"} {:db nil :schema nil :table "mb_staging"}]]}
   :expected     "INSERT INTO mb_tmp (id) SELECT id FROM mb_staging AS staging"}

  {:name         "the target of an UPDATE"
   :dialect      "postgres"
   :sql          "UPDATE orders SET total = 0 WHERE id = 1"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "UPDATE mb_tmp SET total = 0 WHERE id = 1"}

  {:name         "the target of a DELETE"
   :dialect      "postgres"
   :sql          "DELETE FROM orders WHERE id = 1"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "DELETE FROM mb_tmp WHERE id = 1"}

  {:name         "a comment between the parts of a name is refused"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT * FROM public /* c */ . orders"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :refused      {:reason "reference-not-located" :detail "public.orders"}}

  {:name         "a T-SQL temp table is refused"
   :dialect      "tsql"
   :sql          "SELECT * FROM #orders"
   :replacements {:tables [[{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :refused      {:reason "reference-not-located" :detail "#orders"}}

  {:name         "two references without an alias, to tables of one name in two schemas, are refused"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT a.orders.id FROM a.orders JOIN b.orders ON a.orders.id = b.orders.id"
   :replacements {:tables [[{:schema "a" :table "orders"} {:db nil :schema nil :table "mb_a"}]
                           [{:schema "b" :table "orders"} {:db nil :schema nil :table "mb_b"}]]}
   :refused      {:reason "ambiguous-table-name" :detail "orders"}}

  {:name         "references to one table with and without its schema"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT id FROM orders UNION ALL SELECT id FROM public.orders WHERE public.orders.id > 0"
   :replacements {:tables [[{:schema "public" :table "orders"} {:db nil :schema nil :table "mb_tmp"}]
                           [{:table "orders"} {:db nil :schema nil :table "mb_tmp"}]]}
   :expected     "SELECT id FROM mb_tmp AS orders UNION ALL SELECT id FROM mb_tmp AS orders WHERE orders.id > 0"}

  {:name         "tables of one name in two schemas, each with an alias"
   :dialects     ["postgres" "mysql" "redshift" "clickhouse" "tsql"]
   :sql          "SELECT x.id FROM a.orders x JOIN b.orders y ON x.id = y.id"
   :replacements {:tables [[{:schema "a" :table "orders"} {:db nil :schema nil :table "mb_a"}]
                           [{:schema "b" :table "orders"} {:db nil :schema nil :table "mb_b"}]]}
   :expected     "SELECT x.id FROM mb_a x JOIN mb_b y ON x.id = y.id"}]}
